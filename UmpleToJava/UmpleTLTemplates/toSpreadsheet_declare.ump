  /**
   * Exports this object and all reachable associated objects
   * into an Excel workbook.
   */
  public void toSpreadsheet(String fileName)
      throws java.io.IOException {

    java.util.Map<String, java.util.List<java.util.List<String>>> sheets =
        new java.util.LinkedHashMap<>();

    java.util.Map<Object, String> objectIds =
        new java.util.IdentityHashMap<>();

    java.util.Set<Object> visited =
        java.util.Collections.newSetFromMap(
            new java.util.IdentityHashMap<Object, Boolean>());

    collectSpreadsheetRows(sheets, objectIds, visited);
    writeSpreadsheetWorkbook(fileName, sheets);
  }

  /**
   * Collects this object and its associated objects.
   */
  public void collectSpreadsheetRows(
      java.util.Map<String, java.util.List<java.util.List<String>>> sheets,
      java.util.Map<Object, String> objectIds,
      java.util.Set<Object> visited) {

    String objectId = objectIds.get(this);

    if (objectId == null) {
      objectId = "O" + (objectIds.size() + 1);
      objectIds.put(this, objectId);
    }

    if (!visited.add(this)) {
      return;
    }

    String className = this.getClass().getName();

    java.util.List<java.util.List<String>> classRows =
        sheets.get(className);

    if (classRows == null) {

      classRows = new java.util.ArrayList<>();
      sheets.put(className, classRows);

      java.util.List<String> headers =
          new java.util.ArrayList<>();

      headers.add("ObjectID");

