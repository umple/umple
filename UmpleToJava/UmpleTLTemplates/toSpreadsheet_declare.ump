            if (!"internal".equals(av.getModifier())
                && !"const".equals(av.getModifier())
                && attributeNames.add(av.getName())) {

              spreadsheetAttributes.add(0, av);
            }
          }
        }

        java.util.List<AssociationVariable> spreadsheetAssociations =
            new java.util.ArrayList<>();

        java.util.Set<String> associationNames =
            new java.util.HashSet<>();

        for (UmpleClass current = uClass;
             current != null;
             current = current.getExtendsClass()) {

          for (AssociationVariable av : current.getAssociationVariables()) {

            if (associationNames.add(av.getName())) {
              spreadsheetAssociations.add(0, av);
            }
          }
        }
      #>>

      <<# for (Attribute av : spreadsheetAttributes) { #>>
      headers.add("<<#realSb.append(av.getName());#>>");
      <<# } #>>

      classRows.add(headers);
    }

    java.util.List<String> row = new java.util.ArrayList<>();

    row.add(objectId);

    <<# for (Attribute av : spreadsheetAttributes) { #>>
    row.add(spreadsheetValue(
        this.<<=gen.translate("getMethod", av)>>()));
    <<# } #>>

    java.util.List<Object> relatedObjects =
        new java.util.ArrayList<>();

    <<#
      int spreadsheetAssociationIndex = 0;

      for (AssociationVariable av : spreadsheetAssociations) {

        String getter = av.isMany()
            ? gen.translate("getManyMethod", av)
            : gen.translate("getMethod", av);

        int index = spreadsheetAssociationIndex++;
    #>>

    Object association_<<#realSb.append(index);#>> =
        this.<<#realSb.append(getter);#>>();

    if (association_<<#realSb.append(index);#>> instanceof Iterable<?>) {

      for (Object related_<<#realSb.append(index);#>>
          : (Iterable<?>) association_<<#realSb.append(index);#>>) {

        if (related_<<#realSb.append(index);#>> != null) {

          String relatedId_<<#realSb.append(index);#>> =
              objectIds.get(related_<<#realSb.append(index);#>>);

          if (relatedId_<<#realSb.append(index);#>> == null) {

            relatedId_<<#realSb.append(index);#>> =
                "O" + (objectIds.size() + 1);

            objectIds.put(
                related_<<#realSb.append(index);#>>,
                relatedId_<<#realSb.append(index);#>>);
          }

          addSpreadsheetAssociationRow(
              sheets,
              "__association__" + className + "_<<#realSb.append(av.getName());#>>",
              objectId,
              relatedId_<<#realSb.append(index);#>>);

          relatedObjects.add(
              related_<<#realSb.append(index);#>>);
        }
      }

    } else if (association_<<#realSb.append(index);#>> != null) {

      Object related_<<#realSb.append(index);#>> =
          association_<<#realSb.append(index);#>>;

      String relatedId_<<#realSb.append(index);#>> =
          objectIds.get(related_<<#realSb.append(index);#>>);

      if (relatedId_<<#realSb.append(index);#>> == null) {

        relatedId_<<#realSb.append(index);#>> =
            "O" + (objectIds.size() + 1);

        objectIds.put(
            related_<<#realSb.append(index);#>>,
            relatedId_<<#realSb.append(index);#>>);
      }

      addSpreadsheetAssociationRow(
