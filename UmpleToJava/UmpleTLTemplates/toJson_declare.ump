      for(StateMachine region: smAndNested)
      {
        boolean enteredByDefault = region.getStartState() != null;
        for(State enclosing = region.getParentState(); enteredByDefault && enclosing != null; enclosing = enclosing.getStateMachine().getParentState())
        {
          enteredByDefault = enclosing.getStateMachine().getStartState() == enclosing;
        }
        stateMachinesFromJson.add(region);
        defaultStatesFromJson.add(enteredByDefault ? gen.translate("stateOne",region.getStartState()) : gen.translate("stateNull",region));
      }
    }
