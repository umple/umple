namespace cruise.umple.compiler;

// Association support for the Python templates: immutable ends, sorting, one-to-one pairs, links and factories
class PythonNextGenerator
{
  //------------------------
  // Ends at most one on both sides, directed ends and immutable ends
  //------------------------

  // Java makes the setters of an immutable end private, since only the constructor calls them.
  // Python marks them private with a leading underscore, so an immutable class has no public
  // mutator.
  public String immutableEndSetterName(AssociationVariable av, String nameKey)
  {
    return (av.isImmutable() ? "_" : "") + translate(nameKey, av);
  }

  // Java injects into set and setMany of an immutable end a guard that also closes it, so the end
  // is set once (by the constructor). A key member's guard (association_KeyGuard) checks the same
  // flag, so it is not repeated here. Lines of the method body, or "".
  public String immutableEndGuard(UmpleClass uClass, AssociationVariable av)
  {
    if (!av.isImmutable())
    {
      return "";
    }
    String canSet = canSetField(uClass, av);
    String check = uClass.getKey().isMember(av) ? "" : "\n        if not " + canSet + ":\n            return False";
    return check + "\n        " + canSet + " = False";
  }

  // A sorted end is put back in the order of its priority attribute after its objects change and
  // after the user's after injection, as Java's injected Collections.sort does after an add (both
  // sorts are stable; Java leaves a batch set unsorted). A line of the method body, or "" for an end
  // that is not sorted.
  public String sortAfterChange(AssociationVariable av)
  {
    if (!av.isSorted())
    {
      return "";
    }
    Attribute priority = getModel().getUmpleClass(av.getType()).getAttribute(av.getPriority());
    return "\n        " + field(av) + ".sort(key=lambda x: x." + translate("getMethod", priority) + "())";
  }

  // The instance method holding the body of alternateConstructor of a class in a mandatory one-to-one
  // pair: it initializes an object from an existing partner. Its name avoids every modelled member,
  // and it is always called through its class, so no user method can hide it.
  public String oneOneAlternateInit(UmpleClass uClass)
  {
    return freshMemberName(uClass, "_alternateInit");
  }

  // How a constructor initializes the parent part of its object. A parent in a mandatory one-to-one
  // pair has a constructor that creates its partner, so the parent part, which takes the parent's
  // usual parameters (an existing partner), is initialized in place by the body of its
  // alternateConstructor, as Java's child constructor calls the parent's usual constructor. super()
  // starts after the class being initialized, so no subclass method can hide the parent's helper.
  public String oneOneParentInit(UmpleClass parent)
  {
    GeneratedClass parentClass = parent.getGeneratedClass();
    String method = parentClass.getLookup(MANDATORY_CONSTRUCTOR_PARAMETERS) == null ? "__init__" : oneOneAlternateInit(parent);
    return "super()." + method + "(" + parentClass.getLookup(CONSTRUCTOR_PARAMETERS) + ")";
  }

  // The partner's constructor calls alternateConstructor, so a user method with that name in a class
  // of a mandatory one-to-one pair (or in its ancestors) would replace it or be replaced by it
  // without notice: error 9215. Inner classes are generated in their outer class's module and
  // checked with it. False when one is found.
  public boolean oneOneCheckNames(UmpleClass uClass)
  {
    boolean ok = true;
    if (uClass.getGeneratedClass() != null && uClass.getGeneratedClass().getLookup(MANDATORY_CONSTRUCTOR_PARAMETERS) != null)
    {
      for (UmpleClass c = uClass; c != null; c = c.getExtendsClass())
      {
        for (Method m : c.getMethods())
        {
          if ("alternateConstructor".equals(m.getName()) && m.getSource() != Method.Source.fAutoAPI
              && (pythonLanguage(m) != null || m.getIsAbstract()))
          {
            errorAt(9215, m.getPosition(), "Method alternateConstructor of " + c.getName());
            ok = false;
          }
        }
      }
    }
    for (UmpleClass inner : uClass.getInnerClasses())
    {
      ok = oneOneCheckNames(inner) && ok;
    }
    return ok;
  }

  //------------------------
  // Ends at most one on one side and many on the other
  //------------------------

  // The same member of another object: self._x becomes object._x. Java reaches the ends it writes
  // on other objects through reflection (association_GetPrivate); Python needs no helper method.
  public static String onObject(String object, String selfMember)
  {
    return object + selfMember.substring("self".length());
  }

  // Removes object from a list of links as Java's List.remove(Object) does, but by identity: the
  // first occurrence goes, and an absent object changes nothing (a -1 index would delete the last).
  public String removeLink(String list, String object, String indent)
  {
    return "\n" + indent + "index = " + identityIndex(list, object)
      + "\n" + indent + "if index >= 0:"
      + "\n" + indent + "    del " + list + "[index]";
  }

  // The parameters (", aX, aY" or "") and the call arguments of the factory that creates a new
  // object at the many end av: the constructor of av's class, where the end back to this class is
  // self (Java's methodArgumentsExcept and callerArgumentsExcept).
  public String factoryParameters(AssociationVariable av)
  {
    String parameters = StringFormatter.replaceParameter(constructorParametersOf(av), parameterName(av.getRelatedAssociation(), false), null);
    return parameters.isEmpty() ? "" : ", " + parameters;
  }

  public String factoryArguments(AssociationVariable av)
  {
    return StringFormatter.replaceParameter(constructorParametersOf(av), parameterName(av.getRelatedAssociation(), false), "self");
  }

  private String constructorParametersOf(AssociationVariable av)
  {
    return getModel().getUmpleClass(av.getType()).getGeneratedClass().getLookup(CONSTRUCTOR_PARAMETERS);
  }

  // The two add methods of a many end with a factory, in Java's order: the factory, then the add
  // taking the object.
  public List<String> addImplementationNames(UmpleClass uClass, AssociationVariable av)
  {
    return overloadNames(uClass, translate("addMethod", av), 2, "factory");
  }

  // Their parameters for the dispatcher: the factory's typed after the attribute or association end
  // each constructor parameter comes from, then the object.
  public List<List<MethodParameter>> addImplementationParameters(AssociationVariable av)
  {
    UmpleClass created = getModel().getUmpleClass(av.getType());
    String backEnd = parameterName(av.getRelatedAssociation(), false);
    List<MethodParameter> factory = new ArrayList<MethodParameter>();
    for (String name : splitParameters(constructorParametersOf(av)))
    {
      if (!name.equals(backEnd))
      {
        factory.add(constructorParameter(created, name));
      }
    }
    return Arrays.asList(factory, Arrays.asList(parameter(translate("parameterOne", av), av.getType())));
  }

  private MethodParameter constructorParameter(UmpleClass created, String name)
  {
    boolean varargs = name.startsWith("*");
    String plain = varargs ? name.substring(1) : name;
    for (UmpleClass c = created; c != null; c = c.getExtendsClass())
    {
      for (Attribute a : attributes(c))
      {
        if (plain.equals(parameterName(a, false)))
        {
          return parameter(plain, a.getType());
        }
      }
      for (AssociationVariable v : c.getAssociationVariables())
      {
        if (v.isMany() && plain.equals(parameterName(v, true)))
        {
          MethodParameter p = parameter(plain, v.getType() + (varargs ? "..." : ""));
          p.setIsList(!varargs);
          return p;
        }
        if (!v.isMany() && plain.equals(parameterName(v, false)))
        {
          return parameter(plain, v.getType());
        }
      }
    }
    return parameter(plain, "");
  }
}
