namespace cruise.umple.compiler;

// State machine preparation and support for the Python templates
class PythonNextGenerator
{
  depend java.util.function.Function;
  depend java.text.Normalizer;

  //------------------------
  // Diagnostics
  //------------------------

  // Queued and pooled machines are not supported (9210). Events, state-dependent methods and states
  // become methods and enum members, so their names must not be Python keywords, and parameters are
  // checked as for other methods. Nested classes, generated inside this one, are checked too.
  public boolean checkStateMachines(UmpleClass uClass)
  {
    String feature = unsupportedStateMachine(uClass);
    if (feature != null)
    {
      error(9210, uClass, feature, uClass.getName());
      return false;
    }
    return checkStateMachineNames(uClass);
  }

  private boolean checkStateMachineNames(UmpleClass uClass)
  {
    boolean ok = true;
    Position position = uClass.numberOfPositions() > 0 ? uClass.getPosition(0) : new Position("", 0, 0, 0);
    for (Event e : uClass.getEvents())
    {
      if (PYTHON_KEYWORDS.contains(e.getName()))
      {
        error(9215, uClass, "Event " + e.getName());
        ok = false;
      }
      ok = checkParameters(e.getParams(), "Event " + e.getName(), position) && ok;
    }
    for (Method m : uClass.getStateDependentMethods())
    {
      if (PYTHON_KEYWORDS.contains(m.getName()))
      {
        error(9215, uClass, "Method " + m.getName());
        ok = false;
      }
      ok = checkParameters(m.getMethodParameters(), "Method " + m.getName(), m.getPosition() != null ? m.getPosition() : position) && ok;
    }
    for (StateMachine sm : uClass.getAllStateMachines())
    {
      for (State s : sm.getStates())
      {
        if (PYTHON_KEYWORDS.contains(s.getName()))
        {
          error(9215, uClass, "State " + s.getName());
          ok = false;
        }
      }
    }
    for (UmpleClass inner : uClass.getInnerClasses())
    {
      ok = checkStateMachineNames(inner) && ok;
    }
    return ok;
  }

  private static String unsupportedStateMachine(UmpleClass uClass)
  {
    for (StateMachine sm : uClass.getStateMachines())
    {
      if (sm.isQueued())
      {
        return "Queued state machines";
      }
      if (sm.isPooled())
      {
        return "Pooled state machines";
      }
    }
    for (UmpleClass inner : uClass.getInnerClasses())
    {
      String feature = unsupportedStateMachine(inner);
      if (feature != null)
      {
        return feature;
      }
    }
    return null;
  }

  //------------------------
  // Preparation
  //------------------------

  // Undoes the model changes of prepareStateMachines that postpare does not remove, latest first.
  private List<Runnable> stateMachineRestores = new ArrayList<Runnable>();

  // Adds, in Python, the actions Java's preparation adds for final states, nested and concurrent
  // machines, automatic transitions, do activities and timers. They use the Python slot, so the
  // snippet translator skips them, and are internal, so postpare removes them and other generators
  // never see them.
  public void prepareStateMachines(UmpleClass uClass)
  {
    Set<Action> existing = Collections.newSetFromMap(new IdentityHashMap<Action, Boolean>());
    for (StateMachine sm : uClass.getAllStateMachines())
    {
      for (State s : sm.getStates())
      {
        existing.addAll(s.getActions());
      }
    }
    for (StateMachine sm : uClass.getStateMachines())
    {
      // As in Java, so internal names, which untagged snippets use, match the Java output
      String name = sm.getName();
      if (Character.isUpperCase(name.charAt(0)) && sm.setName(Character.toLowerCase(name.charAt(0)) + name.substring(1)))
      {
        stateMachineRestores.add(0, () -> sm.setName(name));
      }
      prepareNestedStatesFor(uClass, sm, 0);
      prepareTimedEvents(sm);
    }
    for (StateMachine sm : uClass.getAllStateMachines())
    {
      for (State s : sm.getStates())
      {
        for (Action a : s.getActions())
        {
          if (!existing.contains(a))
          {
            a.setCodeblock(new CodeBlock("Python", a.getCodeblock().getCode("")));
            a.setIsInternal(true);
          }
        }
      }
    }
    removeStubsImplementedByMachines(uClass);
  }

  // Restores what prepareStateMachines changed in the model beyond internal actions and states, so
  // that generators run after this one see the model as parsed.
  public void postpareStateMachines()
  {
    for (Runnable restore : stateMachineRestores)
    {
      restore.run();
    }
    stateMachineRestores.clear();
  }

  private void prepareNestedStatesFor(UmpleClass uClass, StateMachine sm, int concurrentIndex)
  {
    prepareFinalStatesFor(sm);
    prepareDoActivities(uClass, sm);
    if (sm.getParentState() != null && sm.getStartState() != null)
    {
      String type = smType(sm);
      Map<String,String> lookups = new HashMap<String,String>();
      lookups.put("parentExitActionCode", "self." + translate("exitMethod", sm) + "()");
      lookups.put("setSmToNullExitActionCode", "self." + translate("setMethod", sm) + "(" + type + ".Null)");
      // prepareNestedStateMachine derives the deep history action from this text: its last dot must
      // precede the start state's name
      lookups.put("parentEntryActionCode", "if " + smField(sm) + " is " + type + ".Null:\n    self." + translate("setMethod", sm)
        + "(" + type + "." + translate("stateOne", sm.getStartState()) + ")");
      GeneratorHelper.prepareNestedStateMachine(sm, concurrentIndex, lookups);
    }
    for (State s : sm.getStates())
    {
      int nestedSmIndex = 0;
      for (StateMachine nestedSm : s.getNestedStateMachines())
      {
        prepareNestedStatesFor(uClass, nestedSm, nestedSmIndex);
        nestedSmIndex += 1;
      }
    }
    Map<String,String> lookups = new HashMap<String,String>();
    lookups.put("callEvent", "self.{0}()");
    GeneratorHelper.prepareAutoTransitions(sm, this, lookups);
  }

  private void prepareFinalStatesFor(StateMachine sm)
  {
    State concurrentRegion = sm.getParentState() == null ? null : sm.getParentState().getConcurrentRegion();
    String deleteCode = concurrentRegion == null ? "self.delete()" : concurrentFinalStateCode(concurrentRegion, sm);
    if (deleteCode == null)
    {
      // Another region can never be final, so these final states never delete the object
      return;
    }
    Map<String,String> lookups = new HashMap<String,String>();
    lookups.put("deleteActionCode", deleteCode);
    GeneratorHelper.prepareFinalState(sm, lookups);
  }

  // A final state in a concurrent region deletes the object only when every region is final, as in
  // Java's prepareConcurrentFinalStatesFor; null when a region can never be final (Java deletes then).
  private String concurrentFinalStateCode(State concurrentRegion, StateMachine currentSm)
  {
    List<String> conditions = new ArrayList<String>();
    for (StateMachine region : concurrentRegion.getNestedStateMachines())
    {
      List<String> regionConditions = finalConditions(region, currentSm);
      if (regionConditions == null)
      {
        return null;
      }
      conditions.addAll(regionConditions);
    }
    return conditions.isEmpty() ? "self.delete()" : "if " + String.join(" and ", conditions) + ":\n    self.delete()";
  }

  // The conditions under which machine is final: in any of its final states (Java checks only the
  // first) or in a state whose nested machines are all final. currentSm, whose final state is being
  // entered, counts as final. Empty means always final; null means never.
  private List<String> finalConditions(StateMachine machine, StateMachine currentSm)
  {
    if (machine == currentSm)
    {
      return new ArrayList<String>();
    }
    List<List<String>> alternatives = new ArrayList<List<String>>();
    for (State s : machine.getStates())
    {
      List<String> conditions = new ArrayList<String>();
      if (s.isFinalState())
      {
        conditions.add(smField(machine) + " is " + stateReference(s));
      }
      else if (s.numberOfNestedStateMachines() > 0)
      {
        // A nested machine is Null while its state is inactive, so its conditions imply the state
        for (StateMachine nested : s.getNestedStateMachines())
        {
          List<String> nestedConditions = finalConditions(nested, currentSm);
          if (nestedConditions == null)
          {
            conditions = null;
            break;
          }
          conditions.addAll(nestedConditions);
        }
        if (conditions != null && conditions.isEmpty())
        {
          return conditions;
        }
      }
      if (conditions != null && !conditions.isEmpty())
      {
        alternatives.add(conditions);
      }
    }
    if (alternatives.size() <= 1)
    {
      return alternatives.isEmpty() ? null : alternatives.get(0);
    }
    List<String> either = new ArrayList<String>();
    for (List<String> conditions : alternatives)
    {
      either.add(conditions.size() == 1 ? conditions.get(0) : "(" + String.join(" and ", conditions) + ")");
    }
    return new ArrayList<String>(Arrays.asList("(" + String.join(" or ", either) + ")"));
  }

  // Exit cancels each activity of the state. Entry creates and publishes all the visit's workers,
  // then starts them with the one that takes the completion transition last.
  private void prepareDoActivities(UmpleClass uClass, StateMachine sm)
  {
    for (State state : sm.getStates())
    {
      if (state.numberOfActivities() == 0)
      {
        continue;
      }
      StringBuilder entry = new StringBuilder();
      List<String> workers = new ArrayList<String>();
      String completer = null;
      for (Activity activity : state.getActivities())
      {
        String worker = "self." + activityWorker(uClass, activity);
        Action exitAction = new Action("if " + worker + " is not None:\n    " + worker + ".cancelled.set()");
        exitAction.setActionType("exit");
        state.addAction(exitAction);
        entry.append(worker + " = " + DECLARING_CLASS + "." + activityThreadClass(uClass) + "(self, " + pythonString(translate("doActivityMethod", activity)) + ")\n");
        if (activity.getOnCompletionEvent() != null && completer == null)
        {
          completer = worker;
        }
        else
        {
          workers.add(worker);
        }
      }
      if (completer != null)
      {
        workers.add(completer);
      }
      entry.append(DECLARING_CLASS + "." + activityThreadClass(uClass) + ".startAll(" + String.join(", ", workers) + ")");
      Action entryAction = new Action(entry.toString());
      entryAction.setActionType("entry");
      state.addAction(entryAction);
    }
  }

  // Timed transitions start their timer on entry to the source state and stop it on exit.
  private void prepareTimedEvents(StateMachine sm)
  {
    List<StateMachine> machines = new ArrayList<StateMachine>();
    machines.add(sm);
    machines.addAll(sm.getNestedStateMachines());
    for (StateMachine machine : machines)
    {
      for (State s : machine.getStates())
      {
        for (Transition t : s.getTransitions())
        {
          Event e = t.getEvent();
          if (e == null || !e.getIsTimer())
          {
            continue;
          }
          Action entryAction = new Action("self." + translate("eventStartMethod", e, machine) + "()");
          entryAction.setActionType("entry");
          Action exitAction = new Action("self." + translate("eventStopMethod", e, machine) + "()");
          exitAction.setActionType("exit");
          t.getFromState().addAction(entryAction);
          t.getFromState().addAction(exitAction);
        }
      }
    }
  }

  // An event or state-dependent method that implements an interface method replaces the stub the
  // class would otherwise get.
  private void removeStubsImplementedByMachines(UmpleClass uClass)
  {
    List<Method> implementations = new ArrayList<Method>(uClass.getStateDependentMethods());
    for (Event e : uClass.getEvents())
    {
      Method eventMethod = new Method("", e.getName(), e.getType().toLowerCase(), false);
      eventMethod.setMethodParameters(e.getParams());
      implementations.add(eventMethod);
    }
    for (UmpleInterface anInterface : uClass.getParentInterface())
    {
      for (Method stub : anInterface.getMethods())
      {
        for (Method implementation : implementations)
        {
          // the parser adds the interface's own method object to the class as the stub
          int index = uClass.getMethods().indexOf(stub);
          if (index >= 0 && uClass.getMethod(index) == stub && stub.compareWithTheMethod(implementation))
          {
            uClass.removeMethod(stub);
            stateMachineRestores.add(0, () -> uClass.addMethodAt(stub, index));
          }
        }
      }
    }
  }

  //------------------------
  // Names and references for the templates
  //------------------------

  public String translate(String keyName, Event event, StateMachine sm)
  {
    return javaNames().translate(keyName, event, sm);
  }

  public String smAttribute(StateMachine sm)
  {
    return "_" + translate("stateMachineOne", sm);
  }

  public String smField(StateMachine sm)
  {
    return "self." + smAttribute(sm);
  }

  // A machine's nested enum, reached through __class__ in the owning class's methods. Helper classes
  // nested in it use helperStateReference, because there __class__ is the helper.
  public String smType(StateMachine sm)
  {
    return DECLARING_CLASS + "." + translate("type", sm);
  }

  public String stateReference(State state)
  {
    return smType(state.getStateMachine()) + "." + translate("stateOne", state);
  }

  public String helperStateReference(UmpleClass uClass, State state)
  {
    return classReference(uClass) + "." + translate("type", state.getStateMachine()) + "." + translate("stateOne", state);
  }

  // Generator-owned names: fields for the deleted flag, timer handlers, activity workers
  // and history, and the helper classes. Every class with a state machine has the deleted flag: a
  // deleted object takes no events, and a generated method stops once code it ran deletes the object.
  public String deletedFlag(UmpleClass uClass)
  {
    return uClass.getAllStateMachines().isEmpty() ? null : fieldName(uClass, "deleted");
  }

  // The deleted flag where code the object runs can delete it while a generated method runs (an
  // authored guard call, action or injection, a final state) or timers and activities read it; null
  // otherwise. Generated methods check it after such code only then.
  public String deletingFlag(UmpleClass uClass)
  {
    for (Event event : uClass.getEvents())
    {
      if (hasModelInjection(uClass, translate("eventMethod", event), "before", "after"))
      {
        return fieldName(uClass, "deleted");
      }
    }
    for (StateMachine sm : uClass.getAllStateMachines())
    {
      if (hasModelInjection(uClass, translate("setMethod", sm), "before", "after")
        || hasModelInjection(uClass, translate("exitMethod", sm), "before", "after"))
      {
        return fieldName(uClass, "deleted");
      }
      for (State s : sm.getStates())
      {
        boolean deletes = s.numberOfActivities() > 0 || s.isFinalState();
        for (Action a : s.getActions())
        {
          deletes = deletes || !a.getIsInternal();
        }
        for (Transition t : s.getTransitions())
        {
          deletes = deletes || guardNeedsCheck(t, uClass) || t.getAction() != null || (t.getEvent() != null && t.getEvent().getIsTimer());
        }
        if (deletes)
        {
          return fieldName(uClass, "deleted");
        }
      }
    }
    return null;
  }

  // Only injections selected for Python can run model code in a generated method.
  private boolean hasModelInjection(UmpleClass uClass, String method, String... types)
  {
    for (String type : types)
    {
      for (CodeInjection injection : uClass.getApplicableCodeInjections(type, method))
      {
        String language = pythonLanguage(injection.getSnippet());
        if (!injection.getIsInternal() && !injection.hasCodeLabel() && language != null
          && !injection.getSnippet().getCode(language).trim().isEmpty())
        {
          return true;
        }
      }
    }
    return false;
  }

  // Ends a generated method, returning result, once code it ran has deleted the object; ""
  // when the class has no deleted flag.
  public static String deletedCheck(String deletedFlag, String indent, String result)
  {
    return deletedFlag == null ? "" : "\n" + indent + "if self." + deletedFlag + ":\n" + indent + "    return" + (result.isEmpty() ? "" : " " + result);
  }

  // Parent entry can delete even when the child has no machine or uses a different deleted flag.
  public String ancestorDeletedCheck(UmpleClass uClass)
  {
    StringBuilder code = new StringBuilder();
    Set<String> flags = new HashSet<String>();
    for (UmpleClass parent = uClass.getExtendsClass(); parent != null; parent = parent.getExtendsClass())
    {
      String flag = deletingFlag(parent);
      if (flag != null && flags.add(flag))
      {
        code.append(deletedCheck(flag, "        ", ""));
      }
    }
    return code.toString();
  }

  // A deleting injection may finish its own block, but must not start another block or continuation.
  public String stateMachineInjections(UmpleClass uClass, String type, String method, String check, MethodParameter... parameters)
  {
    StringBuilder code = new StringBuilder();
    for (CodeInjection injection : uClass.getApplicableCodeInjections(type, method))
    {
      String block = injectionCode(uClass, Arrays.asList(injection), type + " injection of " + method,
        Arrays.asList(parameters), false, "        ");
      if (!block.isEmpty())
      {
        code.append(block).append(check);
      }
    }
    return code.toString();
  }

  public static List<Action> actionsOf(State state, String actionType)
  {
    List<Action> actions = new ArrayList<Action>();
    for (Action action : state.getActions())
    {
      if (actionType.equals(action.getActionType()))
      {
        actions.add(action);
      }
    }
    return actions;
  }

  // Queries are effect-free only when their emitted bodies cannot run model code.
  public boolean guardNeedsCheck(Transition transition, UmpleClass uClass)
  {
    if (transition.getGuard() == null)
    {
      return false;
    }
    Map<String, MethodParameter> parameters = new HashMap<String, MethodParameter>();
    if (transition.getEvent() != null)
    {
      for (MethodParameter parameter : transition.getEvent().getParams())
      {
        parameters.put(parameter.getName(), parameter);
      }
    }
    return guardCallsMethod(transition.getGuard(), new PythonConstraintScope(uClass, parameters, "self", new ArrayList<Attribute>()));
  }

  private boolean guardCallsMethod(ConstraintVariable variable, PythonConstraintScope context)
  {
    if (variable instanceof ConstraintTree)
    {
      return guardCallsMethod(((ConstraintTree) variable).getRoot(), context);
    }
    if (variable instanceof ConstraintAttribute)
    {
      ConstraintAttribute read = (ConstraintAttribute) variable;
      Attribute attribute = read.getAttribute();
      if (attribute.isConstant() || "internal".equals(attribute.getModifier())
        || read.getIndex() == -1 && context.getParameters().containsKey(attribute.getName()))
      {
        return false;
      }
      return guardMethod(context.getUClass(), translate(attribute.getIsList() && read.getIndex() == -1 ? "getManyMethod" : "getMethod", attribute));
    }
    if (variable instanceof ConstraintAssociation)
    {
      ConstraintAssociation read = (ConstraintAssociation) variable;
      AssociationVariable association = read.getAssociation();
      String query = read.getNumberOf() ? "numberOfMethod"
        : read.getIndex() != -1 || association.isOne() ? "getMethod" : "getManyMethod";
      return guardMethod(context.getUClass(), translate(query, association));
    }
    if (variable instanceof ConstraintUnassignedName)
    {
      String name = ((ConstraintUnassignedName) variable).getValue();
      ConstraintVariable inherited = inheritedMember(context.getUClass(), name);
      return !context.getParameters().containsKey(name) && inherited != null && guardCallsMethod(inherited, context);
    }
    if (!(variable instanceof ConstraintOperator))
    {
      return false;
    }
    ConstraintOperator operator = (ConstraintOperator) variable;
    if (isCall(operator))
    {
      ConstraintVariable callee = unwrap(operator.getLeft());
      UmpleClassifier owner = context.getUClass();
      if (callee instanceof ConstraintOperator && ".".equals(((ConstraintOperator) callee).getValue()))
      {
        ConstraintVariable receiver = ((ConstraintOperator) callee).getLeft();
        String type = declaredType(receiver, context);
        if (type == null && receiver instanceof ConstraintUnassignedName)
        {
          type = ((ConstraintUnassignedName) receiver).getValue();
        }
        owner = type == null ? null : getModel().getUmpleClass(type);
        if (owner == null && type != null)
        {
          owner = getModel().getUmpleInterface(type);
        }
        callee = unwrap(((ConstraintOperator) callee).getRight());
      }
      if (callee instanceof ConstraintUnassignedName && guardMethod(owner, ((ConstraintUnassignedName) callee).getValue()))
      {
        return true;
      }
    }
    // this.x reads the member even where an event parameter has its name
    ConstraintVariable target = unwrap(operator.getLeft());
    if (".".equals(operator.getValue()) && target instanceof ConstraintUnassignedName
      && "this".equals(((ConstraintUnassignedName) target).getValue()))
    {
      return guardCallsMethod(operator.getRight(), new PythonConstraintScope(context.getUClass(),
        new HashMap<String, MethodParameter>(), context.getReceiver(), context.getAttributesAsParameters()));
    }
    return guardCallsMethod(operator.getLeft(), context) || guardCallsMethod(operator.getRight(), context);
  }

  private boolean guardMethod(UmpleClassifier owner, String name)
  {
    Map<String, Method> methods = new LinkedHashMap<String, Method>();
    collectConstraintMethods(owner, name, methods, new HashSet<UmpleClassifier>());
    for (Method method : methods.values())
    {
      if (method.getSource() != Method.Source.fAutoAPI)
      {
        return true;
      }
    }
    for (UmpleClass c = owner instanceof UmpleClass ? (UmpleClass) owner : null; c != null; c = c.getExtendsClass())
    {
      for (Event event : c.getEvents())
      {
        if (translate("eventMethod", event).equals(name))
        {
          return true;
        }
      }
      for (Method method : c.getStateDependentMethods())
      {
        if (method.getName().equals(name))
        {
          return true;
        }
      }
      // A generated method runs model code only through code injected into it, or as the getter (or
      // Boolean query) of a derived attribute. An association's validity query calls its count.
      if (hasModelInjection(c, name, "before", "after"))
      {
        return true;
      }
      for (AssociationVariable association : c.getAssociationVariables())
      {
        if (association.isMany() && translate("isNumberOfValidMethod", association).equals(name)
          && hasModelInjection(c, translate("numberOfMethod", association), "before", "after"))
        {
          return true;
        }
      }
      for (Attribute attribute : attributes(c))
      {
        if (attribute.getIsDerived() && (translate("getMethod", attribute).equals(name)
          || "Boolean".equals(attribute.getType()) && translate("isMethod", attribute).equals(name)))
        {
          return true;
        }
        // A computed default is evaluated by the default getter and by reset, which calls it
        if ("defaulted".equals(attribute.getModifier()) && literal(attribute.getType(), attribute.getValue()) == null
          && (translate("getDefaultMethod", attribute).equals(name) || translate("resetMethod", attribute).equals(name)))
        {
          return true;
        }
      }
    }
    return false;
  }

  // Authored guard calls, setters with work after authored code or parent entry, and timer delays need to
  // remember their visit. State equality cannot detect leaving and re-entering the same state.
  public String visitField(UmpleClass uClass, StateMachine sm)
  {
    boolean after = !uClass.getApplicableCodeInjections("after", translate("setMethod", sm)).isEmpty();
    int afterBlocks = 0;
    for (CodeInjection injection : uClass.getApplicableCodeInjections("after", translate("setMethod", sm)))
    {
      String language = pythonLanguage(injection.getSnippet());
      if (!injection.getIsInternal() && !injection.hasCodeLabel() && language != null
        && !injection.getSnippet().getCode(language).trim().isEmpty())
      {
        afterBlocks++;
      }
    }
    if (afterBlocks > 1)
    {
      return "self." + fieldName(uClass, translate("stateMachineOne", sm) + "Visit");
    }
    for (State state : sm.getStates())
    {
      for (Transition transition : state.getTransitions())
      {
        if (guardNeedsCheck(transition, uClass) || (transition.getEvent() != null && transition.getEvent().getIsTimer()))
        {
          return "self." + fieldName(uClass, translate("stateMachineOne", sm) + "Visit");
        }
      }
      List<Action> entries = actionsOf(state, "entry");
      if (entries.size() > 1 || endsWithDeepHistory(state)
        || (sm.getParentState() != null && (!entries.isEmpty() || after))
        || (after && !entries.isEmpty()))
      {
        return "self." + fieldName(uClass, translate("stateMachineOne", sm) + "Visit");
      }
    }
    return null;
  }

  // Deep history restores the saved state after entry; an obsolete entry must not overwrite it.
  public static boolean endsWithDeepHistory(State state)
  {
    return state.getIsDeepHistoryState() && state.getStateMachine().getParentState() != null;
  }

  // Entry bodies and setter injections share the captured visit's scope. Reserve their identifiers
  // so an authored local cannot overwrite it or be overwritten by it.
  public static String visitLocal(StateMachine sm, String... setterCode)
  {
    StringBuilder code = new StringBuilder(String.join("\n", setterCode));
    for (State state : sm.getStates())
    {
      for (Action action : actionsOf(state, "entry"))
      {
        String language = pythonLanguage(action.getCodeblock());
        if (language != null)
        {
          code.append("\n").append(action.getCodeblock().getCode(language));
        }
        if (action.getGuardCode() != null)
        {
          code.append("\n").append(action.getGuardCode());
        }
      }
    }
    return localName("visit", localNames(code.toString()));
  }

  // Python normalizes identifiers before binding them, so compatibility spellings also reserve locals.
  public static Set<String> localNames(String... code)
  {
    String normalized = Normalizer.normalize(String.join("\n", code), Normalizer.Form.NFKC);
    return new HashSet<String>(Arrays.asList(normalized.split("[^A-Za-z0-9_]+")));
  }

  public static String visitCheck(String deletedFlag, String visitField, String visit, String indent)
  {
    return visitCheck(deletedFlag, visitField, visit, indent, "");
  }

  public static String visitCheck(String deletedFlag, String visitField, String visit, String indent, String result)
  {
    if (visitField == null)
    {
      return deletedCheck(deletedFlag, indent, result);
    }
    return "\n" + indent + "if " + (deletedFlag == null ? "" : "self." + deletedFlag + " or ")
      + visitField + " != " + visit + ":\n" + indent + "    return" + (result.isEmpty() ? "" : " " + result);
  }

  public String timerHandler(UmpleClass uClass, Transition timed)
  {
    return fieldName(uClass, translate("eventHandler", timed.getEvent(), timed.getFromState().getStateMachine()));
  }

  public String activityWorker(UmpleClass uClass, Activity activity)
  {
    return fieldName(uClass, translate("doActivityThread", activity));
  }

  // Where a nested machine keeps its shallow ("H") or deep ("HStar") history.
  public String historyField(UmpleClass uClass, StateMachine sm, String kind)
  {
    return "self." + fieldName(uClass, translate("stateMachineOne", sm) + kind);
  }

  public String timerHandlerClass(UmpleClass uClass)
  {
    return freshMemberName(uClass, "TimedEventHandler");
  }

  public String activityThreadClass(UmpleClass uClass)
  {
    return freshMemberName(uClass, "DoActivityThread");
  }

  // A field belongs to the object, which the class shares with its ancestors and subclasses, so the
  // name must differ from their fields and their methods, underscore included.
  private String fieldName(UmpleClass uClass, String base)
  {
    Set<String> taken = new HashSet<String>();
    for (UmpleClass c : getModel().getUmpleClasses())
    {
      if (inherits(c, uClass) || inherits(uClass, c))
      {
        for (Method m : c.getMethods())
        {
          taken.add(m.getName());
        }
        for (Method m : c.getStateDependentMethods())
        {
          taken.add(m.getName());
        }
        for (Attribute a : c.getAttributes())
        {
          taken.add("_" + a.getName());
        }
        for (AssociationVariable av : c.getAssociationVariables())
        {
          taken.add("_" + av.getName());
        }
        for (StateMachine sm : c.getAllStateMachines())
        {
          taken.add(smAttribute(sm));
        }
      }
    }
    String name = "_" + base;
    for (int i = 2; taken.contains(name); i++)
    {
      name = "_" + base + i;
    }
    return name;
  }

  private static boolean inherits(UmpleClass c, UmpleClass ancestor)
  {
    for (UmpleClass k = c; k != null; k = k.getExtendsClass())
    {
      if (k == ancestor)
      {
        return true;
      }
    }
    return false;
  }

  public List<Transition> timedTransitions(UmpleClass uClass)
  {
    List<Transition> timed = new ArrayList<Transition>();
    for (StateMachine sm : uClass.getAllStateMachines())
    {
      for (State s : sm.getStates())
      {
        for (Transition t : s.getTransitions())
        {
          if (t.getEvent() != null && t.getEvent().getIsTimer())
          {
            timed.add(t);
          }
        }
      }
    }
    return timed;
  }

  public List<Activity> activities(UmpleClass uClass)
  {
    List<Activity> all = new ArrayList<Activity>();
    for (StateMachine sm : uClass.getAllStateMachines())
    {
      for (State s : sm.getStates())
      {
        all.addAll(s.getActivities());
      }
    }
    return all;
  }

  // A timer's delay in seconds: a number as written (fractions are kept), otherwise the
  // expression through the snippet translator, whose imports go to imports.
  public String timerDelay(UmpleClass uClass, Transition timed, List<String> imports)
  {
    return expression(uClass, null, timed.getEvent().getTimerInSeconds(), false, timed.getPosition(),
      "the delay of the timed transition from state " + timed.getFromState().getName(), imports);
  }

  // The attribute whose setter, generated here or in an ancestor, has event e's name, or null. Java
  // overloads the two; here they become numbered implementations behind one dispatcher. The test
  // mirrors the setters attribute_Set_All emits.
  public Attribute setterSharingName(UmpleClass uClass, Event e)
  {
    for (UmpleClass c = uClass; c != null; c = c.getExtendsClass())
    {
      for (Attribute av : attributes(c))
      {
        if (hasSetter(av) && !av.getIsList() && translate("setMethod", av).equals(translate("eventMethod", e)))
        {
          return av;
        }
      }
    }
    return null;
  }

  // The local names of a generated event method start with its parameters' names; localName gives a
  // new local a name none of them has, and adds it.
  public static Set<String> localNames(List<MethodParameter> parameters)
  {
    Set<String> taken = new HashSet<String>();
    for (MethodParameter p : parameters)
    {
      taken.add(parameterName(p.getName()));
    }
    return taken;
  }

  public static String localName(String base, Set<String> taken)
  {
    String name = base;
    for (int i = 2; taken.contains(name); i++)
    {
      name = base + i;
    }
    taken.add(name);
    return name;
  }

  //------------------------
  // Code in state machines
  //------------------------

  // An action's statements at indent (see slotCode). A guarded entry or exit action (entry [g] / {...})
  // runs its body only when its untagged guard holds.
  public String actionCode(Action action, UmpleClass uClass, List<MethodParameter> parameters, String indent, String slot)
  {
    if (action.getGuardCode() == null)
    {
      return slotCode(action.getCodeblock(), uClass, parameters, false, indent, slot, action.getPosition());
    }
    String guard = translateSnippetAt(action.getGuardCode(), uClass, parameters, false, true, action.getPosition(), "the guard of " + slot);
    StringBuilder code = new StringBuilder();
    for (String line : getSnippetImports())
    {
      code.append("\n" + indent + line);
    }
    String body = slotCode(action.getCodeblock(), uClass, parameters, false, indent + "    ", slot, action.getPosition());
    return guard == null ? "" : code + "\n" + indent + "if " + guard + ":" + (body.isEmpty() ? "\n" + indent + "    pass" : body);
  }

  public String preparedCode(String code, UmpleClass uClass, String indent)
  {
    return nativeCode(code, null, indent, null, uClass);
  }

  public String activityCode(Activity activity, UmpleClass uClass, String indent)
  {
    String code = slotCode(activity.getCodeblock(), uClass, new ArrayList<MethodParameter>(), false, indent,
      "the do activity of state " + activity.getState().getName(), activity.getPosition());
    return code.isEmpty() ? "\n" + indent + "pass" : code;
  }

  //------------------------
  // State-dependent methods
  //------------------------

  // A state-dependent method under name, selecting as Java's state_machine_StateDependentMethods_All
  // does: the current state's body, else its nearest enclosing state's, else the default. With
  // contracts or injections the selection runs in a helper, as in userMethod: Java puts after
  // injections before each return, which Python cannot do to native code.
  public String stateDependentMethod(UmpleClass uClass, Method method, String name)
  {
    String parameters = methodParameters(method);
    Function<String, String> selection = stateDependentSwitch(uClass, method);
    String body = selection == null ? "\n        pass" : selection.apply("        ");
    List<MethodParameter> scope = method.getMethodParameters();
    StringBuilder before = new StringBuilder();
    for (ConstraintTree pre : stateDependentContracts(uClass, method, true))
    {
      before.append(contractCheck(pre, uClass, scope, false));
    }
    before.append(injectionCode(uClass, uClass.getApplicableCodeInjectionsCustomMethod("before", method.getName(), scope),
      "before injection of " + method.getName(), scope, false, "        "));
    StringBuilder after = new StringBuilder(injectionCode(uClass, uClass.getApplicableCodeInjectionsCustomMethod("after", method.getName(), scope),
      "after injection of " + method.getName(), scope, false, "        "));
    for (ConstraintTree post : stateDependentContracts(uClass, method, false))
    {
      after.append(contractCheck(post, uClass, postconditionScope(uClass, method), false));
    }
    String header = "\n\n    def " + name + "(" + parameters + "):";
    if (before.length() == 0 && after.length() == 0)
    {
      return emitted(uClass, method, header + body);
    }
    String helper = freshMemberName(uClass, name + "_Original");
    // As in userMethod: postconditions name the returned value result, unless a parameter has that name
    String result = "result";
    while (parameterNames(method).contains(result))
    {
      result += "_";
    }
    return emitted(uClass, method, header + before
      + "\n        " + result + " = " + DECLARING_CLASS + "." + helper + "(" + parameters + ")"
      + after
      + "\n        return " + result
      + "\n\n    def " + helper + "(" + parameters + "):" + body);
  }

  // A state-dependent method is declared in states and possibly in the class, and each declaration
  // keeps its own contracts; they all apply to the method, whichever declaration comes first.
  private List<ConstraintTree> stateDependentContracts(UmpleClass uClass, Method method, boolean pre)
  {
    Set<Method> declarations = Collections.newSetFromMap(new IdentityHashMap<Method, Boolean>());
    for (Precondition condition : uClass.getPreConds())
    {
      if (condition.getMethod().compareWithTheMethod(method))
      {
        declarations.add(condition.getMethod());
      }
    }
    for (Postcondition condition : uClass.getPostConds())
    {
      if (condition.getMethod().compareWithTheMethod(method))
      {
        declarations.add(condition.getMethod());
      }
    }
    List<ConstraintTree> all = new ArrayList<ConstraintTree>();
    for (Method declaration : declarations)
    {
      for (ConstraintTree condition : contracts(uClass, declaration, pre))
      {
        if (!all.contains(condition))
        {
          all.add(condition);
        }
      }
    }
    return all;
  }

  // With several machines, each later machine falls back to the earlier one's selection.
  private Function<String, String> stateDependentSwitch(UmpleClass uClass, Method method)
  {
    Map<State, MethodBody> bodies = uClass.getStateDependentMethodBodyMap().get(method);
    MethodBody classBody = pythonBody(bodies.get(null));
    Function<String, String> body;
    if (classBody != null)
    {
      body = indent -> bodyCode(classBody, uClass, indent);
    }
    else if (!"void".equals(method.getType()))
    {
      body = indent -> "\n" + indent + "return " + defaultValue(method.getType());
    }
    else
    {
      body = null;
    }
    for (StateMachine sm : uClass.getStateMachines())
    {
      if (hasStateBody(sm, bodies))
      {
        Function<String, String> previous = body;
        body = indent -> stateSwitch(uClass, sm, bodies, previous, indent);
      }
    }
    return body;
  }

  private String stateSwitch(UmpleClass uClass, StateMachine sm, Map<State, MethodBody> bodies, Function<String, String> fallback, String indent)
  {
    StringBuilder code = new StringBuilder();
    for (State state : sm.getStates())
    {
      MethodBody own = pythonBody(bodies.get(state));
      Function<String, String> childFallback = own == null ? fallback : i -> bodyCode(own, uClass, i);
      // Of a concurrent state's regions, the first with bodies decides; Java emits a case for each
      // region, which does not compile
      String branch = null;
      for (StateMachine nested : state.getNestedStateMachines())
      {
        if (hasStateBody(nested, bodies))
        {
          branch = stateSwitch(uClass, nested, bodies, childFallback, indent + "    ");
          break;
        }
      }
      if (branch == null && own != null)
      {
        branch = bodyCode(own, uClass, indent + "    ");
      }
      if (branch != null)
      {
        code.append("\n" + indent + (code.length() == 0 ? "if " : "elif ") + smField(sm) + " is " + stateReference(state) + ":" + branch);
      }
    }
    if (fallback != null)
    {
      code.append("\n" + indent + "else:" + fallback.apply(indent + "    "));
    }
    return code.toString();
  }

  private boolean hasStateBody(StateMachine sm, Map<State, MethodBody> bodies)
  {
    for (State state : sm.getStates())
    {
      if (pythonBody(bodies.get(state)) != null)
      {
        return true;
      }
      for (StateMachine nested : state.getNestedStateMachines())
      {
        if (hasStateBody(nested, bodies))
        {
          return true;
        }
      }
    }
    return false;
  }

  private static MethodBody pythonBody(MethodBody body)
  {
    return body == null || bodyLanguage(body) == null ? null : body;
  }

  private static String bodyLanguage(MethodBody body)
  {
    return pythonLanguage(body.getCodeblock());
  }

  // Method bodies are native code, never translated.
  private String bodyCode(MethodBody body, UmpleClass uClass, String indent)
  {
    String language = bodyLanguage(body);
    return functionCode(body.getCodeblock().getCode(language), body.getCodeblock().getFirstLineIndent(language), indent, null, uClass);
  }

  // What Java's generated state-dependent method returns when no body applies: zero or false for a
  // primitive type, "" for a String, and null for any other type, Integer and Boolean included.
  private String defaultValue(String umpleType)
  {
    switch (umpleType)
    {
      case "int": case "long": case "short": case "byte": return "0";
      case "double": case "float": return "0.0";
      case "boolean": return "False";
      case "String": return "\"\"";
      default: return "None";
    }
  }
}
