namespace cruise.umple.compiler;
class JavaScriptGenerator
{
  isA JavaGenerator;
  depend java.io.*;
  depend java.nio.file.*;
  depend cruise.umple.compiler.java.*;
  depend cruise.umple.util.StringFormatter;
  depend cruise.umple.compiler.exceptions.*;

  const int UMPLE_TXL_VERSION = 1;
  const String TXL_VERSION = "TXL v10.8b";
  const String ReadmePath = "txl/README-JavaScript.txt";
  const String ReadmeContent = "These files were automatically generated by Umple for the javascript code generation. \nThey have not been deleted to improve the speed of subsequent javascript code generation. The files can be safely deleted after the generation is complete.";
  const String versionPath = "txl/TXL-JavaScript-Version.txt";
  const String versionContent = Integer.toString(UMPLE_TXL_VERSION);
  const String compiledTxlPath = "txl/umpleJavaToJavaScript.ctxl";

  @Override
  public void writeFile(UmpleElement aClass) throws IOException
  {
    if (!isTxlInstalled()) {
      System.err.println("Aborting code generation... ");
      return;
    }

    if (!isTXLValid()) {
      generateTxlFiles();
    }

    String className=aClass.getName();
    if (aClass instanceof UmpleClass)
    {
      if(((UmpleClass)aClass).hasOuterClass())
      {
        return ; // inner classes should not be writen in single files.
      }
    }

    String path = StringFormatter.addPathOrAbsolute(
                  getModel().getUmpleFile().getPath(),
                            getOutput()) +
                            aClass.getPackageName().replace(".", File.separator);
    File file = new File(path);
    file.mkdirs();
    String javascriptFilename = path + File.separator + className + ".js";
    String contents = "";

    String errorMessage = isUnsupportedFeature(aClass);
    if (errorMessage!=null) {
      System.err.println("Unsupported : Could not Generate file '" + new File(javascriptFilename).getName() + "'. This file will be missing from the output.");
      System.err.println("\t" + errorMessage);

      contents = "//An Unsupported feature for JavaScript generation was used. File could not be generated.";

      //Writting empty JavaScript file
      BufferedWriter bw = new BufferedWriter(new FileWriter(javascriptFilename));

      try
      {
        bw.write(contents);
        bw.flush();
      }
      finally
      {
        bw.close();
      }

      getModel().getGeneratedCode().put(aClass.getName(), contents);
      return;
    }

    //Specific case failing for Java code which tries to Generate HTML
    ILang language = null;

    try {
      language = getLanguageFor(aClass);
      contents = language.getCode(getModel(), aClass);
    } catch(Exception e) {
      System.err.println("Unsupported : An error occured during the code generation of " + className + ". This file will be missing form the output.");
      System.err.println("\tYou may have been using a feature which is not currently supported for JavaScript code generation.");
      return;
    }

    String filename = path + File.separator + className + ".jajs"; //jajs extension used to avoid an issue when java is generated and then javascript is generated.
    BufferedWriter bw = new BufferedWriter(new FileWriter(filename));

    try
    {
      bw.write(contents);
      bw.flush();
    }
    finally
    {
      bw.close();
      contents = "";
    }

    String CompiledTXLPath = "./txl/umpleJavaToJavaScript.ctxl";
    String[] TXLcommand = {"txl", "-l", CompiledTXLPath, filename, "-o", javascriptFilename};
    boolean foundError = false;
    try {

      Process p = Runtime.getRuntime().exec(TXLcommand);
      p.waitFor();

      BufferedReader reader = new BufferedReader(new InputStreamReader(p.getErrorStream()));

      String line = "";

      while (line!=null) {

        if(reader.ready()) {
          line = reader.readLine();
        } else {
          line = null;
          break;
        }

        if(line.contains("error")) {
          foundError = true;
        }

      }

      if (foundError) {
        throw new Exception("An error occured during the code translation.");
      }

    } catch (IOException e) {
	    throw new UmpleCompilerException("Unable to read the txl output", e);
    } catch (InterruptedException e) {
      throw new UmpleCompilerException("Unable to open Runtime Process.", e);
    } catch (Exception e) {
      throw new UmpleCompilerException("An error occured during the code generation.", e);
    }

    try {
      File javascriptFile = new File(javascriptFilename);
      Scanner jsReader = new Scanner(javascriptFile);
      while (jsReader.hasNextLine()) {
        contents += jsReader.nextLine() + "\n";
      }
      jsReader.close();
    } catch (FileNotFoundException e) {
      throw new UmpleCompilerException("Error found with compilation of " + new File(javascriptFilename).getName() + " : Output might be missing a file", e);
    }

    getModel().getGeneratedCode().put(aClass.getName(), contents);

    //Removing temp Java Files
    File javaFile = new File(filename);
    javaFile.delete();
  }

  //Checks to see if the class uses a feature that is not part of basic javascript generation
  private String isUnsupportedFeature(UmpleElement aClass) {
    if (!(aClass instanceof UmpleClass)) {
      return "Interfaces are currently unsupported for JavaScript generation.";
    }
    UmpleClass uClass = (UmpleClass)aClass;
    if (uClass.numberOfStateMachines() > 0) {
      return "State machines are currently unsupported for JavaScript generation.";
    }
    else if (uClass.numberOfParentInterface() > 0 || uClass.getIsSingleton() || uClass.getKey().isProvided() || uClass.numberOfConstraintTrees() > 0 || uClass.numberOfEnums() > 0 || uClass.numberOfTraceDirectives() > 0) {
      return "Interfaces, singletons, keys, constraints, enumerations and tracing are currently unsupported for JavaScript generation.";
    }
    else if (uClass.getExtendsClass() != null && !uClass.getExtendsClass().getPackageName().equals(uClass.getPackageName())) {
      //The superclass is required from the same folder
      return "A superclass in another namespace is currently unsupported for JavaScript generation.";
    }
    for (Method aMethod : uClass.getMethods()) {
      //Methods generated by Umple (fAutoAPI) are translated, methods written by the user are not
      if (aMethod.getSource() != Method.Source.fAutoAPI) {
        return "Method '" + aMethod.getName() + "' is currently unsupported for JavaScript generation.";
      }
    }
    for (CodeInjection inject : uClass.getCodeInjections()) {
      //Code injections added by the generator are internal, the ones written by the user are not
      if (!inject.getIsInternal()) {
        return "Code injections are currently unsupported for JavaScript generation.";
      }
    }
    for (Attribute attribute : uClass.getAttributes()) {
      if (attribute.getIsList() || attribute.getIsAutounique() || attribute.getIsUnique() || "const".equals(attribute.getModifier()) || "fixml".equals(attribute.getModifier()) ||
          !("String".equals(attribute.getType()) || "Integer".equals(attribute.getType()) || "Double".equals(attribute.getType()) || "Boolean".equals(attribute.getType()))) {
        return "Attribute '" + attribute.getName() + "' is currently unsupported for JavaScript generation. Only String, Integer, Double and Boolean attributes are supported.";
      }
    }
    for (AssociationVariable av : uClass.getAssociationVariables()) {
      AssociationVariable relatedAssociation = av.getRelatedAssociation();
      //Mandatory ends need overloaded methods, and bounded ends call static methods of the other class
      if ((av.getIsNavigable() && (av.getMultiplicity().getLowerBound() > 0 || av.getMultiplicity().getUpperBound() > 1 || av.isSorted() || av.getIsSpecialization() || (av.isImmutable() && av.isMany()))) ||
          (relatedAssociation != null && relatedAssociation.getIsNavigable() &&
           (relatedAssociation.getMultiplicity().getLowerBound() > 0 || relatedAssociation.getMultiplicity().getUpperBound() > 1))) {
        return "Association '" + av.getName() + "' is currently unsupported for JavaScript generation. Mandatory or bounded ends, sorted or specialized associations, and immutable associations with a many end are unsupported.";
      }
    }
    return null;
  }

  //Checks if TXL is installed on the System. Also checks if the version is the same
  private boolean isTxlInstalled()
  {
    //Check for TXL installation
	  try {

      Process p = Runtime.getRuntime().exec("txl -V");
      BufferedReader reader = new BufferedReader(new InputStreamReader(p.getInputStream()));

      String line;
      if(reader.ready()) {
        line = reader.readLine();
      } else {
        line = null;
      }

      if (line!=null) {
        if(!line.startsWith("TXL v")) {
          throw new IOException("TXL not found.");
        }

        if (!line.startsWith(TXL_VERSION)) {
          System.out.println("WARNING : Your installed TXL version is different from the one being used by Umple. This may cause some issues with code generation.");
          System.out.println("\tExpected TXL version : " + TXL_VERSION);
        }
      }
    } catch (IOException e) {
      System.err.println("TXL is required for JavaScript code generation. Please go to https://www.txl.ca/txl-download.html to download and install TXL.");
      return false;
	  } catch (Exception e) {
	    throw new UmpleCompilerException("Unable to open Runtime Process.", e);
	  }
	  return true;
  }

  //Checks to see if the generated Umple TXL files are still good
  private boolean isTXLValid()
  {
    try {
      //Look for TXL folder
      Path txlDir = Paths.get("txl");
      if (!Files.exists(txlDir)) {
        return false;
      }

      //Check if compiled code is present
      Path compiledTxl = Paths.get(compiledTxlPath);
      if (!Files.exists(compiledTxl)) {
        return false;
      }

      //Check if version file is present
      Path txlVersion = Paths.get(versionPath);
      if (!Files.exists(txlVersion)) {
        return false;
      }

      File versionFile = new File(versionPath);
      Scanner myReader = new Scanner(versionFile);

      //Check if file is empty
      if (!myReader.hasNextLine()) {
        return false;
      }

      //Check Version number
      String version = myReader.nextLine();
      if (!version.equals(Integer.toString(UMPLE_TXL_VERSION))) {
        return false;
      }

      myReader.close();
      return true;
    } catch (Exception e) {
      throw new UmpleCompilerException("An error occured while verifying the integrity of the Txl files.", e);
    }
  }

  //Generate the TXL files required for JavaScript Translation
  private void generateTxlFiles() throws IOException {
    //Create TXL dir
    File txlFolder = new File("txl");
    txlFolder.mkdirs();

    //Write TXL Version File
    BufferedWriter bw = new BufferedWriter(new FileWriter(versionPath));
    try {
      bw.write(versionContent);
      bw.flush();
    }
    catch (Exception e) {
      throw new UmpleCompilerException("An error occured while generating the TXL-JavaScript-Version.txt file.", e);
    }
    finally {
      bw.close();
    }

    //Write TXL README File
    bw = new BufferedWriter(new FileWriter(ReadmePath));
    try {
      bw.write(ReadmeContent);
      bw.flush();
    }
    catch (Exception e) {
      throw new UmpleCompilerException("An error occured while generating the README-JavaScript.txt file.", e);
    }
    finally {
      bw.close();
    }

    //Write the compiled TXL files
    try {
      InputStream jarSource = getClass().getResourceAsStream("/umpleJavaToJavaScript.ctxl");
      Files.copy(jarSource, Paths.get(compiledTxlPath), StandardCopyOption.REPLACE_EXISTING);
    } catch (Exception e) {
      throw new UmpleCompilerException("An error occured while generating the TXL file.", e);
    }
  }
}
