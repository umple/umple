namespace cruise.umple.compiler;

// Native Python code emission: language selection, re-indentation of native code, method wrappers,
// the constraint renderer and overload dispatch. Emitted text follows the template convention: every
// line starts with its own newline and nothing ends with one.
class PythonGenerator
{
  depend cruise.umple.parser.Position;
  depend java.util.regex.*;

  // Classes whose overload dispatchers call the argument binding helper, which class_MethodDeclaration emits.
  private Set<UmpleClass> classesNeedingBinder = new HashSet<UmpleClass>();
  // Dispatchers overloadDispatcher wrote, keyed by "Class.method", and each one's implementations and
  // parameters, keyed by its text, for mergeSameNameMethods.
  private Map<String, List<String>> dispatcherTexts = new HashMap<String, List<String>>();
  private Map<String, List<String>> dispatcherImplementations = new HashMap<String, List<String>>();
  private Map<String, List<List<MethodParameter>>> dispatcherParameters = new HashMap<String, List<List<MethodParameter>>>();
  // Numbered implementation names per "Class.method/group", so a generated group and a user group of
  // one name (a factory add and user overloads of add) never share one.
  private Map<String, List<String>> overloadGroups = new HashMap<String, List<String>>();
  // Emitted model-method text mapped to its parameters, per class (see emitted).
  private Map<String, Map<String, List<MethodParameter>>> emittedMethods = new HashMap<String, Map<String, List<MethodParameter>>>();

  //------------------------
  // Language selection
  //------------------------

  // The languages a body can be tagged with (umple_classes.grammar, codeLang).
  private static final List<String> CODE_LANGUAGES = Arrays.asList("Alloy", "Cpp", "Java", "Php", "Python", "RTCpp",
    "Ruby", "SimpleCpp", "UmpleSelf");

  // The body Python uses for a code slot: "Python" when a Python body was written, else "" when an
  // untagged body was written, else null.
  public static String pythonLanguage(CodeBlock code)
  {
    if (code == null)
    {
      return null;
    }
    if (code.hasAuthoredCode())
    {
      return code.isAuthored("Python") ? "Python" : code.isAuthored("") ? "" : null;
    }
    // code the compiler made rather than parsed
    return code.hasCode("Python") ? "Python" : code.hasCode("") ? "" : null;
  }
  public static String pythonLanguage(Method method)
  {
    if (method == null || !method.hasMethodBody())
    {
      return null;
    }
    return pythonLanguage(method.getMethodBody().getCodeblock());
  }

  private static List<String> taggedLanguages(CodeBlock code)
  {
    List<String> languages = new ArrayList<String>();
    for (String language : CODE_LANGUAGES)
    {
      // Only code written for a language, not the entry of a language whose block held conditions only
      if (code.hasAuthoredCode() ? code.isAuthored(language) : code.hasCode(language))
      {
        languages.add(language);
      }
    }
    return languages;
  }

  // A Python main: public static void main with one parameter and a Python body. The
  // compiler's main discovery can use the same rule.
  public static boolean isPythonMain(Method method)
  {
    String modifier = method.getModifier().trim().isEmpty() ? "public" : method.getModifier();
    return "main".equals(method.getName()) && "void".equals(method.getType()) && modifier.contains("public")
      && modifier.contains("static") && method.numberOfMethodParameters() == 1 && pythonLanguage(method) != null;
  }

  //------------------------
  // Native code
  //------------------------

  // nativeCode for the body of a function, preceded by the marked imports of its modelImports
  public String functionCode(String code, String firstLineIndent, String indent, Position position, UmpleClassifier owner)
  {
    StringBuilder imports = new StringBuilder();
    for (String line : modelImports(code, owner))
    {
      imports.append("\n").append(indent).append(line);
    }
    return imports + nativeCode(code, firstLineIndent, indent, position, owner);
  }

  // Marks an import native code needs; placeModelImports moves it to the start of its function
  public static final String MODEL_IMPORT = "#<<MODEL IMPORT>>";

  // The imports, marked, of the model classes native code names that Java would see without an
  // import: those of the owner's namespace and those it lists with depend. Java imports them for the
  // whole class, Python in the function that uses them.
  public List<String> modelImports(String code, UmpleClassifier owner)
  {
    List<String> imports = new ArrayList<String>();
    Set<String> names = code == null ? new HashSet<String>() : PythonSource.codeNames(code);
    for (UmpleClassifier target : visibleClassifiers(owner))
    {
      if (names.contains(target.getName()))
      {
        imports.add(MODEL_IMPORT + importOf(target));
      }
    }
    return imports;
  }

  // The other modules' model classes and interfaces that code of owner may name: those of its
  // namespace and those it lists with depend, by name or by namespace
  private List<UmpleClassifier> visibleClassifiers(UmpleClassifier owner)
  {
    List<UmpleClassifier> all = new ArrayList<UmpleClassifier>(getModel().getUmpleClasses());
    all.addAll(getModel().getUmpleInterfaces());
    UmpleClassifier ownModule = owner instanceof UmpleClass ? outermost((UmpleClass) owner) : owner;
    List<UmpleClassifier> visible = new ArrayList<UmpleClassifier>();
    for (UmpleClassifier target : all)
    {
      boolean module = !(target instanceof UmpleClass) || outermost((UmpleClass) target) == target;
      if (!module || target == ownModule || "external".equals(target.getModifier()))
      {
        continue;
      }
      boolean seen = target.getPackageName().equals(owner.getPackageName());
      for (Depend depend : owner.getDepends())
      {
        String qualified = target.getPackageName().isEmpty() ? target.getName() : target.getPackageName() + "." + target.getName();
        seen = seen || depend.getName().equals(qualified) || depend.getName().equals(target.getPackageName() + ".*");
      }
      if (seen)
      {
        visible.add(target);
      }
    }
    return visible;
  }

  // Native Python for a code slot, re-indented to indent and, when its model position is known,
  // bracketed by the source markers that map tracebacks to the model. An empty slot is pass.
  public String nativeCode(String code, String firstLineIndent, String indent, Position position, UmpleClassifier owner)
  {
    if (code == null || code.trim().isEmpty())
    {
      return "\n" + indent + "pass";
    }
    String block = PythonSource.reindent(code, firstLineIndent, indent);
    if (position == null || position.getFilename() == null)
    {
      return block;
    }
    return "\n" + indent + sourceMarker(position, owner) + block + "\n" + indent + "# end line";
  }

  // The comment starting a source region, which maps the lines after it to the model from position on
  public static String sourceMarker(Position position, UmpleClassifier owner)
  {
    return "# line " + position.getLineNumber() + " \"" + owner.getRelativePath(position.getFilename(), "Python") + "\"";
  }

  //------------------------
  // Member names
  //------------------------

  // How emitted methods name their declaring class. Unlike the class's name, __class__ cannot be
  // hidden by a parameter, needs no import, and is never a subclass, so calls through it are not
  // virtual.
  private static final String DECLARING_CLASS = "__class__";

  // A generator-owned member name for uClass: base unless a modelled member of the class or its
  // ancestors already has it, else base followed by the first free number.
  public String freshMemberName(UmpleClass uClass, String base)
  {
    Set<String> taken = memberNames(uClass);
    String name = base;
    for (int i = 2; taken.contains(name); i++)
    {
      name = base + i;
    }
    return name;
  }

  // The numbered names of an overload group's implementations: name1, name2, ... in model order,
  // skipping numbers that a modelled member of the class or another group of the class already uses.
  // group tells groups of one name apart; asking again for a group gives the same names.
  public List<String> overloadNames(UmpleClass uClass, String name, int count, String group)
  {
    String key = uClass.getName() + "." + name + "/" + group;
    if (!overloadGroups.containsKey(key))
    {
      Set<String> taken = new HashSet<String>(modelledNames(uClass));
      for (Map.Entry<String, List<String>> other : overloadGroups.entrySet())
      {
        if (other.getKey().startsWith(uClass.getName() + "."))
        {
          taken.addAll(other.getValue());
        }
      }
      overloadGroups.put(key, numberedNames(taken, name, count));
    }
    return overloadGroups.get(key);
  }

  private static List<String> numberedNames(Set<String> taken, String name, int count)
  {
    List<String> names = new ArrayList<String>();
    for (int i = 1; names.size() < count; i++)
    {
      if (!taken.contains(name + i))
      {
        names.add(name + i);
      }
    }
    return names;
  }

  // The names used by a class and its ancestors: modelled members and the numbered implementations
  // of overloaded methods.
  private static Set<String> memberNames(UmpleClass uClass)
  {
    Set<String> taken = modelledNames(uClass);
    for (UmpleClass c = uClass; c != null; c = c.getExtendsClass())
    {
      Map<String, Integer> declarations = new HashMap<String, Integer>();
      for (Method m : c.getMethods())
      {
        if (m.getSource() != Method.Source.fAutoAPI)
        {
          declarations.put(m.getName(), declarations.containsKey(m.getName()) ? declarations.get(m.getName()) + 1 : 1);
        }
      }
      Set<String> modelled = modelledNames(c);
      for (Map.Entry<String, Integer> group : declarations.entrySet())
      {
        if (group.getValue() > 1)
        {
          taken.addAll(numberedNames(modelled, group.getKey(), group.getValue()));
        }
      }
    }
    return taken;
  }

  private static Set<String> modelledNames(UmpleClass uClass)
  {
    Set<String> taken = new HashSet<String>();
    for (UmpleClass c = uClass; c != null; c = c.getExtendsClass())
    {
      for (Method m : c.getMethods())
      {
        taken.add(m.getName());
      }
      for (Attribute a : c.getAttributes())
      {
        taken.add(a.getName());
      }
      for (AssociationVariable av : c.getAssociationVariables())
      {
        taken.add(av.getName());
      }
      for (StateMachine sm : c.getStateMachines())
      {
        taken.add(sm.getName());
      }
    }
    return taken;
  }

  //------------------------
  // Diagnostics for user code
  //------------------------

  private void errorAt(int code, Position position, String... arguments)
  {
    report(new ErrorMessage(code, position == null ? new Position("", 0, 0, 0) : position, arguments));
  }

  // Reports methods and injections of a class and its inner classes that Python cannot generate
  // (9210) or whose signatures it rejects. Only code Python would use counts. False when the class
  // must not be generated.
  public boolean checkUserCode(UmpleClass uClass)
  {
    int errors = getModel().getLastResult().numberOfErrorMessages();
    String className = uClass.getName();
    if (uClass.numberOfEmitMethods() > 0)
    {
      error(9210, uClass, "The emit template " + uClass.getEmitMethod(0).getMethod().getName(), className);
    }
    Map<String, Boolean> staticByName = new HashMap<String, Boolean>();
    for (Method m : uClass.getMethods())
    {
      if (m.getSource() == Method.Source.fAutoAPI || (pythonLanguage(m) == null && !m.getIsAbstract()))
      {
        continue;
      }
      Boolean otherIsStatic = staticByName.put(m.getName(), isStatic(m));
      if (otherIsStatic != null && otherIsStatic != isStatic(m))
      {
        // This generator does not dispatch mixed static and instance methods under one name.
        errorAt(9210, m.getPosition(), "Overloads of " + m.getName() + " that mix static and instance methods", className);
      }
      if (m.getName().equals(className) && "".equals(m.getType()))
      {
        errorAt(9210, m.getPosition(), "The custom constructor " + m.getName(), className);
      }
      else if (m.getIsQueued() && isStatic(m))
      {
        errorAt(9210, m.getPosition(), "The static queued method " + m.getName(), className);
      }
      checkSignature(m);
    }
    for (CodeInjection injection : uClass.getCodeInjections())
    {
      String language = pythonLanguage(injection.getSnippet());
      if (injection.getIsInternal() || language == null)
      {
        continue;
      }
      if (injection.getIsAround())
      {
        errorAt(9210, injection.getPosition(), "The around injection on " + injection.getOperation(), className);
      }
      else if (injection.hasCodeLabel())
      {
        errorAt(9210, injection.getPosition(), "The injection at label " + injection.getInjectionlabel(), className);
      }
    }
    for (UmpleClass inner : uClass.getInnerClasses())
    {
      checkUserCode(inner);
    }
    return getModel().getLastResult().numberOfErrorMessages() == errors;
  }

  public void warnNoPythonBody(Method method)
  {
    errorAt(9212, method.getPosition(), "Method " + method.getName(), String.join(", ", taggedLanguages(method.getMethodBody().getCodeblock())));
  }

  //------------------------
  // Constraints
  //------------------------

  // A constraint as a Python boolean expression. Attributes and associations are read through getters
  // (on the class in a static method), except attributesAsParameters, read from the aX parameter of a
  // setter or constructor. A parameter named like an attribute reads the attribute, as Java's output
  // does. Negations are bracketed because Python's not binds more loosely than Java's !, and nested
  // comparisons because Python would chain them.
  public String condition(ConstraintTree constraint, UmpleClass uClass, List<MethodParameter> parameters,
    boolean isStatic, Collection<Attribute> attributesAsParameters)
  {
    Map<String, MethodParameter> scope = new HashMap<String, MethodParameter>();
    if (parameters != null)
    {
      for (MethodParameter p : parameters)
      {
        scope.put(p.getName(), p);
      }
    }
    PythonConstraintScope context = new PythonConstraintScope(uClass, scope, isStatic ? DECLARING_CLASS : "self",
      attributesAsParameters == null ? new ArrayList<Attribute>() : attributesAsParameters);
    conditionImports.clear();
    ConstraintVariable top = constraint;
    while (top instanceof ConstraintTree && !((ConstraintTree) top).getDisplayNegation()
      && !((ConstraintTree) top).getDisplayBrackets() && ((ConstraintTree) top).getRoot() instanceof ConstraintTree)
    {
      top = ((ConstraintTree) top).getRoot();
    }
    String rendered = top instanceof ConstraintTree && ((ConstraintTree) top).getDisplayNegation()
      ? "not " + negated((ConstraintTree) top, context) : render(top, context, false);
    for (String name : scope.keySet())
    {
      // A parameter would hide the Python name the expression calls
      String python = parameterName(name);
      if (RENDERER_NAMES.contains(python) && Pattern.compile("(?<![\\w.])" + python + "[(.]").matcher(rendered).find())
      {
        throw new PythonSnippetException("A constraint where a parameter named " + python + " hides Python's " + python, null);
      }
    }
    return rendered;
  }

  // The names of builtins and modules that rendered constraints call.
  private static final List<String> RENDERER_NAMES = Arrays.asList("len", "str", "int", "math", "Fraction");

  public String condition(ConstraintTree constraint, UmpleClass uClass, List<MethodParameter> parameters)
  {
    return condition(constraint, uClass, parameters, false, null);
  }

  // The imports the last condition needs in its function, for the other model classes whose
  // constants it reads (imported there, as everywhere, so that modules can import each other)
  private List<String> conditionImports = new ArrayList<String>();

  public List<String> getConditionImports()
  {
    return new ArrayList<String>(conditionImports);
  }

  // The statements that test a condition at indent: the imports it needs, then "if not (...):"
  public String conditionCheck(ConstraintTree constraint, UmpleClass uClass, List<MethodParameter> parameters,
    boolean isStatic, Collection<Attribute> attributesAsParameters, String indent)
  {
    String check = condition(constraint, uClass, parameters, isStatic, attributesAsParameters);
    StringBuilder code = new StringBuilder();
    for (String line : conditionImports)
    {
      code.append("\n" + indent + line);
    }
    return code + "\n" + indent + "if not (" + check + "):";
  }

  // Java's message for a failed pre- or postcondition.
  public String contractMessage(ConstraintTree constraint)
  {
    return pythonString("Please provide a valid " + constraint.getNamedNames());
  }

  private String render(ConstraintVariable v, PythonConstraintScope context, boolean member)
  {
    if (v instanceof ConstraintTree)
    {
      ConstraintTree tree = (ConstraintTree) v;
      if (tree.getDisplayNegation())
      {
        return "(not " + negated(tree, context) + ")";
      }
      String inner = render(tree.getRoot(), context, member);
      return tree.getDisplayBrackets() ? "(" + inner + ")" : inner;
    }
    if (v instanceof ConstraintOperator)
    {
      return renderOperator((ConstraintOperator) v, context, member);
    }
    if (v instanceof ConstraintLiteral)
    {
      return literalValue(((ConstraintLiteral) v).getValue());
    }
    if (v instanceof ConstraintAttribute)
    {
      Attribute attribute = ((ConstraintAttribute) v).getAttribute();
      if (attribute.getIsInternalTransient())
      {
        // The comparator Java keeps for a sorted end; Python sorts with a key and has no such field
        throw new PythonSnippetException("A constraint naming " + attribute.getName() + ", which only Java generates,", null);
      }
      int index = ((ConstraintAttribute) v).getIndex();
      String receiver = member ? "" : context.getReceiver() + ".";
      if ("const".equals(attribute.getModifier()))
      {
        // Through the class, which inherits its ancestors' constants and needs no import.
        return member ? attribute.getName() : DECLARING_CLASS + "." + attribute.getName();
      }
      if (!member && index == -1 && context.getAttributesAsParameters().contains(attribute))
      {
        return translate("parameterOne", attribute);
      }
      if (attribute.getModifier().contains("internal"))
      {
        return receiver + "_" + attribute.getName();
      }
      if (attribute.getIsList() && index == -1)
      {
        return receiver + translate("getManyMethod", attribute) + "()";
      }
      return receiver + translate("getMethod", attribute) + "(" + (index == -1 ? "" : "" + index) + ")";
    }
    if (v instanceof ConstraintAssociation)
    {
      ConstraintAssociation association = (ConstraintAssociation) v;
      AssociationVariable av = association.getAssociation();
      String receiver = member ? "" : context.getReceiver() + ".";
      if (association.getNumberOf())
      {
        return receiver + translate("numberOfMethod", av) + "()";
      }
      if (association.getIndex() != -1)
      {
        return receiver + translate("getMethod", av) + "(" + association.getIndex() + ")";
      }
      return receiver + translate(av.getMultiplicity().getUpperBound() == 1 ? "getMethod" : "getManyMethod", av) + "()";
    }
    if (v instanceof ConstraintMethodParameter)
    {
      return parameterName(((ConstraintMethodParameter) v).getParameter().getName());
    }
    if (v instanceof ConstraintUnassignedName)
    {
      String name = ((ConstraintUnassignedName) v).getValue();
      if ("this".equals(name) || name.isEmpty())
      {
        return name.isEmpty() ? "" : "self"; // an empty name is the argument list of a call without arguments
      }
      String literal = literalValue(name);
      if (!literal.equals(name) || member)
      {
        return literal;
      }
      if (context.getParameters().containsKey(name))
      {
        return parameterName(name);
      }
      ConstraintVariable inherited = inheritedMember(context.getUClass(), name);
      if (inherited != null)
      {
        return render(inherited, context, false);
      }
      if (isEnumeration(context.getUClass(), name))
      {
        return DECLARING_CLASS + "." + name; // enumerations are nested in the classes that use them
      }
      if (inherits(context.getUClass(), name))
      {
        return DECLARING_CLASS; // the class or an ancestor, qualifying one of its enumerations
      }
      if (interfaceConstant(context.getUClass(), name) != null)
      {
        return DECLARING_CLASS + "." + name; // the class inherits it from the interface
      }
      throw new PythonSnippetException("A constraint naming " + name + ", which is not a parameter, attribute,"
        + " association or enumeration of " + context.getUClass().getName() + ",", null);
    }
    if (v instanceof ConstraintStateMachine)
    {
      return (member ? "" : context.getReceiver() + ".") + translate("getFullMethod", ((ConstraintStateMachine) v).getStateMachine()) + "()";
    }
    throw unsupportedConstraint(v);
  }

  // True when name is the Python name of an enumeration nested in the class or one of its ancestors
  // (the states of a state machine, or a declared enumeration), or of a model enumeration, which is
  // copied into the classes that use it.
  private boolean isEnumeration(UmpleClass uClass, String name)
  {
    for (UmpleClass c = uClass; c != null; c = c.getExtendsClass())
    {
      for (StateMachine sm : c.getAllStateMachines())
      {
        if (translate("type", sm).equals(name))
        {
          return true;
        }
      }
      for (UmpleEnumeration anEnum : c.getEnums())
      {
        if (StringFormatter.toPascalCase(anEnum.getName()).equals(name))
        {
          return true;
        }
      }
    }
    for (UmpleEnumeration anEnum : getModel().getEnums())
    {
      if (StringFormatter.toPascalCase(anEnum.getName()).equals(name))
      {
        return true;
      }
    }
    return false;
  }

  // The constant of an interface that the class or an ancestor implements with the given name, or null.
  private static Constant interfaceConstant(UmpleClass uClass, String name)
  {
    Set<UmpleInterface> seen = new HashSet<UmpleInterface>();
    for (UmpleClass c = uClass; c != null; c = c.getExtendsClass())
    {
      for (UmpleInterface anInterface : c.getParentInterface())
      {
        Constant constant = declaredConstant(anInterface, name, seen);
        if (constant != null)
        {
          return constant;
        }
      }
    }
    return null;
  }

  private static Constant declaredConstant(UmpleInterface anInterface, String name)
  {
    return declaredConstant(anInterface, name, new HashSet<UmpleInterface>());
  }

  // Visits each interface once per lookup, in declaration order: shared ancestors are not searched again
  private static Constant declaredConstant(UmpleInterface anInterface, String name, Set<UmpleInterface> seen)
  {
    if (!seen.add(anInterface))
    {
      return null;
    }
    for (Constant constant : anInterface.getConstants())
    {
      if (constant.getName().equals(name))
      {
        return constant;
      }
    }
    for (UmpleInterface parent : anInterface.getExtendsInterface())
    {
      Constant constant = declaredConstant(parent, name, seen);
      if (constant != null)
      {
        return constant;
      }
    }
    return null;
  }

  // Whether the class, or an ancestor nearer than owner, has its own member name, which Python's
  // __class__.name would read where Java's owner.name reads the owner's.
  private static boolean hidesMember(UmpleClass uClass, String owner, String name)
  {
    for (UmpleClass c = uClass; c != null && !c.getName().equals(owner); c = c.getExtendsClass())
    {
      // getAttribute and getAssociationVariable also find inherited members, which are the owner's
      for (Attribute attribute : c.getAttributes())
      {
        if (attribute.getName().equals(name))
        {
          return true;
        }
      }
      for (AssociationVariable variable : c.getAssociationVariables())
      {
        if (variable.getName().equals(name))
        {
          return true;
        }
      }
      for (Constant constant : c.getConstants())
      {
        if (constant.getName().equals(name))
        {
          return true;
        }
      }
    }
    return false;
  }

  // The name a qualified constraint name reads: unresolved, or resolved to the class's own attribute.
  private static String memberName(ConstraintVariable v)
  {
    return v instanceof ConstraintUnassignedName ? ((ConstraintUnassignedName) v).getValue()
      : v instanceof ConstraintAttribute ? ((ConstraintAttribute) v).getAttribute().getName() : null;
  }

  // Another model class's constant or enumeration value that a constraint names through its class
  // (Limit.MAX, shop.Limit.MAX, Outer.Limits.MAX, Sub.Limits.MAX, Limit.Level.High): the classifier
  // and the names after it, or null. The longest leading path that names a classifier counts, then
  // the nested classes after it, inherited ones included; a first name the constraint already has in
  // scope keeps its meaning.
  private Object[] foreignMember(ConstraintVariable v, PythonConstraintScope context)
  {
    List<String> path = dottedNames(v);
    if (path == null || path.size() < 2 || context.getParameters().containsKey(path.get(0))
      || inheritedMember(context.getUClass(), path.get(0)) != null || inherits(context.getUClass(), path.get(0)))
    {
      return null;
    }
    for (int length = path.size() - 1; length >= 1; length--)
    {
      String prefix = String.join(".", path.subList(0, length));
      List<UmpleClassifier> classifiers = new ArrayList<UmpleClassifier>(getModel().getUmpleClasses());
      classifiers.addAll(getModel().getUmpleInterfaces());
      for (UmpleClassifier c : classifiers)
      {
        String reference = c instanceof UmpleClass ? classReference((UmpleClass) c) : c.getName();
        if (prefix.equals(reference) || prefix.equals(c.getPackageName() + "." + reference))
        {
          UmpleClassifier owner = c;
          List<String> names = path.subList(length, path.size());
          while (names.size() > 1 && owner instanceof UmpleClass && nestedClass((UmpleClass) owner, names.get(0)) != null)
          {
            owner = nestedClass((UmpleClass) owner, names.get(0));
            names = names.subList(1, names.size());
          }
          return new Object[] { owner, names };
        }
      }
    }
    return null;
  }

  // The nested class of that name that uClass declares or inherits, or null
  private UmpleClass nestedClass(UmpleClass uClass, String name)
  {
    for (UmpleClass k = uClass; k != null; k = k.getExtendsClass())
    {
      for (UmpleClass inner : getModel().getUmpleClasses())
      {
        if (inner.getOuterClass() == k && inner.getName().equals(name))
        {
          return inner;
        }
      }
    }
    return null;
  }

  // The names of a chain of member accesses (a.b.c), or null when a part is anything else
  private static List<String> dottedNames(ConstraintVariable v)
  {
    v = unwrap(v);
    if (v instanceof ConstraintUnassignedName)
    {
      return new ArrayList<String>(Arrays.asList(((ConstraintUnassignedName) v).getValue()));
    }
    if (!(v instanceof ConstraintOperator) || !".".equals(((ConstraintOperator) v).getValue()) || ((ConstraintOperator) v).numberOfSubConstraints() != 2)
    {
      return null;
    }
    List<String> left = dottedNames(((ConstraintOperator) v).getLeft());
    ConstraintVariable right = unwrap(((ConstraintOperator) v).getRight());
    List<String> rest = right instanceof ConstraintAttribute ? Arrays.asList(memberName(right)) : dottedNames(right);
    if (left == null || rest == null)
    {
      return null;
    }
    left.addAll(rest);
    return left;
  }

  // A foreign constant or enumeration value, read through its class, which the function imports
  private String foreignReference(UmpleClassifier other, List<String> names, PythonConstraintScope context)
  {
    boolean constant = names.size() == 1 && constantType(other, names.get(0)) != null;
    boolean enumValue = names.size() == 2 && other instanceof UmpleClass && isEnumeration((UmpleClass) other, names.get(0));
    if (!constant && !enumValue)
    {
      throw new PythonSnippetException("A constraint naming " + other.getName() + "." + String.join(".", names)
        + ", which is not a constant of " + other.getName() + ",", null);
    }
    List<String> locals = new ArrayList<String>();
    for (String parameter : context.getParameters().keySet())
    {
      locals.add(parameterName(parameter));
    }
    String[] use = classUse(context.getUClass(), other.getName(), String.join(", ", locals));
    if (use[1] != null && !conditionImports.contains(use[1]))
    {
      conditionImports.add(use[1]);
    }
    return use[0] + "." + String.join(".", names);
  }

  // The declared type of a constant classifier has or inherits, or null when it has none of that name
  private static String constantType(UmpleClassifier classifier, String name)
  {
    if (classifier instanceof UmpleInterface)
    {
      Constant constant = declaredConstant((UmpleInterface) classifier, name);
      return constant == null ? null : constant.getType();
    }
    for (UmpleClass c = (UmpleClass) classifier; c != null; c = c.getExtendsClass())
    {
      Attribute attribute = c.getAttribute(name);
      if (attribute != null && attribute.isConstant())
      {
        return attribute.getType() + (attribute.getIsList() ? "[]" : "");
      }
      for (Constant constant : c.getConstants())
      {
        if (constant.getName().equals(name))
        {
          return constant.getType();
        }
      }
    }
    Constant inherited = interfaceConstant((UmpleClass) classifier, name);
    return inherited == null ? null : inherited.getType();
  }

  // The attribute or association of a class or its ancestors with the given name, which the front end
  // leaves unresolved when it is inherited, or null.
  private static ConstraintVariable inheritedMember(UmpleClass uClass, String name)
  {
    for (UmpleClass c = uClass; c != null; c = c.getExtendsClass())
    {
      if (c.getAttribute(name) != null)
      {
        return new ConstraintAttribute(c.getAttribute(name));
      }
      if (c.getAssociationVariable(name) != null)
      {
        return new ConstraintAssociation(c.getAssociationVariable(name));
      }
    }
    return null;
  }

  // The operand of a negation, bracketed unless it is a single name or call.
  private String negated(ConstraintTree tree, PythonConstraintScope context)
  {
    String inner = render(tree.getRoot(), context, false);
    return tree.getDisplayBrackets() || tree.getRoot() instanceof ConstraintOperator && !isCall(tree.getRoot()) ? "(" + inner + ")" : inner;
  }

  private String renderOperator(ConstraintOperator op, PythonConstraintScope context, boolean member)
  {
    String value = op.getValue();
    ConstraintVariable left = op.getLeft();
    ConstraintVariable right = op.getRight();
    if (op.numberOfSubConstraints() == 1)
    {
      if ("!".equals(value))
      {
        return "(not " + render(left, context, false) + ")";
      }
      if ("initialise".equals(value) || "+".equals(value))
      {
        return render(left, context, member);
      }
      if ("-".equals(value))
      {
        return "-" + render(left, context, false);
      }
      throw unsupportedConstraint(op);
    }
    if (op.numberOfSubConstraints() != 2)
    {
      throw unsupportedConstraint(op);
    }
    if ("".equals(value))
    {
      // A call: its argument list is a bracketed tree, and an empty one holds an empty name.
      String arguments = render(right instanceof ConstraintTree ? ((ConstraintTree) right).getRoot() : right, context, false);
      if (isLength(left, context) && arguments.isEmpty())
      {
        ConstraintVariable string = ((ConstraintOperator) left).getLeft();
        String text = render(string, context, member);
        return "String".equals(declaredType(string, context)) ? javaStringLength(text) : "len(" + text + ")";
      }
      String library = libraryCall(unwrap(left), right, context);
      if (library != null)
      {
        return library;
      }
      boolean method = left instanceof ConstraintUnassignedName && !member
        && !context.getParameters().containsKey(((ConstraintUnassignedName) left).getValue());
      String callee = method ? context.getReceiver() + "." + ((ConstraintUnassignedName) left).getValue() : render(left, context, member);
      return callee + "(" + arguments + ")";
    }
    if (isLength(op, context))
    {
      return "len(" + render(left, context, member) + ")"; // an array's length
    }
    if (".".equals(value))
    {
      // The parser leaves this.x unresolved when x is an inherited attribute or association
      ConstraintVariable target = unwrap(left);
      ConstraintVariable name = unwrap(right);
      Object[] foreign = foreignMember(op, context);
      if (foreign != null)
      {
        return foreignReference((UmpleClassifier) foreign[0], (List<String>) foreign[1], context);
      }
      if (target instanceof ConstraintUnassignedName && "this".equals(((ConstraintUnassignedName) target).getValue())
        && name instanceof ConstraintUnassignedName)
      {
        ConstraintVariable inherited = inheritedMember(context.getUClass(), ((ConstraintUnassignedName) name).getValue());
        right = inherited == null ? right : inherited;
      }
      else if (target instanceof ConstraintUnassignedName && !"this".equals(((ConstraintUnassignedName) target).getValue())
        && !((ConstraintUnassignedName) target).getValue().equals(context.getUClass().getName())
        && memberName(name) != null && hidesMember(context.getUClass(), ((ConstraintUnassignedName) target).getValue(), memberName(name)))
      {
        // An ancestor or interface is read through __class__, which would find the nearer member; the
        // parser resolves a name the class declares to that member, so both forms are checked
        throw new PythonSnippetException("A constraint naming " + ((ConstraintUnassignedName) target).getValue() + "."
          + memberName(name) + ", which the class hides with a member of that name,", null);
      }
      return render(left, context, member) + "." + render(right, context, true);
    }
    if (",".equals(value))
    {
      return render(left, context, false) + ", " + render(right, context, false);
    }
    if ("&&".equals(value) || "||".equals(value))
    {
      return render(left, context, false) + ("&&".equals(value) ? " and " : " or ") + render(right, context, false);
    }
    if (value.startsWith("has") || value.startsWith("cardinality"))
    {
      return listOperation(value, left, right, context);
    }
    if ("concatenate".equals(value))
    {
      return asString(left, context) + " + " + asString(right, context);
    }
    if ("in==".equals(value) || "in!=".equals(value))
    {
      return stateCheck(left, right, "in==".equals(value), context);
    }
    String comparison = value.replace("object", "");
    if ("==".equals(comparison) || "!=".equals(comparison))
    {
      if (stateNamed(left, right) != null)
      {
        return stateCheck(left, right, "==".equals(comparison), context);
      }
      // Java calls equals between two names the parser leaves unresolved (event parameters, for example),
      // which Python's == is (by key for a keyed class), and compares other model objects by reference.
      // Decided from the operands: Java's rendering rewrites the operator in the model.
      boolean equalsCall = unwrap(left) instanceof ConstraintUnassignedName && unwrap(right) instanceof ConstraintUnassignedName;
      boolean identity = isNone(left) || isNone(right)
        || !equalsCall && (isModelObject(left, context) || isModelObject(right, context));
      String operator = identity ? ("==".equals(comparison) ? " is " : " is not ") : " " + comparison + " ";
      return comparand(left, context) + operator + comparand(right, context);
    }
    if (Arrays.asList("<", ">", "<=", ">=").contains(comparison))
    {
      return comparand(left, context) + " " + comparison + " " + comparand(right, context);
    }
    if (("/".equals(value) || "%".equals(value)) && isIntegral(left, context) && isIntegral(right, context))
    {
      // Java divides integers toward zero, exactly; the remainder has the sign of the dividend. The
      // remainder uses its operands twice, so unless they are plain values they are evaluated once,
      // as a lambda's arguments: a call may have effects.
      String a = render(left, context, false);
      String b = render(right, context, false);
      String fraction = standardName("fractions", "Fraction");
      if ("/".equals(value))
      {
        return "int(" + fraction + "(" + a + ", " + b + "))";
      }
      if (isPlainValue(left, context) && isPlainValue(right, context))
      {
        return "(" + a + " - " + b + " * int(" + fraction + "(" + a + ", " + b + ")))";
      }
      return "(lambda x, y: x - y * int(" + fraction + "(x, y)))(" + a + ", " + b + ")";
    }
    if ("%".equals(value))
    {
      // Java's remainder has the sign of the dividend, for floating values too
      return standardName("math", null) + ".fmod(" + render(left, context, false) + ", " + render(right, context, false) + ")";
    }
    if (Arrays.asList("+", "-", "*", "/", "^", "<<", ">>").contains(value))
    {
      String a = render(left, context, false);
      String b = render(right, context, false);
      if ("<<".equals(value) || ">>".equals(value))
      {
        String type = shiftType(left, context);
        if (type != null)
        {
          int mask = "long".equals(type) ? 63 : 31;
          // In-range literals already have Java's distance; every other operand is read once.
          if (!b.matches("[0-9]+") || new java.math.BigInteger(b).compareTo(java.math.BigInteger.valueOf(mask)) > 0)
          {
            b = "(" + b + " & " + mask + ")";
          }
        }
      }
      return a + " " + value + " " + b;
    }
    throw unsupportedConstraint(op);
  }

  // has, has all and cardinality. The parser writes "s has all a, b" as a chain whose left operand ends
  // with the subject, ((s has a) && s) has b, which only reads right as Java text; here each link of the
  // chain is rendered on its own. A cardinality is numberOfX() for an association, len() otherwise.
  private String listOperation(String value, ConstraintVariable subject, ConstraintVariable operand, PythonConstraintScope context)
  {
    ConstraintVariable chain = unwrap(subject);
    if (chain instanceof ConstraintOperator && Arrays.asList("&&", "||").contains(((ConstraintOperator) chain).getValue()))
    {
      ConstraintOperator link = (ConstraintOperator) chain;
      return render(link.getLeft(), context, false) + ("&&".equals(link.getValue()) ? " and " : " or ")
        + listOperation(value, link.getRight(), operand, context);
    }
    if (value.startsWith("has"))
    {
      return comparand(operand, context) + " in " + comparand(subject, context);
    }
    boolean counted = chain instanceof ConstraintAssociation && ((ConstraintAssociation) chain).getNumberOf();
    String size = counted ? render(subject, context, false) : "len(" + render(subject, context, false) + ")";
    return size + " " + value.substring("cardinality".length()) + " " + comparand(operand, context);
  }

  // Java's equals on any value, or a method of a String, number, boolean or array, which is a Java
  // library method; null for any other call. Python spells equals as == and contains as a membership
  // test; any other library method would fail each time the constraint runs, so the constraint is
  // reported instead.
  private String libraryCall(ConstraintVariable callee, ConstraintVariable argumentList, PythonConstraintScope context)
  {
    if (!(callee instanceof ConstraintOperator) || !".".equals(((ConstraintOperator) callee).getValue())
      || !(unwrap(((ConstraintOperator) callee).getRight()) instanceof ConstraintUnassignedName))
    {
      return null;
    }
    ConstraintVariable receiver = ((ConstraintOperator) callee).getLeft();
    String name = ((ConstraintUnassignedName) unwrap(((ConstraintOperator) callee).getRight())).getValue();
    List<ConstraintVariable> arguments = new ArrayList<ConstraintVariable>();
    callArguments(argumentList, arguments);
    String type = declaredType(receiver, context);
    UmpleClassifier model = type == null ? null : getModel().getUmpleClass(type) != null ? getModel().getUmpleClass(type) : getModel().getUmpleInterface(type);
    Map<String, Method> authored = new HashMap<String, Method>();
    collectConstraintMethods(model, "equals", authored, new HashSet<UmpleClassifier>());
    if ("equals".equals(name) && arguments.size() == 1 && authored.isEmpty())
    {
      // == is equals for Python values, and for model objects through the __eq__ that keys generate;
      // a model's own equals method is called as it is
      return "(" + comparand(receiver, context) + " == " + comparand(unwrap(arguments.get(0)), context) + ")";
    }
    if (type == null || !isSimpleType(type) && !type.endsWith("[]"))
    {
      return null; // a model object, or a value of a type the model does not define
    }
    if ("contains".equals(name) && arguments.size() == 1)
    {
      // Java evaluates the String before its argument, which in would reverse
      return "String".equals(type) ? "str.__contains__(" + render(receiver, context, false) + ", " + render(unwrap(arguments.get(0)), context, false) + ")"
        : "(" + comparand(unwrap(arguments.get(0)), context) + " in " + comparand(receiver, context) + ")";
    }
    throw new PythonSnippetException("A constraint calling the Java method " + name + "()", null);
  }

  // Java's String.length(): the number of UTF-16 code units, two for a character beyond the Basic
  // Multilingual Plane
  public static String javaStringLength(String value)
  {
    return "(len(str.encode(" + value + ", \"utf-16-le\", \"surrogatepass\")) // 2)";
  }

  // Only strings and arrays have a built-in length; a model's length member keeps its own meaning.
  private boolean isLength(ConstraintVariable v, PythonConstraintScope context)
  {
    v = unwrap(v);
    ConstraintVariable member = v instanceof ConstraintOperator && ".".equals(((ConstraintOperator) v).getValue()) ? unwrap(((ConstraintOperator) v).getRight()) : null;
    if (!(member instanceof ConstraintUnassignedName) || !"length".equals(((ConstraintUnassignedName) member).getValue()))
    {
      return false;
    }
    String type = declaredType(((ConstraintOperator) v).getLeft(), context);
    return "String".equals(type) || type != null && type.endsWith("[]");
  }

  // An operand of a comparison, bracketed when it is itself a comparison or boolean operation.
  private String comparand(ConstraintVariable v, PythonConstraintScope context)
  {
    String text = render(v, context, false);
    ConstraintVariable inner = v;
    while (inner instanceof ConstraintTree && !((ConstraintTree) inner).getDisplayNegation() && !((ConstraintTree) inner).getDisplayBrackets())
    {
      inner = ((ConstraintTree) inner).getRoot();
    }
    if (inner instanceof ConstraintOperator && !isCall(inner) && !".".equals(((ConstraintOperator) inner).getValue())
      && !Arrays.asList("+", "-", "*", "/", "%", "concatenate").contains(((ConstraintOperator) inner).getValue()))
    {
      return "(" + text + ")";
    }
    return text;
  }

  private String asString(ConstraintVariable v, PythonConstraintScope context)
  {
    ConstraintVariable inner = unwrap(v);
    String text = render(v, context, false);
    boolean isText = inner instanceof ConstraintLiteral && ((ConstraintLiteral) inner).getValue().startsWith("\"")
      || inner instanceof ConstraintOperator && "concatenate".equals(((ConstraintOperator) inner).getValue());
    String type = declaredType(inner, context);
    if (!isText && isModelType(type))
    {
      // A missing object is null in Java's text; a call is evaluated once
      return isCall(inner) ? "(lambda x: \"null\" if x is None else str(x))(" + text + ")"
        : "(\"null\" if " + text + " is None else str(" + text + "))";
    }
    // Java writes booleans and null in lower case
    return isText ? text : isNone(inner) ? "\"null\""
      : isBooleanValued(v, type) ? "(\"true\" if " + text + " else \"false\")" : "str(" + text + ")";
  }

  // Whether v, whose declared type is type, is true or false: a comparison, a negation, a logical
  // operator, or a boolean value.
  private static boolean isBooleanValued(ConstraintVariable v, String type)
  {
    ConstraintVariable inner = unwrap(v); // a tree only when it is negated, however deeply bracketed
    return "Boolean".equals(type) || "boolean".equals(type) || inner instanceof ConstraintTree
      || inner instanceof ConstraintOperator && Arrays.asList("==", "!=", "<", ">", "<=", ">=", "&&", "||", "!", "in==", "in!=")
      .contains(((ConstraintOperator) inner).getValue().replace("object", ""));
  }

  // [sm == S] and [sm is in state S]: the machine that owns state S is in S, compared through its enum.
  private String stateCheck(ConstraintVariable machine, ConstraintVariable state, boolean isIn, PythonConstraintScope context)
  {
    State target = stateNamed(machine, state);
    if (target == null)
    {
      throw unsupportedConstraint(machine);
    }
    // The enum is reached through the class, which inherits a parent's machine and its enum.
    StateMachine owner = target.getStateMachine();
    return context.getReceiver() + "." + translate("getMethod", owner) + "()" + (isIn ? " is " : " is not ")
      + DECLARING_CLASS + "." + translate("type", owner) + "." + target.getName();
  }

  // The state of the machine in machineVariable that stateVariable names, searching nested machines.
  private static State stateNamed(ConstraintVariable machineVariable, ConstraintVariable stateVariable)
  {
    ConstraintVariable machine = unwrap(machineVariable);
    ConstraintVariable state = unwrap(stateVariable);
    if (!(machine instanceof ConstraintStateMachine) || state == null)
    {
      return null;
    }
    String name = state instanceof ConstraintState ? ((ConstraintState) state).getName()
      : state instanceof ConstraintUnassignedName ? ((ConstraintUnassignedName) state).getValue() : null;
    return name == null ? null : findState(((ConstraintStateMachine) machine).getStateMachine(), name);
  }

  private static State findState(StateMachine sm, String name)
  {
    for (State s : sm.getStates())
    {
      if (s.getName().equals(name))
      {
        return s;
      }
      for (StateMachine nested : s.getNestedStateMachines())
      {
        State found = findState(nested, name);
        if (found != null)
        {
          return found;
        }
      }
    }
    return null;
  }

  private static ConstraintVariable unwrap(ConstraintVariable v)
  {
    while (v instanceof ConstraintTree && !((ConstraintTree) v).getDisplayNegation())
    {
      v = ((ConstraintTree) v).getRoot();
    }
    return v;
  }

  private static boolean isCall(ConstraintVariable v)
  {
    return v instanceof ConstraintOperator && "".equals(((ConstraintOperator) v).getValue());
  }

  // A literal or a parameter, which Python can evaluate more than once without effect.
  private static boolean isPlainValue(ConstraintVariable v, PythonConstraintScope context)
  {
    ConstraintVariable inner = unwrap(v);
    return inner instanceof ConstraintLiteral || inner instanceof ConstraintMethodParameter
      || inner instanceof ConstraintUnassignedName && context.getParameters().containsKey(((ConstraintUnassignedName) inner).getValue());
  }

  // x in this.x, or null for any other value.
  private static ConstraintVariable thisMember(ConstraintVariable v)
  {
    if (!(v instanceof ConstraintOperator) || !".".equals(((ConstraintOperator) v).getValue()))
    {
      return null;
    }
    ConstraintVariable target = unwrap(((ConstraintOperator) v).getLeft());
    boolean onThis = target instanceof ConstraintUnassignedName && "this".equals(((ConstraintUnassignedName) target).getValue());
    return onThis ? unwrap(((ConstraintOperator) v).getRight()) : null;
  }

  private static boolean isNone(ConstraintVariable v)
  {
    ConstraintVariable inner = unwrap(v);
    return inner instanceof ConstraintUnassignedName && "null".equals(((ConstraintUnassignedName) inner).getValue())
      || inner instanceof ConstraintLiteral && "null".equals(((ConstraintLiteral) inner).getValue());
  }

  // Model objects are compared by identity.
  private boolean isModelObject(ConstraintVariable v, PythonConstraintScope context)
  {
    String type = declaredType(v, context);
    return isModelType(type) || type != null && type.endsWith("[]") && isModelType(type.substring(0, type.length() - 2));
  }

  // The type the model declares for v's value (an int for an association's count), including the
  // return type of a method or generated getter called on a receiver; null when unknown.
  private String declaredType(ConstraintVariable v, PythonConstraintScope context)
  {
    ConstraintVariable inner = unwrap(v);
    if (isLength(inner, context) || isCall(inner) && isLength(((ConstraintOperator) inner).getLeft(), context))
    {
      return "int";
    }
    Object[] foreign = foreignMember(inner, context);
    if (foreign != null)
    {
      List<String> names = (List<String>) foreign[1];
      return names.size() == 1 ? constantType((UmpleClassifier) foreign[0], names.get(0)) : null;
    }
    ConstraintVariable member = thisMember(inner);
    ConstraintVariable qualified = inner instanceof ConstraintOperator && ".".equals(((ConstraintOperator) inner).getValue())
      && unwrap(((ConstraintOperator) inner).getLeft()) instanceof ConstraintUnassignedName
      && inherits(context.getUClass(), ((ConstraintUnassignedName) unwrap(((ConstraintOperator) inner).getLeft())).getValue())
      ? unwrap(((ConstraintOperator) inner).getRight()) : null;
    if (member == null && qualified instanceof ConstraintUnassignedName)
    {
      member = qualified; // Owner.CONSTANT, typed as the constant the class sees
    }
    if (member != null)
    {
      // this.x: the member itself, which the parser leaves unresolved when it is inherited
      ConstraintVariable resolved = member instanceof ConstraintUnassignedName
        ? inheritedMember(context.getUClass(), ((ConstraintUnassignedName) member).getValue()) : member;
      Constant constant = member instanceof ConstraintUnassignedName
        ? interfaceConstant(context.getUClass(), ((ConstraintUnassignedName) member).getValue()) : null;
      return resolved != null ? declaredType(resolved, context) : constant != null ? constant.getType() : null;
    }
    if (inner instanceof ConstraintAttribute)
    {
      ConstraintAttribute value = (ConstraintAttribute) inner;
      Attribute attribute = value.getAttribute();
      return attribute.getType() + (attribute.getIsList() && value.getIndex() == -1 ? "[]" : "");
    }
    if (inner instanceof ConstraintAssociation)
    {
      ConstraintAssociation association = (ConstraintAssociation) inner;
      AssociationVariable variable = association.getAssociation();
      return association.getNumberOf() ? "Integer" : variable.getType()
        + (association.getIndex() == -1 && variable.getMultiplicity().getUpperBound() != 1 ? "[]" : "");
    }
    if (inner instanceof ConstraintMethodParameter)
    {
      MethodParameter parameter = ((ConstraintMethodParameter) inner).getParameter();
      return parameter.getType() + (parameter.getIsList() ? "[]" : "");
    }
    if (inner instanceof ConstraintLiteral)
    {
      String value = ((ConstraintLiteral) inner).getValue();
      return value.startsWith("\"") ? "String" : value.startsWith("'") ? "char"
        : "true".equals(value) || "false".equals(value) ? "boolean"
        : value.matches("-?[0-9]+") ? "int"
        : value.matches("-?[0-9]+\\.[0-9]+") ? "double" : null;
    }
    if (inner instanceof ConstraintUnassignedName)
    {
      String name = ((ConstraintUnassignedName) inner).getValue();
      if (context.getParameters().containsKey(name))
      {
        MethodParameter parameter = context.getParameters().get(name);
        return parameter.getType() + (parameter.getIsList() ? "[]" : "");
      }
      ConstraintVariable inherited = inheritedMember(context.getUClass(), name);
      Constant constant = interfaceConstant(context.getUClass(), name);
      return "this".equals(name) ? context.getUClass().getName() : inherited != null ? declaredType(inherited, context)
        : constant != null ? constant.getType() : "true".equals(name) || "false".equals(name) ? "boolean" : null;
    }
    if (!isCall(inner))
    {
      return null;
    }
    ConstraintVariable callee = unwrap(((ConstraintOperator) inner).getLeft());
    List<ConstraintVariable> arguments = new ArrayList<ConstraintVariable>();
    callArguments(((ConstraintOperator) inner).getRight(), arguments);
    if (callee instanceof ConstraintUnassignedName)
    {
      return returnType(context.getUClass(), ((ConstraintUnassignedName) callee).getValue(), arguments, context);
    }
    if (callee instanceof ConstraintOperator && ".".equals(((ConstraintOperator) callee).getValue())
      && unwrap(((ConstraintOperator) callee).getRight()) instanceof ConstraintUnassignedName)
    {
      String receiver = declaredType(((ConstraintOperator) callee).getLeft(), context);
      UmpleClassifier owner = receiver == null ? null : getModel().getUmpleClass(receiver);
      if (owner == null && receiver != null)
      {
        owner = getModel().getUmpleInterface(receiver);
      }
      return owner == null ? null
        : returnType(owner, ((ConstraintUnassignedName) unwrap(((ConstraintOperator) callee).getRight())).getValue(), arguments, context);
    }
    return null;
  }

  private static void callArguments(ConstraintVariable v, List<ConstraintVariable> arguments)
  {
    ConstraintVariable inner = unwrap(v);
    if (inner instanceof ConstraintOperator && ",".equals(((ConstraintOperator) inner).getValue()))
    {
      callArguments(((ConstraintOperator) inner).getLeft(), arguments);
      callArguments(((ConstraintOperator) inner).getRight(), arguments);
    }
    else if (!(inner instanceof ConstraintUnassignedName) || !((ConstraintUnassignedName) inner).getValue().isEmpty())
    {
      arguments.add(v);
    }
  }

  // Resolve arity first, then the declared argument types. An unresolved earlier candidate could be
  // the dispatcher's first match, so it must not lend an arbitrary return type to arithmetic.
  private String returnType(UmpleClassifier owner, String name, List<ConstraintVariable> arguments, PythonConstraintScope context)
  {
    String association = associationGetterType(owner, name, arguments.size());
    if (association != null)
    {
      return association;
    }
    Map<String, Method> signatures = new LinkedHashMap<String, Method>();
    collectConstraintMethods(owner, name, signatures, new HashSet<UmpleClassifier>());
    List<Method> candidates = new ArrayList<Method>();
    for (Method method : signatures.values())
    {
      int count = method.numberOfMethodParameters();
      boolean varargs = count > 0 && method.getMethodParameter(count - 1).getType().endsWith("...");
      if (varargs ? arguments.size() >= count - 1 : arguments.size() == count)
      {
        candidates.add(method);
      }
    }
    if (candidates.size() == 1)
    {
      return candidates.get(0).getType();
    }
    // Bulk attribute getters are generated without a model method signature.
    if (candidates.isEmpty() && arguments.isEmpty() && owner instanceof UmpleClass)
    {
      for (UmpleClass c = (UmpleClass) owner; c != null; c = c.getExtendsClass())
      {
        for (Attribute attribute : c.getAttributes())
        {
          if (attribute.getIsList() && name.equals(translate("getManyMethod", attribute)))
          {
            return attribute.getType() + "[]";
          }
        }
      }
    }
    String common = null;
    for (Method method : candidates)
    {
      boolean possible = true;
      boolean certain = true;
      for (int i = 0; i < arguments.size(); i++)
      {
        MethodParameter parameter = method.getMethodParameter(Math.min(i, method.numberOfMethodParameters() - 1));
        String type = parameter.getType().replace("...", "") + (parameter.getIsList() ? "[]" : "");
        Boolean match = constraintArgumentMatches(arguments.get(i), type, context);
        possible &= !Boolean.FALSE.equals(match);
        certain &= Boolean.TRUE.equals(match);
      }
      if (possible)
      {
        // Mixed integral returns still require truncating division even without a known width.
        if (common != null && !common.equals(method.getType()))
        {
          if (!isIntegralType(common) || !isIntegralType(method.getType()))
          {
            return null;
          }
          common = "integral";
        }
        else
        {
          common = method.getType();
        }
        if (certain)
        {
          break;
        }
      }
    }
    return common;
  }

  // The type a generated association getter of owner returns, taken from the association end: the
  // front end's method list gives a reflexive association's one end an array type. null when name
  // with that many arguments is no such getter.
  private String associationGetterType(UmpleClassifier owner, String name, int arguments)
  {
    for (UmpleClass c = owner instanceof UmpleClass ? (UmpleClass) owner : null; c != null; c = c.getExtendsClass())
    {
      for (AssociationVariable av : c.getAssociationVariables())
      {
        boolean one = av.getMultiplicity().getUpperBound() == 1;
        if (av.getIsNavigable() && arguments == 0 && name.equals(translate(one ? "getMethod" : "getManyMethod", av)))
        {
          return av.getType() + (one ? "" : "[]");
        }
        if (av.getIsNavigable() && arguments == 1 && !one && name.equals(translate("getMethod", av)))
        {
          return av.getType();
        }
      }
    }
    return null;
  }

  // Keep the nearest declaration of each signature, including methods inherited by interfaces.
  private static void collectConstraintMethods(UmpleClassifier owner, String name, Map<String, Method> signatures, Set<UmpleClassifier> seen)
  {
    if (owner == null || !seen.add(owner))
    {
      return;
    }
    for (Method method : owner.getMethods())
    {
      if (method.getName().equals(name) && !method.getIsConstructor())
      {
        String signature = "";
        for (MethodParameter parameter : method.getMethodParameters())
        {
          signature += parameter.getType() + (parameter.getIsList() ? "[]" : "") + ",";
        }
        if (!signatures.containsKey(signature))
        {
          signatures.put(signature, method);
        }
      }
    }
    if (owner instanceof UmpleClass)
    {
      collectConstraintMethods(((UmpleClass) owner).getExtendsClass(), name, signatures, seen);
    }
    List<UmpleInterface> parents = owner instanceof UmpleClass ? ((UmpleClass) owner).getParentInterface() : ((UmpleInterface) owner).getExtendsInterface();
    for (UmpleInterface parent : parents)
    {
      collectConstraintMethods(parent, name, signatures, seen);
    }
  }

  // Unknown types stay unknown. Numeric and text families follow the generated dispatcher's tests.
  private Boolean constraintArgumentMatches(ConstraintVariable value, String parameter, PythonConstraintScope context)
  {
    String argument = declaredType(value, context);
    if (argument == null)
    {
      return null;
    }
    String actual = constraintTypeFamily(argument);
    String expected = constraintTypeFamily(parameter);
    if (actual.equals(expected) || "int".equals(actual) && "float".equals(expected))
    {
      return true;
    }
    List<String> values = Arrays.asList("int", "float", "bool", "str");
    boolean knownActual = values.contains(actual) || argument.endsWith("[]") || isModelType(argument);
    boolean knownExpected = values.contains(expected) || parameter.endsWith("[]") || isModelType(parameter);
    // A text literal cannot take the null branch of a reference overload.
    if ("str".equals(actual) && knownExpected && unwrap(value) instanceof ConstraintLiteral)
    {
      return false;
    }
    // Primitive arguments cannot match a model or array parameter, and reference arguments cannot
    // match a primitive parameter. Distinct reference types may still overlap at null or a subtype.
    return knownActual && knownExpected && (values.contains(actual) && values.contains(expected)
      || Arrays.asList("int", "float", "bool").contains(actual) || Arrays.asList("int", "float", "bool").contains(expected)) ? Boolean.FALSE : null;
  }

  private static String constraintTypeFamily(String type)
  {
    return isIntegralType(type) ? "int"
      : Arrays.asList("double", "Double", "float", "Float").contains(type) ? "float"
      : Arrays.asList("boolean", "Boolean").contains(type) ? "bool"
      : Arrays.asList("String", "char", "Character").contains(type) ? "str" : type;
  }

  private boolean isModelType(String type)
  {
    return type != null && (getModel().getUmpleClass(type) != null || getModel().getUmpleInterface(type) != null);
  }

  private static final List<String> INTEGRAL_TYPES = Arrays.asList("Integer", "int", "long", "short", "byte", "Long", "Short", "Byte");

  private static boolean isIntegralType(String type)
  {
    return INTEGRAL_TYPES.contains(type) || "integral".equals(type);
  }

  // Shifts use unary promotion on the left; other arithmetic promotes both operands. A call whose
  // reachable overloads disagree on the return type must not acquire an arbitrary int mask.
  private String shiftType(ConstraintVariable v, PythonConstraintScope context)
  {
    ConstraintVariable inner = unwrap(v);
    if (inner instanceof ConstraintOperator)
    {
      ConstraintOperator op = (ConstraintOperator) inner;
      if (Arrays.asList("+", "-", "*", "/", "%", "^", "<<", ">>").contains(op.getValue()))
      {
        String left = shiftType(op.getLeft(), context);
        if (op.numberOfSubConstraints() == 1 || "<<".equals(op.getValue()) || ">>".equals(op.getValue()))
        {
          return left;
        }
        String right = shiftType(op.getRight(), context);
        // A known long operand fixes binary promotion even when the other integral width is unknown.
        return "long".equals(left) || "long".equals(right) ? "long" : left == null || right == null ? null : "int";
      }
    }
    String type = declaredType(inner, context);
    return "long".equals(type) || "Long".equals(type) ? "long" : INTEGRAL_TYPES.contains(type) ? "int" : null;
  }

  // Integers in Java: integer literals, arithmetic on integers, a String's or an array's length, and
  // values the model declares with an integral type.
  private boolean isIntegral(ConstraintVariable v, PythonConstraintScope context)
  {
    ConstraintVariable inner = unwrap(v);
    if (inner instanceof ConstraintLiteral)
    {
      return ((ConstraintLiteral) inner).getValue().matches("-?[0-9]+");
    }
    if (inner instanceof ConstraintOperator && Arrays.asList("+", "-", "*", "/", "%").contains(((ConstraintOperator) inner).getValue()))
    {
      ConstraintOperator op = (ConstraintOperator) inner;
      return op.getLeft() != null && isIntegral(op.getLeft(), context) && (op.getRight() == null || isIntegral(op.getRight(), context));
    }
    String type = declaredType(inner, context);
    return type != null ? isIntegralType(type) : isLength(inner, context) || isCall(inner) && isLength(((ConstraintOperator) inner).getLeft(), context);
  }

  // Numbers take Java's value, so 07, -07, 0x10 and 10L are Python numbers too; 08 is no Java number
  private String literalValue(String value)
  {
    if (PythonSnippetTranslator.isJavaNumber(value.startsWith("-") ? value.substring(1) : value))
    {
      String number = literal("", value);
      if (number == null)
      {
        throw new PythonSnippetException("A constraint using the number " + value, null);
      }
      return number;
    }
    return "true".equals(value) ? "True" : "false".equals(value) ? "False" : "null".equals(value) ? "None" : value;
  }

  // The class is then not generated: error 9210 names the part of the constraint.
  private static RuntimeException unsupportedConstraint(ConstraintVariable v)
  {
    String operator = v instanceof ConstraintOperator ? ((ConstraintOperator) v).getValue() : null;
    String part = operator == null ? v.getClass().getSimpleName()
      : "in==".equals(operator) || "in!=".equals(operator) ? "the state test is in state" : "the operator " + operator;
    return new PythonSnippetException("A constraint using " + part, null);
  }

  //------------------------
  // Injections
  //------------------------

  // The before or after injections that apply to a generated method, as Python statements at indent,
  // in model order; "" when none apply. Python-tagged injections are native code; untagged ones go
  // through the snippet translator with the method's parameters in scope.
  public String injections(UmpleClass uClass, String type, String methodName, List<MethodParameter> parameters, boolean isStatic, String indent)
  {
    return injectionCode(uClass, uClass.getApplicableCodeInjections(type, methodName), type + " injection of " + methodName, parameters, isStatic, indent);
  }

  private String injectionCode(UmpleClass uClass, List<CodeInjection> injections, String slot, List<MethodParameter> parameters, boolean isStatic, String indent)
  {
    StringBuilder code = new StringBuilder();
    for (CodeInjection injection : injections)
    {
      if (!injection.getIsInternal() && !injection.hasCodeLabel())
      {
        code.append(slotCode(injection.getSnippet(), uClass, parameters, isStatic, indent, slot, injection.getPosition()));
      }
    }
    return code.toString();
  }

  // A code slot's statements at indent: its Python body, else its untagged body translated, else "".
  // slot names it in diagnostics, reported at position (the class's when null).
  public String slotCode(CodeBlock code, UmpleClass uClass, List<MethodParameter> parameters, boolean isStatic, String indent, String slot,
    Position position)
  {
    String language = pythonLanguage(code);
    Position at = position != null ? position : (uClass.numberOfPositions() > 0 ? uClass.getPosition(0) : null);
    if (language == null && !taggedLanguages(code).isEmpty())
    {
      // Behaviour written only for other languages is left out, which the user must hear about
      errorAt(9212, at, Character.toUpperCase(slot.charAt(0)) + slot.substring(1), String.join(", ", taggedLanguages(code)));
    }
    if (language == null || code.getCode(language).trim().isEmpty())
    {
      return "";
    }
    if ("Python".equals(language))
    {
      // a guarded trait action composed with superCall: its guard, untagged code, becomes the condition
      // of the if around its lines (CodeBlock.pythonTraitGuards)
      String python = code.getCode(language);
      StringBuilder imports = new StringBuilder();
      for (Map.Entry<String, String> guard : code.getPythonTraitGuards().entrySet())
      {
        if (PythonSource.codePositions(python, guard.getKey()).isEmpty())
        {
          continue;
        }
        String condition = translateSnippetAt(guard.getValue(), uClass, parameters, isStatic, true, at, "the guard of " + slot);
        if (condition == null)
        {
          return "";
        }
        python = PythonSource.replaceCode(python, guard.getKey(), condition);
        for (String line : getSnippetImports())
        {
          imports.append("\n").append(indent).append(line);
        }
      }
      // trait code without a Python version, composed with superCall, is rendered as its own slot at
      // each line that holds its placeholder
      for (Map.Entry<String, CodeBlock> part : code.getPythonTraitBlocks().entrySet())
      {
        List<Integer> found = PythonSource.codePositions(python, part.getKey());
        String body = found.isEmpty() ? "" : slotCode(part.getValue(), uClass, parameters, isStatic, "", slot, at);
        for (int k = found.size() - 1; k >= 0; k--)
        {
          int lineStart = python.lastIndexOf('\n', found.get(k)) + 1;
          String lineIndent = python.substring(lineStart, found.get(k));
          python = python.substring(0, lineStart) + (body.isEmpty() ? lineIndent + "pass" : PythonSource.reindent(body, "", lineIndent).substring(1))
            + python.substring(found.get(k) + part.getKey().length());
        }
      }
      return imports + functionCode(python, code.getFirstLineIndent(language), indent, code.getAuthoredPosition(language), uClass);
    }
    String translated = translateSnippetAt(code.getCode(language), uClass, parameters, isStatic, false, at, slot);
    if (translated != null && slot.startsWith("the action of the transition") && Pattern.compile("(?m)^\\s*return\\s*$").matcher(translated).find())
    {
      // The event returns whether it was processed; Java does not compile a return without that value
      reportSnippetError(at, slot, "a return without a value leaves the event without its result");
      return "";
    }
    return translated == null ? "" : PythonSource.reindent(translated, "", indent);
  }

  //------------------------
  // User methods
  //------------------------

  public static boolean isStatic(Method method)
  {
    return method.getModifier().contains("static");
  }

  // The parameters of a user method in its def line and in calls: self first unless it is static,
  // varargs as *name.
  public String methodParameters(Method method)
  {
    List<String> names = new ArrayList<String>();
    if (!isStatic(method))
    {
      names.add("self");
    }
    for (MethodParameter p : method.getMethodParameters())
    {
      names.add((p.getType().endsWith("...") ? "*" : "") + parameterName(p.getName()));
    }
    return String.join(", ", names);
  }

  private static List<String> parameterNames(Method method)
  {
    List<String> names = new ArrayList<String>();
    for (MethodParameter p : method.getMethodParameters())
    {
      names.add(parameterName(p.getName()));
    }
    return names;
  }

  // The contracts of the method body Python uses, in model order: the front end records the body
  // block each condition was written in.
  public List<ConstraintTree> contracts(UmpleClass uClass, Method method, boolean pre)
  {
    return pre ? new ArrayList<ConstraintTree>(uClass.getMethodPreconditions(method, "Python"))
      : new ArrayList<ConstraintTree>(uClass.getMethodPostconditions(method, "Python"));
  }

  // A user method under name (its own, or its number in an overload group). A queued one, as in Java,
  // only puts a call to the method doing its work in the object's method queue.
  public String userMethod(UmpleClass uClass, Method method, String name)
  {
    if (!method.getIsQueued())
    {
      return methodWithBody(uClass, method, name);
    }
    String worker = queuedName(uClass, name);
    return methodWithBody(uClass, method, worker)
      + emitted(uClass, method, enqueuer(name, worker, methodQueue(uClass), method.getMethodParameters(), false));
  }

  // Preconditions and before injections run in the method, ahead of its body, as Java's do. With after
  // injections or postconditions, or a generator body (which runs only once iterated), the method
  // wraps a helper holding the body, called through the declaring class so that a super() call never
  // reaches a subclass's helper. A synchronized method holds its monitor for all of it, contracts and
  // injections included, as Java's does.
  private String methodWithBody(UmpleClass uClass, Method method, String name)
  {
    boolean isStatic = isStatic(method);
    String language = pythonLanguage(method);
    String decorator = isStatic ? "\n    @staticmethod" : "";
    String header = "\n" + decorator + "\n    def " + name + "(" + methodParameters(method) + "):";
    String docstring = docstring(method.getComments(), method.getReqImplementations(), "        ");
    String lock = isSynchronized(method) ? "\n        with " + monitor(uClass, isStatic) + ":" : "";
    String indent = isSynchronized(method) ? "            " : "        ";
    List<MethodParameter> scope = method.getMethodParameters();
    StringBuilder before = new StringBuilder();
    for (ConstraintTree pre : contracts(uClass, method, true))
    {
      before.append(contractCheck(pre, uClass, scope, isStatic, indent));
    }
    before.append(injectionCode(uClass, uClass.getApplicableCodeInjectionsCustomMethod("before", method.getName(), scope),
      "before injection of " + method.getName(), scope, isStatic, indent));
    StringBuilder after = new StringBuilder(injectionCode(uClass, uClass.getApplicableCodeInjectionsCustomMethod("after", method.getName(), scope),
      "after injection of " + method.getName(), scope, isStatic, indent));
    for (ConstraintTree post : contracts(uClass, method, false))
    {
      after.append(contractCheck(post, uClass, postconditionScope(uClass, method), isStatic, indent));
    }
    // The parser keeps the body without its first line's indentation and records that separately.
    CodeBlock block = method.getMethodBody().getCodeblock();
    boolean wrapped = after.length() > 0 || before.length() > 0 && PythonSource.isGenerator(block.getCode(language));
    String body = functionCode(block.getCode(language), block.getFirstLineIndent(language), wrapped ? "        " : indent,
      block.getAuthoredPosition(language), uClass);
    if (!wrapped)
    {
      return emitted(uClass, method, header + docstring + lock + before + body);
    }
    String helper = freshMemberName(uClass, name + "_Original");
    // Postconditions name the returned value result; the local gets underscores while a parameter has its name.
    String result = "result";
    while (parameterNames(method).contains(result))
    {
      result += "_";
    }
    return emitted(uClass, method, header + docstring + lock + before
      + "\n" + indent + result + " = " + DECLARING_CLASS + "." + helper + "(" + methodParameters(method) + ")"
      + after
      + "\n" + indent + "return " + result
      + "\n" + decorator + "\n    def " + helper + "(" + methodParameters(method) + "):" + body);
  }

  // Records the text of a method written in the model as it is emitted, so that mergeSameNameMethods
  // types its definition from the method itself; returns the text.
  public String emitted(UmpleClass uClass, Method method, String text)
  {
    return emitted(uClass, method.getMethodParameters(), text);
  }

  public String emitted(UmpleClass uClass, List<MethodParameter> parameters, String text)
  {
    if (!emittedMethods.containsKey(uClass.getName()))
    {
      emittedMethods.put(uClass.getName(), new LinkedHashMap<String, List<MethodParameter>>());
    }
    // found again in the class text, whose lines mergeSameNameMethods ends with "\n"
    emittedMethods.get(uClass.getName()).put(text.replace("\r\n", "\n"), parameters);
    return text;
  }

  // The names a postcondition sees: the method's parameters, and result, the returned value, which the
  // method wrapper keeps in a local of that name, unless a parameter has that name or, as in Java, a
  // member of the class does.
  public List<MethodParameter> postconditionScope(UmpleClass uClass, Method method)
  {
    List<MethodParameter> scope = new ArrayList<MethodParameter>(method.getMethodParameters());
    if (!parameterNames(method).contains("result") && inheritedMember(uClass, "result") == null)
    {
      scope.add(parameter("result", method.getType()));
    }
    return scope;
  }

  private String contractCheck(ConstraintTree constraint, UmpleClass uClass, List<MethodParameter> parameters, boolean isStatic,
    String indent)
  {
    return conditionCheck(constraint, uClass, parameters, isStatic, null, indent)
      + "\n" + indent + "    raise RuntimeError(" + contractMessage(constraint) + ")";
  }

  public static boolean isSynchronized(Method method)
  {
    return method.getModifier().contains("synchronized");
  }

  // The lock a synchronized method holds: the object's, which its whole class hierarchy shares as it
  // shares Java's monitor, or for a static method its declaring class's.
  private String monitor(UmpleClass uClass, boolean isStatic)
  {
    return isStatic ? DECLARING_CLASS + "." + classMonitor(uClass) : "self." + objectMonitor(uClass);
  }

  // Named from the hierarchy's root, so that every class in it gets the same name
  private String objectMonitor(UmpleClass uClass)
  {
    UmpleClass root = uClass;
    while (root.getExtendsClass() != null)
    {
      root = root.getExtendsClass();
    }
    return fieldName(root, "monitor");
  }

  // The object monitor uClass's constructor creates, or null: the topmost class with synchronized
  // methods creates it
  public String createdMonitor(UmpleClass uClass)
  {
    for (UmpleClass c = uClass.getExtendsClass(); c != null; c = c.getExtendsClass())
    {
      if (hasSynchronized(c, false))
      {
        return null;
      }
    }
    return hasSynchronized(uClass, false) ? objectMonitor(uClass) : null;
  }

  // The class attribute holding the lock of uClass's static synchronized methods, or null
  public String classMonitor(UmpleClass uClass)
  {
    return hasSynchronized(uClass, true) ? freshMemberName(uClass, "_classMonitor") : null;
  }

  private static boolean hasSynchronized(UmpleClass uClass, boolean isStatic)
  {
    List<Method> methods = new ArrayList<Method>(uClass.getMethods());
    methods.addAll(uClass.getStateDependentMethods());
    for (Method m : methods)
    {
      if (isSynchronized(m) && isStatic(m) == isStatic)
      {
        return true;
      }
    }
    return false;
  }

  // An abstract method: an abstract stub. One in an overload group is a plain stub, because a
  // subclass implements the group by its name, so the group's dispatcher is what is abstract.
  public String abstractMethod(Method method, String name, boolean inGroup)
  {
    return "\n\n" + (inGroup ? "" : "    @" + standardName("abc", "abstractmethod") + "\n") + "    def " + name + "(" + methodParameters(method) + "):"
      + docstring(method.getComments(), method.getReqImplementations(), "        ") + "\n        pass";
  }

  // The dispatcher text of an overload group with an abstract member, made abstract. The recorded
  // dispatcher becomes this text, so mergeSameNameMethods still finds it.
  public String abstractDispatcher(String dispatcher)
  {
    String decorated = "\n\n    @" + standardName("abc", "abstractmethod") + "\n" + dispatcher.substring(2);
    for (List<String> texts : dispatcherTexts.values())
    {
      texts.replaceAll(text -> text.equals(dispatcher) ? decorated : text);
    }
    if (dispatcherImplementations.containsKey(dispatcher))
    {
      dispatcherImplementations.put(decorated, dispatcherImplementations.remove(dispatcher));
      dispatcherParameters.put(decorated, dispatcherParameters.remove(dispatcher));
    }
    return decorated;
  }

  // The stub a class gets for an interface method it does not implement, returning the value Java's
  // stub returns.
  public String interfaceStub(Method method, String name)
  {
    String value;
    switch (method.getType())
    {
      case "void": value = null; break;
      case "String": value = "\"\""; break;
      case "int": case "double": case "float": value = "0"; break;
      case "boolean": value = "False"; break;
      default: value = "None";
    }
    return "\n\n    def " + name + "(" + methodParameters(method) + "):" + (value == null ? "\n        pass" : "\n        return " + value);
  }

  //------------------------
  // Extra code and main
  //------------------------

  // The parser's marker in Java form (the file quoted or not) or in Python form (always quoted).
  private static final Pattern EXTRA_CODE_MARKER = Pattern.compile("\\s*(?:// line (\\d+) \"?([^\"]*?)\"?|# line (\\d+) \"([^\"]*)\")\\s*");

  // The class's extra code, native Python, at member indentation with one source region per piece.
  // The parser marks each piece with a line comment in Java (//) or Python (#) form.
  public String classExtraCode(UmpleClass uClass)
  {
    String text = uClass.getExtraCode();
    String[] lines = (text == null ? "" : text).replace("\r\n", "\n").split("\n", -1);
    boolean[] insideString = PythonSource.linesInsideStrings(Arrays.asList(lines));
    StringBuilder out = new StringBuilder();
    StringBuilder piece = new StringBuilder();
    Position position = null;
    for (int n = 0; n < lines.length; n++)
    {
      String line = lines[n];
      Matcher marker = EXTRA_CODE_MARKER.matcher(line);
      if (!insideString[n] && marker.matches())
      {
        out.append(extraCodePiece(piece.toString(), position, uClass));
        piece.setLength(0);
        boolean javaForm = marker.group(1) != null;
        position = new Position(marker.group(javaForm ? 2 : 4), Integer.parseInt(marker.group(javaForm ? 1 : 3)), 0, 0);
      }
      else
      {
        piece.append(line).append("\n");
      }
    }
    return out.append(extraCodePiece(piece.toString(), position, uClass)).toString();
  }

  // The parser keeps a piece without the indentation of its first line, which is worked out from the
  // lines after it.
  private String extraCodePiece(String code, Position position, UmpleClass uClass)
  {
    return code.trim().isEmpty() ? "" : "\n" + nativeCode(code.replaceFirst("^[ \t\f]+", ""), null, "    ", position, uClass);
  }

  // Runs a top-level class's Python main with the full sys.argv.
  public String mainLauncher(UmpleClass uClass)
  {
    return hasPythonMain(uClass)
      ? "\n\n\nif __name__ == \"__main__\":\n    " + uClass.getName() + ".main(" + standardName("sys", null) + ".argv)" : "";
  }

  // The first lines of a module whose class has a Python main: run as a program, the module registers
  // itself under its model name before its imports and class body run, so that a module importing
  // that name gets this one, and one class, rather than a second copy.
  public List<String> mainRegistration(UmpleClassifier classifier)
  {
    if (!(classifier instanceof UmpleClass) || !hasPythonMain((UmpleClass) classifier))
    {
      return new ArrayList<String>();
    }
    UmpleClass uClass = (UmpleClass) classifier;
    String sys = standardAlias("sys");
    String module = uClass.getPackageName().isEmpty() ? uClass.getName() : uClass.getPackageName() + "." + uClass.getName();
    return Arrays.asList(standardImport("sys", null, sys), "if __name__ == \"__main__\":",
      "    " + sys + ".modules.setdefault(\"" + module + "\", " + sys + ".modules[__name__])");
  }

  private static boolean hasPythonMain(UmpleClass uClass)
  {
    for (Method m : uClass.getOuterClass() == null ? uClass.getMethods() : new ArrayList<Method>())
    {
      if (isPythonMain(m))
      {
        return true;
      }
    }
    return false;
  }

  //------------------------
  // Overload dispatch
  //------------------------

  // Whether an ancestor of uClass has a method of this name: written in the model, or generated for
  // its members and events
  private boolean ancestorHas(UmpleClass uClass, String name)
  {
    for (UmpleClass k = uClass.getExtendsClass(); k != null; k = k.getExtendsClass())
    {
      if (!inheritedSignatures(k, name).isEmpty() || PythonSnippetTranslator.forClass(this, k, null, false).generates(k, name))
      {
        return true;
      }
    }
    return false;
  }

  // Whether a lone method of the model needs a dispatcher: an inherited method of its name that it does
  // not override stays callable, or an ancestor generates a method of its name
  private boolean overloadsInherited(UmpleClass uClass, String name, List<MethodParameter> parameters)
  {
    if (!inheritedCandidates(uClass, name, Arrays.asList(parameters)).isEmpty())
    {
      return true;
    }
    for (UmpleClass k = uClass.getExtendsClass(); k != null; k = k.getExtendsClass())
    {
      if (PythonSnippetTranslator.forClass(this, k, null, false).generates(k, name))
      {
        return true;
      }
    }
    return false;
  }

  // The signatures of the instance methods of the model named name that uClass inherits and the local
  // candidates do not override, nearest ancestor first: Java resolves a call among them and the class's
  // own, so the dispatcher ranks them together
  private List<List<MethodParameter>> inheritedCandidates(UmpleClass uClass, String name, List<List<MethodParameter>> local)
  {
    List<List<MethodParameter>> seen = new ArrayList<List<MethodParameter>>(local);
    List<List<MethodParameter>> inherited = new ArrayList<List<MethodParameter>>();
    for (UmpleClass k = uClass.getExtendsClass(); k != null; k = k.getExtendsClass())
    {
      for (List<MethodParameter> signature : inheritedSignatures(k, name))
      {
        boolean overridden = false;
        for (List<MethodParameter> other : seen)
        {
          overridden = overridden || sameSignature(signature, other);
        }
        if (!overridden)
        {
          inherited.add(signature);
        }
        seen.add(signature);
      }
    }
    return inherited;
  }

  // The parameters of the instance methods and events named name that class k declares for Python
  private List<List<MethodParameter>> inheritedSignatures(UmpleClass k, String name)
  {
    List<List<MethodParameter>> signatures = new ArrayList<List<MethodParameter>>();
    List<Method> methods = new ArrayList<Method>(k.getMethods());
    methods.addAll(k.getStateDependentMethods());
    for (Method m : methods)
    {
      if (name.equals(m.getName()) && pythonLanguage(m) != null && !isStatic(m))
      {
        signatures.add(m.getMethodParameters());
      }
    }
    for (Event e : k.getEvents())
    {
      if (!e.isUnspecified() && name.equals(translate("eventMethod", e)))
      {
        signatures.add(e.getParams());
      }
    }
    return signatures;
  }

  // Whether one signature overrides the other: the same parameters as Python sees them, as many, a
  // variable one in the same place, and of the same types (int and Integer are one)
  private static boolean sameSignature(List<MethodParameter> a, List<MethodParameter> b)
  {
    boolean same = a.size() == b.size() && isVarargs(a) == isVarargs(b);
    for (int k = 0; same && k < a.size(); k++)
    {
      same = boxed(typeAt(a, k)).equals(boxed(typeAt(b, k)));
    }
    return same;
  }

  private static int lineAt(String text, int index)
  {
    int line = 0;
    for (int i = text.indexOf('\n'); i >= 0 && i < index; i = text.indexOf('\n', i + 1))
    {
      line++;
    }
    return line;
  }

  // Joins generated and model methods Python would define twice in one class (an event and its
  // setter, a generated getter and user overloads of it) into one dispatcher, as Java keeps them as
  // overloads. Candidates differ by argument count or a known parameter type; of two that do not,
  // one redefines the other. Definitions inside strings are ignored. code is the class up to its
  // extra code, whose native definitions are left alone.
  public void mergeSameNameMethods(UmpleClass uClass, StringBuilder code)
  {
    unixLines(code);
    String text = code.toString();
    boolean[] insideString = PythonSource.linesInsideStrings(Arrays.asList(text.split("\n", -1)));
    Map<String, List<Integer>> starts = new LinkedHashMap<String, List<Integer>>();
    Map<String, List<List<MethodParameter>>> signatures = new HashMap<String, List<List<MethodParameter>>>();
    Map<String, Set<Boolean>> instanceKinds = new HashMap<String, Set<Boolean>>();
    Set<String> taken = new HashSet<String>(modelledNames(uClass));
    // The definitions of methods written in the model, by the position of their name, with their parameters
    Map<Integer, List<MethodParameter>> written = new HashMap<Integer, List<MethodParameter>>();
    Set<String> writtenNames = new HashSet<String>();
    Map<String, List<MethodParameter>> emittedHere = emittedMethods.containsKey(uClass.getName())
      ? emittedMethods.get(uClass.getName()) : new HashMap<String, List<MethodParameter>>();
    for (Map.Entry<String, List<MethodParameter>> method : emittedHere.entrySet())
    {
      // The method itself, not a copy of its text in a string of another method
      for (int at = text.indexOf(method.getKey()); at >= 0; at = text.indexOf(method.getKey(), at + 1))
      {
        int definition = text.indexOf("    def ", at);
        if (definition >= 0 && !insideString[lineAt(text, definition)])
        {
          written.put(definition + "    def ".length(), method.getValue());
          break;
        }
      }
    }
    Matcher def = Pattern.compile("(?m)^    def (\\w+)\\(([^)]*)\\):$").matcher(text);
    int line = 0;
    int counted = 0;
    while (def.find())
    {
      for (; counted < def.start(); counted++)
      {
        line += text.charAt(counted) == '\n' ? 1 : 0;
      }
      if (insideString[line])
      {
        continue;
      }
      String name = def.group(1);
      taken.add(name);
      if (written.containsKey(def.start(1)))
      {
        writtenNames.add(name);
      }
      List<String> names = new ArrayList<String>(Arrays.asList(def.group(2).split(",\\s*")));
      String first = names.get(0);
      boolean isInstance = "self".equals(first);
      // A class method (fixml's alternate constructor) is not dispatched
      int previousLine = text.lastIndexOf('\n', def.start() - 2) + 1;
      boolean classMethod = def.start() > 0 && "@classmethod".equals(text.substring(previousLine, def.start() - 1).trim());
      if (isInstance || first.isEmpty() || classMethod)
      {
        names.remove(0);
      }
      List<MethodParameter> signature = classMethod ? null : new ArrayList<MethodParameter>();
      for (int i = 0; signature != null && i < names.size(); i++)
      {
        String parameterName = names.get(i);
        // Defaults and keyword collectors (a dispatcher's own **kwargs) do not bind by name and count
        signature = parameterName.contains("=") || parameterName.startsWith("**") ? null : signature;
        if (signature != null)
        {
          signature.add(parameter(parameterName.replace("*", ""), parameterName.startsWith("*") ? UNKNOWN_TYPE + "..." : UNKNOWN_TYPE));
        }
      }
      List<MethodParameter> declared = signature == null ? null
        : written.containsKey(def.start(1)) ? written.get(def.start(1)) : generatedParameters(uClass, name, names);
      signature = declared != null ? declared : signature;
      if (!starts.containsKey(name))
      {
        starts.put(name, new ArrayList<Integer>());
        signatures.put(name, new ArrayList<List<MethodParameter>>());
      }
      starts.get(name).add(def.start(1));
      signatures.get(name).add(signature);
      if (!instanceKinds.containsKey(name))
      {
        instanceKinds.put(name, new HashSet<Boolean>());
      }
      instanceKinds.get(name).add(isInstance);
    }
    for (String name : instanceKinds.keySet())
    {
      if (instanceKinds.get(name).size() > 1)
      {
        // One Python name cannot be a static and an instance method; the later would replace the other.
        // checkUserCode reports two such methods written in the model; this is one beside a generated one.
        error(9210, uClass, "The method " + name + ", static in one definition and not in another,", uClass.getName());
      }
    }
    TreeMap<Integer, String[]> renames = new TreeMap<Integer, String[]>(Collections.reverseOrder());
    Map<String, String> replacements = new LinkedHashMap<String, String>();
    StringBuilder dispatchers = new StringBuilder();
    for (String name : starts.keySet())
    {
      // Dispatchers of this name already in the class (a user group, a generated group) join into one
      List<String> existing = new ArrayList<String>();
      for (String dispatcher : dispatcherTexts.containsKey(uClass.getName() + "." + name)
        ? dispatcherTexts.get(uClass.getName() + "." + name) : new ArrayList<String>())
      {
        if (text.contains(dispatcher) && !existing.contains(dispatcher))
        {
          existing.add(dispatcher);
        }
      }
      List<String> implementations = new ArrayList<String>();
      List<List<MethodParameter>> candidates = new ArrayList<List<MethodParameter>>();
      List<Integer> sources = new ArrayList<Integer>();
      for (int d = 0; d < existing.size(); d++)
      {
        // their implementations may be bound by assignment (an attribute setter an event shares), not def
        taken.addAll(dispatcherImplementations.get(existing.get(d)));
        implementations.addAll(dispatcherImplementations.get(existing.get(d)));
        for (List<MethodParameter> candidate : dispatcherParameters.get(existing.get(d)))
        {
          candidates.add(candidate);
          sources.add(d);
        }
      }
      List<List<MethodParameter>> joining = new ArrayList<List<MethodParameter>>();
      List<Integer> positions = new ArrayList<Integer>();
      int unknown = 0;
      for (int i = 0; i < signatures.get(name).size(); i++)
      {
        List<MethodParameter> signature = signatures.get(name).get(i);
        if (signature == null)
        {
          unknown++;
        }
        else
        {
          joining.add(signature);
          positions.add(starts.get(name).get(i));
        }
      }
      // Mergeable: the definitions are all static or all on the object, and every one but the existing
      // dispatchers has a known signature
      if (instanceKinds.get(name).size() > 1 || unknown != existing.size())
      {
        continue;
      }
      // Of two definitions the dispatcher cannot tell apart, a model one (or an event) redefines a
      // generated one, otherwise the later wins, as in any Python class. The redefined one leaves its
      // dispatcher, or is renamed where it would come later in the class.
      List<List<MethodParameter>> all = new ArrayList<List<MethodParameter>>(candidates);
      all.addAll(joining);
      List<Integer> at = new ArrayList<Integer>();
      List<Boolean> fromModel = new ArrayList<Boolean>();
      for (int c = 0; c < candidates.size(); c++)
      {
        at.add(text.indexOf(existing.get(sources.get(c))));
        fromModel.add(writtenNames.contains(implementations.get(c)));
      }
      for (int i = 0; i < joining.size(); i++)
      {
        sources.add(existing.size() + i);
        at.add(positions.get(i));
        fromModel.add(written.containsKey(positions.get(i)));
      }
      boolean[] redefined = new boolean[all.size()];
      for (int i = 0; i < all.size(); i++)
      {
        for (int k = i + 1; k < all.size(); k++)
        {
          if (!redefined[i] && !redefined[k] && !sources.get(i).equals(sources.get(k)) && indistinct(all.get(i), all.get(k)))
          {
            boolean iWins = !fromModel.get(i).equals(fromModel.get(k)) ? fromModel.get(i) : at.get(i) > at.get(k);
            int loser = iWins ? k : i;
            redefined[loser] = true;
            if (loser >= candidates.size() && at.get(loser) > at.get(iWins ? i : k))
            {
              renames.put(at.get(loser), new String[] { name, numberedNames(taken, name, 1).get(0) });
              taken.add(renames.get(at.get(loser))[1]);
            }
          }
        }
      }
      List<String> keptImplementations = new ArrayList<String>();
      List<List<MethodParameter>> kept = new ArrayList<List<MethodParameter>>();
      for (int c = 0; c < candidates.size(); c++)
      {
        if (!redefined[c])
        {
          keptImplementations.add(implementations.get(c));
          kept.add(candidates.get(c));
        }
      }
      List<Integer> keptPositions = new ArrayList<Integer>();
      for (int i = 0; i < joining.size(); i++)
      {
        if (!redefined[candidates.size() + i])
        {
          keptPositions.add(positions.get(i));
          kept.add(joining.get(i));
        }
      }
      // A lone definition of the model also needs a dispatcher while inherited methods of its name stay
      // callable (overloadsInherited)
      boolean overloads = existing.isEmpty() && kept.size() == 1 && keptPositions.size() == 1 && written.containsKey(keptPositions.get(0))
        && instanceKinds.get(name).contains(true) && overloadsInherited(uClass, name, kept.get(0));
      if (existing.isEmpty() ? kept.size() < 2 && !overloads : keptPositions.isEmpty() && existing.size() == 1)
      {
        continue; // nothing to join (a lone definition, or a dispatcher no other definition meets)
      }
      List<String> numbered = numberedNames(taken, name, keptPositions.size());
      taken.addAll(numbered);
      String abstractDecorator = null;
      for (int i = 0; i < keptPositions.size(); i++)
      {
        renames.put(keptPositions.get(i), new String[] { name, numbered.get(i) });
        // A subclass implements the method by its name, so the dispatcher, not a numbered
        // implementation, carries an abstract definition's decorator
        int lineStart = text.lastIndexOf('\n', keptPositions.get(i)) + 1;
        int decoratorStart = text.lastIndexOf('\n', lineStart - 2) + 1;
        String decorator = lineStart > 1 ? text.substring(decoratorStart, lineStart) : "";
        if (decorator.trim().matches("@[\\w.]*abstractmethod_*")) // the name an import alias may take
        {
          renames.put(decoratorStart, new String[] { decorator, "" });
          abstractDecorator = decorator;
        }
      }
      keptImplementations.addAll(numbered);
      for (String dispatcher : existing)
      {
        abstractDecorator = dispatcher.matches("(?s).*abstractmethod_*\n    def .*") ? dispatcher : abstractDecorator;
      }
      String merged = overloadDispatcher(uClass, name, !instanceKinds.get(name).contains(true), keptImplementations, kept);
      merged = abstractDecorator == null ? merged : abstractDispatcher(merged);
      for (int d = 0; d < existing.size(); d++)
      {
        replacements.put(existing.get(d), d == 0 ? merged : "");
      }
      if (existing.isEmpty())
      {
        dispatchers.append(merged);
      }
    }
    for (Map.Entry<Integer, String[]> rename : renames.entrySet())
    {
      code.replace(rename.getKey(), rename.getKey() + rename.getValue()[0].length(), rename.getValue()[1]);
    }
    for (Map.Entry<String, String> replacement : replacements.entrySet())
    {
      int at = code.indexOf(replacement.getKey());
      code.replace(at, at + replacement.getKey().length(), replacement.getValue());
    }
    code.append(dispatchers);
    if (starts.containsKey(freshMemberName(uClass, "_bindArguments")))
    {
      classesNeedingBinder.remove(uClass); // this class's helper is written already
    }
    code.append(bindingHelper(uClass));
  }

  // The parameters, named names, of uClass's generated method name: typed from its state machine,
  // association end, list attribute or key, else from the model's generated API; null when unknown.
  // Events and model methods are typed when emitted.
  private List<MethodParameter> generatedParameters(UmpleClass uClass, String name, List<String> names)
  {
    for (StateMachine sm : uClass.getAllStateMachines())
    {
      if (names.size() == 1 && name.equals(translate("setMethod", sm)))
      {
        return new ArrayList<MethodParameter>(Arrays.asList(parameter(names.get(0), translate("type", sm))));
      }
    }
    for (AssociationVariable av : uClass.getAssociationVariables())
    {
      boolean takesObject = names.size() == 1 && (name.equals(translate("setMethod", av))
        || name.equals(translate("addMethod", av)) || name.equals(translate("removeMethod", av)));
      boolean takesIndex = names.size() == 2 && (name.equals(translate("addAtMethod", av)) || name.equals(translate("addOrMoveAtMethod", av)));
      if (av.getIsNavigable() && (takesObject || takesIndex))
      {
        List<MethodParameter> parameters = new ArrayList<MethodParameter>();
        parameters.add(parameter(names.get(0), av.getType()));
        if (takesIndex)
        {
          parameters.add(parameter(names.get(1), "int"));
        }
        return parameters;
      }
      if (av.getIsNavigable() && av.isMany() && names.size() == 1 && name.equals(translate("getMethod", av)))
      {
        return Arrays.asList(parameter(names.get(0), "int"));
      }
    }
    for (Attribute av : attributes(uClass))
    {
      if (av.getIsList() && names.size() == 1 && name.equals(translate("indexOfMethod", av)))
      {
        return Arrays.asList(parameter(names.get(0), av.getType()));
      }
      if (av.getIsList() && names.size() == 1 && name.equals(translate("getMethod", av)))
      {
        return Arrays.asList(parameter(names.get(0), "int"));
      }
    }
    if (names.size() == 1 && "equals".equals(name) && uClass.getKey().isProvided())
    {
      return Arrays.asList(parameter(names.get(0), "Object"));
    }
    List<List<MethodParameter>> declarations = new ArrayList<List<MethodParameter>>();
    for (Method method : uClass.getMethods())
    {
      if (method.getName().equals(name) && method.getSource() == Method.Source.fAutoAPI)
      {
        declarations.add(method.getMethodParameters());
      }
    }
    List<MethodParameter> sameCount = null;
    int withSameCount = 0;
    for (List<MethodParameter> parameters : declarations)
    {
      boolean same = parameters.size() == names.size();
      withSameCount += same ? 1 : 0;
      sameCount = same ? parameters : sameCount;
      if (namedAs(parameters, names))
      {
        return new ArrayList<MethodParameter>(parameters);
      }
    }
    return withSameCount == 1 ? new ArrayList<MethodParameter>(sameCount) : null;
  }

  private boolean namedAs(List<MethodParameter> parameters, List<String> names)
  {
    boolean same = parameters.size() == names.size();
    for (int i = 0; same && i < names.size(); i++)
    {
      same = parameterName(parameters.get(i).getName()).equals(names.get(i).replace("*", ""));
    }
    return same;
  }

  // The type of a parameter of a definition the model does not describe, which accepts any value.
  private static final String UNKNOWN_TYPE = "?";

  // Whether the dispatcher cannot choose between a and b: argument counts overlap, both or neither are
  // varargs (Java tries a fixed count first), and no position has two different known types.
  private static boolean indistinct(List<MethodParameter> a, List<MethodParameter> b)
  {
    if (!argumentCountsOverlap(a, b) || isVarargs(a) != isVarargs(b))
    {
      return false;
    }
    for (int k = 0; k < Math.max(a.size(), b.size()); k++)
    {
      String aType = typeAt(a, k);
      String bType = typeAt(b, k);
      if (aType != null && bType != null && !UNKNOWN_TYPE.equals(aType) && !UNKNOWN_TYPE.equals(bType) && !boxed(aType).equals(boxed(bType)))
      {
        return false;
      }
    }
    return true;
  }

  private static boolean isVarargs(List<MethodParameter> parameters)
  {
    return !parameters.isEmpty() && parameters.get(parameters.size() - 1).getType().endsWith("...");
  }

  // The type argument k of a call takes in a candidate: a variable parameter's element type for every
  // argument from its position on; null when the candidate takes no argument k.
  private static String typeAt(List<MethodParameter> parameters, int k)
  {
    int fixed = parameters.size() - (isVarargs(parameters) ? 1 : 0);
    MethodParameter p = k < fixed ? parameters.get(k) : isVarargs(parameters) ? parameters.get(fixed) : null;
    return p == null ? null : p.getType().replace("...", "") + (p.getIsList() ? "[]" : "");
  }

  private static boolean argumentCountsOverlap(List<MethodParameter> a, List<MethodParameter> b)
  {
    boolean aVarargs = !a.isEmpty() && a.get(a.size() - 1).getType().endsWith("...");
    boolean bVarargs = !b.isEmpty() && b.get(b.size() - 1).getType().endsWith("...");
    int aFixed = a.size() - (aVarargs ? 1 : 0);
    int bFixed = b.size() - (bVarargs ? 1 : 0);
    return aFixed == bFixed || aVarargs && bFixed >= aFixed || bVarargs && aFixed >= bFixed;
  }

  // The dispatcher name(self, *args, **kwargs) of an overload group. Candidates are tried most
  // specific first (dispatchOrder); the first whose parameters bind the arguments and pass their type
  // tests is called. implementations[i] takes parameters[i] and is called through the declaring class,
  // so a subclass implementation calling super() reaches this class's, not itself. Inherited
  // candidates compete too; one that wins passes the call on to the parent, whose dispatcher then
  // chooses it among its own.
  public String overloadDispatcher(UmpleClass uClass, String name, boolean isStatic, List<String> implementations,
    List<List<MethodParameter>> parameters)
  {
    classesNeedingBinder.add(uClass);
    String binder = DECLARING_CLASS + "." + freshMemberName(uClass, "_bindArguments");
    Map<String, String[]> types = new HashMap<String, String[]>();
    StringBuilder candidates = new StringBuilder();
    List<List<MethodParameter>> all = new ArrayList<List<MethodParameter>>(parameters);
    if (!isStatic)
    {
      all.addAll(inheritedCandidates(uClass, name, parameters));
    }
    for (int i : dispatchOrder(all))
    {
      List<String> names = new ArrayList<String>();
      boolean varargs = false;
      StringBuilder tests = new StringBuilder();
      List<MethodParameter> candidate = all.get(i);
      for (int k = 0; k < candidate.size(); k++)
      {
        MethodParameter p = candidate.get(k);
        varargs = p.getType().endsWith("...");
        String test = varargs
          ? "all(" + typeTest("v", p.getType().substring(0, p.getType().length() - 3), false, uClass, types) + " for v in bound[" + k + "])"
          : typeTest("bound[" + k + "]", p.getType(), p.getIsList(), uClass, types);
        if (!varargs)
        {
          names.add(pythonString(parameterName(p.getName())));
        }
        if (!"True".equals(test))
        {
          tests.append(" and ").append(test);
        }
      }
      String call = i >= parameters.size() ? "super()." + name + "(*args, **kwargs)"
        : DECLARING_CLASS + "." + implementations.get(i) + (isStatic ? "(" : "(self, ") + (varargs ? "*bound[:-1], *bound[-1])" : "*bound)");
      candidates.append("\n        bound = ").append(binder).append("((").append(String.join(", ", names)).append(names.size() == 1 ? "," : "")
        .append("), ").append(varargs ? "True" : "False").append(", args, kwargs)")
        .append("\n        if bound is not None").append(tests).append(":")
        .append("\n            return ").append(call);
    }
    StringBuilder text = new StringBuilder(isStatic ? "\n\n    @staticmethod\n    def " + name + "(*args, **kwargs):" : "\n\n    def " + name + "(self, *args, **kwargs):");
    Set<String> lines = new TreeSet<String>();
    for (String[] use : types.values())
    {
      if (use[1] != null)
      {
        lines.add(use[1]);
      }
    }
    for (String line : lines)
    {
      text.append("\n        ").append(line);
    }
    // A call none of the candidates takes goes on to an ancestor's method of the name, which may be a
    // generated one the candidates do not list
    String noMatch = !isStatic && ancestorHas(uClass, name) ? "return super()." + name + "(*args, **kwargs)" : "raise TypeError(\"No method matches provided parameters\")";
    String dispatcher = text.append(candidates).append("\n        ").append(noMatch).toString();
    String key = uClass.getName() + "." + name;
    if (!dispatcherTexts.containsKey(key))
    {
      dispatcherTexts.put(key, new ArrayList<String>());
    }
    dispatcherTexts.get(key).add(dispatcher);
    dispatcherImplementations.put(dispatcher, new ArrayList<String>(implementations));
    dispatcherParameters.put(dispatcher, new ArrayList<List<MethodParameter>>(parameters));
    return dispatcher;
  }

  // Java calls the most specific overload that fits, and the dispatcher the first candidate that fits,
  // so each candidate is tried before those it is more specific than, otherwise in declaration order.
  private List<Integer> dispatchOrder(List<List<MethodParameter>> parameters)
  {
    List<Integer> remaining = new ArrayList<Integer>();
    for (int i = 0; i < parameters.size(); i++)
    {
      remaining.add(i);
    }
    List<Integer> order = new ArrayList<Integer>();
    while (!remaining.isEmpty())
    {
      Integer next = remaining.get(0);
      for (Integer candidate : remaining)
      {
        boolean mostSpecific = true;
        for (Integer other : remaining)
        {
          mostSpecific = mostSpecific && !moreSpecific(parameters.get(other), parameters.get(candidate));
        }
        if (mostSpecific)
        {
          next = candidate;
          break;
        }
      }
      order.add(next);
      remaining.remove(next);
    }
    return order;
  }

  // Java's rule for two candidates that both fit: a fixed number of parameters beats a variable one;
  // with the same parameters, fixed or variable, a is more specific when each of its parameter types
  // (a variable parameter's element type) fits b's and one is narrower.
  private boolean moreSpecific(List<MethodParameter> a, List<MethodParameter> b)
  {
    if (isVarargs(a) != isVarargs(b) || !isVarargs(a) && a.size() != b.size())
    {
      return !isVarargs(a) && isVarargs(b);
    }
    // Two variable lists compare position by position, the shorter repeating its element type
    boolean narrower = false;
    for (int k = 0; k < Math.max(a.size(), b.size()); k++)
    {
      String pType = typeAt(a, k);
      String qType = typeAt(b, k);
      if (pType.endsWith("[]") != qType.endsWith("[]") || !fits(pType.replace("[]", ""), qType.replace("[]", "")))
      {
        return false;
      }
      narrower = narrower || !fits(qType.replace("[]", ""), pType.replace("[]", ""));
    }
    return narrower;
  }

  // Numeric dispatch order: Java's widening order, except that double precedes float because a Python
  // float is a double. A wrapper ranks as its primitive.
  private static final List<String> NUMBER_WIDTHS = Arrays.asList("byte", "short", "int", "long", "double", "float");
  private static final List<String> WRAPPER_WIDTHS = Arrays.asList("Byte", "Short", "Integer", "Long", "Double", "Float");

  // A primitive's wrapper type, which Python's values do not tell from the primitive (int and Integer)
  private static String boxed(String type)
  {
    return NUMBER_WIDTHS.contains(type) ? WRAPPER_WIDTHS.get(NUMBER_WIDTHS.indexOf(type))
      : "boolean".equals(type) ? "Boolean" : "char".equals(type) ? "Character" : type;
  }

  private static int width(String type)
  {
    return NUMBER_WIDTHS.contains(type) ? NUMBER_WIDTHS.indexOf(type) : WRAPPER_WIDTHS.indexOf(type);
  }

  // Whether every value of type a is also a value of type b: the same type, Object, a wider number,
  // or a class or interface a inherits.
  private boolean fits(String a, String b)
  {
    if (a.equals(b) || "Object".equals(b) || UNKNOWN_TYPE.equals(b) || width(a) >= 0 && width(b) >= width(a))
    {
      return true;
    }
    UmpleClassifier c = getModel().getUmpleClass(a);
    return inherits(c != null ? c : getModel().getUmpleInterface(a), b);
  }

  // Whether classifier c is type or inherits it through its superclasses or interfaces.
  private static boolean inherits(UmpleClassifier c, String type)
  {
    return inherits(c, type, new HashSet<UmpleClassifier>());
  }

  private static boolean inherits(UmpleClassifier c, String type, Set<UmpleClassifier> seen)
  {
    if (c == null || c.getName().equals(type))
    {
      return c != null;
    }
    if (!seen.add(c))
    {
      return false; // reached already through another path
    }
    if (c instanceof UmpleClass && inherits(((UmpleClass) c).getExtendsClass(), type, seen))
    {
      return true;
    }
    for (UmpleInterface parent : c instanceof UmpleClass ? ((UmpleClass) c).getParentInterface() : ((UmpleInterface) c).getExtendsInterface())
    {
      if (inherits(parent, type, seen))
      {
        return true;
      }
    }
    return false;
  }

  // The argument binding helper, once per class whose overload dispatchers need it, else "". It binds
  // positional then keyword arguments to the parameter names, rejecting duplicates, unknown keywords
  // and a wrong number of arguments; with varargs, extra positional arguments go to the last parameter.
  public String bindingHelper(UmpleClass uClass)
  {
    if (!classesNeedingBinder.remove(uClass))
    {
      return "";
    }
    return "\n\n    @staticmethod"
      + "\n    def " + freshMemberName(uClass, "_bindArguments") + "(names, varargs, args, kwargs):"
      + "\n        if len(args) > len(names) and not varargs:"
      + "\n            return None"
      + "\n        bound = list(args[:len(names)])"
      + "\n        for name in names[len(bound):]:"
      + "\n            if name not in kwargs:"
      + "\n                return None"
      + "\n            bound.append(kwargs[name])"
      + "\n        if len(kwargs) != len(names) - min(len(args), len(names)):"
      + "\n            return None"
      + "\n        if varargs:"
      + "\n            bound.append(args[len(names):])"
      + "\n        return bound";
  }

  private static final List<String> BOXED_TYPES = Arrays.asList("Integer", "Long", "Short", "Byte", "Double", "Float", "Boolean", "Character");

  // The Python test that value has the Umple type: bool is never an int, int is accepted for floats,
  // None is accepted for reference types (boxed numbers included), lists check every element. "True"
  // when anything goes.
  private String typeTest(String value, String type, boolean isList, UmpleClass uClass, Map<String, String[]> types)
  {
    if (isList)
    {
      String element = typeTest("e", type, false, uClass, types);
      return "(" + value + " is None or isinstance(" + value + ", (list, tuple))"
        + ("True".equals(element) ? "" : " and all(" + element + " for e in " + value + ")") + ")";
    }
    String test = valueTest(value, type, uClass, types);
    return BOXED_TYPES.contains(type) ? "(" + value + " is None or " + test + ")" : test;
  }

  private String valueTest(String value, String type, UmpleClass uClass, Map<String, String[]> types)
  {
    switch (type)
    {
      case "Integer": case "int": case "long": case "short": case "byte": case "Long": case "Short": case "Byte":
        return "(isinstance(" + value + ", int) and not isinstance(" + value + ", bool))";
      case "Double": case "Float": case "double": case "float":
        return "(isinstance(" + value + ", (int, float)) and not isinstance(" + value + ", bool))";
      case "Boolean": case "boolean":
        return "isinstance(" + value + ", bool)";
      case "String":
        return "(" + value + " is None or isinstance(" + value + ", str))";
      case "char": case "Character":
        return "(isinstance(" + value + ", str) and len(" + value + ") == 1)"; // Python has no character type
      case "Date": case "Time":
        return "(" + value + " is None or isinstance(" + value + ", " + standardName("datetime", null) + "." + ("Date".equals(type) ? "date" : "time") + "))";
      default:
        if (isEnumeration(uClass, type))
        {
          return "(" + value + " is None or isinstance(" + value + ", " + DECLARING_CLASS + "." + type + "))";
        }
        if (!isModelType(type))
        {
          return "True";
        }
        return "(" + value + " is None or isinstance(" + value + ", " + typeReference(uClass, type, types) + "))";
    }
  }

  // What a binding line of classUse binds, without the name it binds it to, so two lines for the same
  // module compare equal
  private static String bindingSource(String line)
  {
    int assignment = line.indexOf(" = ");
    int alias = line.indexOf(" as ");
    return assignment >= 0 ? line.substring(assignment + 3) : alias >= 0 ? line.substring(0, alias) : line;
  }

  // How a dispatcher names a model type (types keeps what it chose for each type): the same name in
  // every test of the type, one binding per module, and never a name that its locals or another
  // module's binding hold.
  private String typeReference(UmpleClass uClass, String type, Map<String, String[]> types)
  {
    if (!types.containsKey(type))
    {
      String locals = "self, args, kwargs, bound, e, v";
      String[] use = classUse(uClass, type, locals);
      boolean bound = false;
      for (String[] other : types.values())
      {
        if (!bound && use[1] != null && other[1] != null && bindingSource(other[1]).equals(bindingSource(use[1])))
        {
          String alias = other[0].split("\\.")[0];
          use = new String[] { alias + use[0].substring(use[0].split("\\.")[0].length()), other[1] };
          bound = true;
        }
      }
      if (use[1] != null && !bound)
      {
        StringBuilder taken = new StringBuilder(locals);
        boolean clash = false;
        for (String[] other : types.values())
        {
          if (other[1] != null && !other[1].equals(use[1]))
          {
            String name = other[0].split("\\.")[0];
            taken.append(", ").append(name);
            clash = clash || name.equals(use[0].split("\\.")[0]);
          }
        }
        if (clash)
        {
          use = classUse(uClass, type, taken.toString());
        }
      }
      types.put(type, use);
    }
    return types.get(type)[0];
  }
}

// What a constraint is rendered against: the class, the parameters in scope by name, the expression
// that reaches members (self, or the class in a static method) and the attributes read from parameters.
class PythonConstraintScope
{
  depend java.util.*;
  UmpleClass uClass;
  Map<String, MethodParameter> parameters;
  String receiver;
  Collection<Attribute> attributesAsParameters;
}
