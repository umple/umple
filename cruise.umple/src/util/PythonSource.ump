namespace cruise.umple.util;

// Lexical handling of Python source written in models: where its strings and comments are, and how
// to re-indent it
class PythonSource
{
  depend java.util.*;
  depend java.util.regex.*;

  private static final int LOGICAL = 0;
  private static final int BLANK = 1;
  private static final int COMMENT = 2;
  private static final int CONTINUATION = 3;
  private static final int IN_STRING = 4;

  // Re-indents Python source so its outermost statements start at indent. Other lines keep their
  // relative indentation (Python's tab rule), and lines inside strings are kept as they are.
  // firstLineIndent is the first line's indentation in the model, null when unknown. Code without
  // statements gets pass.
  public static String reindent(String code, String firstLineIndent, String indent)
  {
    String[] lines = ((firstLineIndent == null ? "" : firstLineIndent) + (code == null ? "" : code).replaceFirst("\\s+$", ""))
      .replace("\r\n", "\n").replace('\r', '\n').split("\n", -1);
    char[] lastCode = new char[lines.length];
    int[] kinds = lineKinds(lines, lastCode);

    int[] widths = new int[lines.length];
    int othersBaseline = Integer.MAX_VALUE;
    int commentBaseline = Integer.MAX_VALUE;
    int firstLogical = -1;
    for (int n = 0; n < lines.length; n++)
    {
      widths[n] = indentWidth(lines[n]);
      if (kinds[n] == LOGICAL && firstLogical < 0)
      {
        firstLogical = n;
      }
      else if (kinds[n] == LOGICAL)
      {
        othersBaseline = Math.min(othersBaseline, widths[n]);
      }
      else if (kinds[n] == COMMENT && (n > 0 || firstLineIndent != null))
      {
        commentBaseline = Math.min(commentBaseline, widths[n]);
      }
    }
    if (firstLogical == 0 && firstLineIndent == null)
    {
      widths[0] = firstLineWidth(kinds, lastCode, widths, othersBaseline);
    }
    // Without statements, the comments keep their indentation relative to the least indented one
    int baseline = firstLogical >= 0 ? Math.min(othersBaseline, widths[firstLogical])
      : commentBaseline == Integer.MAX_VALUE ? 0 : commentBaseline;
    if (firstLineIndent == null && kinds[0] == COMMENT)
    {
      widths[0] = baseline; // its indentation is not known, so it goes with the code around it
    }

    StringBuilder out = new StringBuilder();
    for (int n = 0; n < lines.length; n++)
    {
      out.append("\n");
      if (kinds[n] == IN_STRING)
      {
        out.append(lines[n]);
      }
      else if (kinds[n] != BLANK)
      {
        out.append(indent).append(spaces(Math.max(0, widths[n] - baseline))).append(lines[n].substring(leadingWhitespace(lines[n])));
      }
    }
    if (firstLogical < 0)
    {
      out.append("\n").append(indent).append("pass");
    }
    return out.toString();
  }

  // The kind of each physical line of Python source (LOGICAL, BLANK, COMMENT, CONTINUATION or
  // IN_STRING) from a lexical scan, and in lastCode the last character of code on each line.
  private static int[] lineKinds(String[] lines, char[] lastCode)
  {
    int[] kinds = new int[lines.length];
    String quote = null;
    int depth = 0;
    boolean continued = false;
    for (int n = 0; n < lines.length; n++)
    {
      String line = lines[n];
      String content = line.substring(leadingWhitespace(line));
      kinds[n] = quote != null ? IN_STRING : content.isEmpty() ? BLANK : depth > 0 || continued ? CONTINUATION
        : content.startsWith("#") ? COMMENT : LOGICAL;
      continued = false;
      boolean escapedEnd = false;
      for (int i = 0; i < line.length(); i++)
      {
        char c = line.charAt(i);
        if (quote != null)
        {
          if (c == '\\')
          {
            escapedEnd = ++i >= line.length();
          }
          else if (line.startsWith(quote, i))
          {
            i += quote.length() - 1;
            quote = null;
            lastCode[n] = c;
          }
        }
        else if (c == '#')
        {
          break;
        }
        else if (c == '"' || c == '\'')
        {
          // Prefixes (r, b, f, u) need no handling: a backslash always protects the next character.
          quote = line.startsWith("" + c + c + c, i) ? "" + c + c + c : "" + c;
          i += quote.length() - 1;
          lastCode[n] = c;
        }
        else if (!Character.isWhitespace(c))
        {
          depth += "([{".indexOf(c) >= 0 ? 1 : ")]}".indexOf(c) >= 0 && depth > 0 ? -1 : 0;
          continued = c == '\\' && i == line.length() - 1;
          lastCode[n] = c;
        }
      }
      if (quote != null && quote.length() == 1 && !escapedEnd)
      {
        quote = null; // an unterminated single-quoted string ends with its line
      }
    }
    return kinds;
  }

  // Where keyword first stands as a statement word in Python source, outside strings (f-strings
  // included) and comments and not as the end of a longer name or of a member access (self.superCall);
  // -1 when it does not.
  public static int codeAt(String code, String keyword)
  {
    boolean[] isCode = codeChars(code, false);
    for (int i = 0; i < code.length(); i++)
    {
      if (isCode[i] && code.startsWith(keyword, i) && startsName(code, i))
      {
        return i;
      }
    }
    return -1;
  }

  // The names Python source uses as code, the expressions of f-strings included, other than members
  // after a dot
  public static Set<String> codeNames(String code)
  {
    boolean[] isCode = codeChars(code, true);
    Set<String> names = new HashSet<String>();
    for (int i = 0; i < code.length(); i++)
    {
      if (isCode[i] && Character.isJavaIdentifierStart(code.charAt(i)) && startsName(code, i))
      {
        int end = i + 1;
        while (end < code.length() && Character.isJavaIdentifierPart(code.charAt(end)))
        {
          end++;
        }
        names.add(code.substring(i, end));
        i = end - 1;
      }
    }
    return names;
  }

  // The names a Python function body binds in its own scope: by import, def and class (their names,
  // not what their bodies bind), global, nonlocal, assignment, a for statement, as and :=. Names that
  // nested functions, classes, lambdas and comprehensions bind belong to those scopes.
  public static Set<String> boundNames(String code)
  {
    boolean[] isCode = codeChars(code, true);
    StringBuilder visible = new StringBuilder(code);
    for (int i = 0; i < code.length(); i++)
    {
      if (!isCode[i] && code.charAt(i) != '\n')
      {
        visible.setCharAt(i, ' ');
      }
    }
    Set<String> names = new HashSet<String>();
    int brackets = 0;
    int nested = -1; // the indentation of a nested def or class whose body is being skipped
    for (String line : visible.toString().split("\n", -1))
    {
      boolean statement = brackets <= 0;
      brackets += bracketBalance(line);
      String text = line.trim();
      int indent = indentWidth(line);
      if (text.isEmpty() || nested >= 0 && (!statement || indent > nested))
      {
        continue;
      }
      nested = -1;
      Matcher block = NESTED_BLOCK.matcher(text);
      if (statement && block.lookingAt())
      {
        names.add(block.group(1));
        nested = indent;
        continue;
      }
      Matcher imported = IMPORT.matcher(text);
      if (statement && imported.lookingAt())
      {
        String items = imported.group(1) != null ? imported.group(1) : imported.group(2) != null ? imported.group(2) : imported.group(3);
        for (String item : items.split(","))
        {
          String[] words = item.trim().split("\\s+as\\s+");
          names.add(words.length > 1 ? words[1].trim() : words[0].trim().split("\\.")[0]);
        }
        continue;
      }
      Matcher bound = (statement ? STATEMENT_BINDING : BINDING).matcher(text);
      while (bound.find())
      {
        for (int group = 1; group <= bound.groupCount(); group++)
        {
          if (bound.group(group) != null)
          {
            names.addAll(Arrays.asList(bound.group(group).split("[^\\w]+")));
          }
        }
      }
    }
    names.remove("");
    return names;
  }

  private static final Pattern NESTED_BLOCK = Pattern.compile("(?:async\\s+)?(?:def|class)\\s+(\\w+)");
  private static final Pattern IMPORT = Pattern.compile("import\\s+([^;]+)|from\\s+\\S+\\s+import\\s+(?:\\(([^)]*)\\)?|([^;]+))");
  // A binding anywhere in a line: as and :=
  private static final Pattern BINDING = Pattern.compile("\\bas\\s+(\\w+)|(\\w+)\\s*:=");
  // A line that starts a statement can also bind by global, nonlocal, assignment and for
  private static final Pattern STATEMENT_BINDING = Pattern.compile("^(?:global|nonlocal)\\s+([\\w \\t,]+)"
    + "|^([\\w \\t,()\\[\\]*]+?)\\s*(?::[^=]*)?=(?!=)|^(?:async\\s+)?for\\s+([\\w \\t,()\\[\\]*]+?)\\s+in\\b|\\bas\\s+(\\w+)|(\\w+)\\s*:=");

  // How many more brackets a line opens than it closes
  private static int bracketBalance(String line)
  {
    int balance = 0;
    for (char c : line.toCharArray())
    {
      balance += "([{".indexOf(c) >= 0 ? 1 : ")]}".indexOf(c) >= 0 ? -1 : 0;
    }
    return balance;
  }

  private static boolean startsName(String code, int i)
  {
    return i == 0 || !Character.isJavaIdentifierPart(code.charAt(i - 1)) && code.charAt(i - 1) != '.';
  }

  // Which characters of Python source are code rather than part of a string or a comment, reading
  // strings and comments as lineKinds does. With fields, the replacement fields of f-strings are code,
  // except the strings inside them and their format specs.
  private static boolean[] codeChars(String code, boolean fields)
  {
    boolean[] isCode = new boolean[code.length()];
    // What is open, innermost last: a string {quote, formatted} or a replacement field {null, open
    // brackets, in its format spec}
    List<Object[]> open = new ArrayList<Object[]>();
    for (int i = 0; i < code.length(); i++)
    {
      char c = code.charAt(i);
      Object[] top = open.isEmpty() ? null : open.get(open.size() - 1);
      if (top != null && top[0] != null)
      {
        String quote = (String) top[0];
        if (c == '\\')
        {
          i++;
        }
        else if ((Boolean) top[1] && c == '{' && code.startsWith("{{", i))
        {
          i++;
        }
        else if ((Boolean) top[1] && c == '{')
        {
          open.add(new Object[] { null, 0, false });
        }
        else if (code.startsWith(quote, i))
        {
          i += quote.length() - 1;
          open.remove(open.size() - 1);
        }
        else if (c == '\n' && quote.length() == 1)
        {
          open.remove(open.size() - 1); // an unterminated single-quoted string ends with its line
        }
      }
      else if (top != null && (Boolean) top[2])
      {
        // a format spec is text, but may hold nested replacement fields
        if (c == '{')
        {
          open.add(new Object[] { null, 0, false });
        }
        else if (c == '}')
        {
          open.remove(open.size() - 1);
        }
      }
      else if (top == null && c == '#')
      {
        int newline = code.indexOf('\n', i);
        i = newline < 0 ? code.length() : newline;
      }
      else if (c == '"' || c == '\'')
      {
        String quote = code.startsWith("" + c + c + c, i) ? "" + c + c + c : "" + c;
        open.add(new Object[] { quote, fields && hasFormatPrefix(code, i) });
        i += quote.length() - 1;
      }
      else if (top != null && c == '}' && (Integer) top[1] == 0)
      {
        open.remove(open.size() - 1);
      }
      else if (top != null && (Integer) top[1] == 0 && (c == ':' && !code.startsWith(":=", i)
        || c == '!' && i + 2 < code.length() && "rsa".indexOf(code.charAt(i + 1)) >= 0 && "}:".indexOf(code.charAt(i + 2)) >= 0))
      {
        top[2] = c == ':'; // a conversion (!r) is not code either, and a format spec may follow it
        i += c == '!' ? 1 : 0;
      }
      else
      {
        if (top != null)
        {
          top[1] = (Integer) top[1] + ("([{".indexOf(c) >= 0 ? 1 : ")]}".indexOf(c) >= 0 ? -1 : 0);
        }
        isCode[i] = true;
      }
    }
    return isCode;
  }

  // Whether the string literal opening at quote has an f prefix (f, rf, Fr ...)
  private static boolean hasFormatPrefix(String code, int quote)
  {
    int start = quote;
    while (start > 0 && quote - start < 2 && "rRbBuUfF".indexOf(code.charAt(start - 1)) >= 0)
    {
      start--;
    }
    return code.substring(start, quote).toLowerCase().contains("f") && startsName(code, start);
  }


  // Whether each line of Python source starts inside a string literal
  public static boolean[] linesInsideStrings(List<String> lines)
  {
    int[] kinds = lineKinds(lines.toArray(new String[0]), new char[lines.size()]);
    boolean[] inside = new boolean[kinds.length];
    for (int n = 0; n < kinds.length; n++)
    {
      inside[n] = kinds[n] == IN_STRING;
    }
    return inside;
  }

  // The width of a first line whose indentation is unknown: level with the next statement, or
  // shallower than all the rest when it opens a block whose first statement is the least indented.
  private static int firstLineWidth(int[] kinds, char[] lastCode, int[] widths, int othersBaseline)
  {
    int next = 1;
    char end = lastCode[0];
    while (next < kinds.length && kinds[next] != LOGICAL)
    {
      end = lastCode[next] != 0 ? lastCode[next] : end;
      next++;
    }
    if (next == kinds.length)
    {
      return 0;
    }
    return end == ':' && widths[next] == othersBaseline ? 0 : othersBaseline;
  }

  private static int leadingWhitespace(String line)
  {
    int i = 0;
    while (i < line.length() && " \t\f".indexOf(line.charAt(i)) >= 0)
    {
      i++;
    }
    return i;
  }

  // Indentation width with Python's rules: a tab advances to the next multiple of eight.
  private static int indentWidth(String line)
  {
    int width = 0;
    for (int i = 0; i < leadingWhitespace(line); i++)
    {
      char c = line.charAt(i);
      width = c == ' ' ? width + 1 : c == '\t' ? (width / 8 + 1) * 8 : 0;
    }
    return width;
  }

  private static String spaces(int count)
  {
    return new String(new char[count]).replace('\0', ' ');
  }
}
