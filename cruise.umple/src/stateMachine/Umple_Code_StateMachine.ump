 class UmpleClass {
  public List<StateMachine> getAllStateMachines()
  {
      ArrayList<StateMachine> all = new ArrayList<StateMachine>();
      all.addAll(getStateMachines());
      for (StateMachine sm : getStateMachines())
      {
        all.addAll(sm.getNestedStateMachines());
      }
      return all;
