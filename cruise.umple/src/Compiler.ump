namespace cruise.umple.compiler;

class CodeCompiler {

  depend java.util.*;
  depend java.util.regex.*;
  depend java.io.*;
  depend cruise.umple.compiler.*;
  depend cruise.umple.compiler.exceptions.*;
  depend cruise.umple.util.StringFormatter;
  depend cruise.umple.util.PythonSource;
  depend javax.tools.ToolProvider;
  depend javax.tools.JavaCompiler;

  public static String console;
  public static boolean subsequentCompilation = false; // true if compile used more than once to quell messages

  public static boolean compile(UmpleModel model, String generator, boolean useExec, boolean beQuiet, String entryClass, String errorFileName, String... extraArgs) {
    boolean wasSuccessful = true;
    String extra = "";
    for(String arg:extraArgs)
    {
      extra+=arg;
    }
    List<UmpleElement> pythonElements = new ArrayList<UmpleElement>();
    for (UmpleElement currentElement : model.getUmpleElements())
    {
      if ("external".equals(currentElement.getModifier()))
      {
        continue;
      }
      if (entryClass.equals("-") || entryClass.equals(currentElement.getName())) {
        if(generator.equals("Java")) {
          wasSuccessful = wasSuccessful & compileJava(currentElement, model, useExec, beQuiet, errorFileName,  extra);
          subsequentCompilation = true;
        }
        else if (generator.equals("Php")) {
          wasSuccessful = wasSuccessful & compilePhp(currentElement, model, beQuiet, extra);
          subsequentCompilation = true;
        }
        else if (generator.equals("Python")) {
          pythonElements.add(currentElement);
        }
        else {
          System.out.println("Compilation of generated code not supported yet for generator "+generator);
        }
      }
    }
    if (!pythonElements.isEmpty()) {
      wasSuccessful = wasSuccessful & compilePython(pythonElements, model, errorFileName);
      subsequentCompilation = true;
    }
    return wasSuccessful;
  }
 
  // Python is only syntax-checked here. Running user code is the job of an explicit
  // execution step (for example the UmpleOnline sandboxed execution service), never of compilation.
  private static boolean compilePython(List<UmpleElement> elements, UmpleModel model, String errorFileName) {
    String root = null;
    for (GenerateTarget gt : model.getGenerates()) {
      if (gt.getLanguage().equals("Python")) {
        root = StringFormatter.addPathOrAbsolute(model.getUmpleFile().getPath(), gt.getPath());
      }
    }
    if (root == null) {
      return false;
    }
    List<File> files = new ArrayList<File>();
    for (UmpleElement element : elements) {
      File file = new File(root + element.getPackageName().replace(".", File.separator), element.getName() + ".py");
      if (file.exists()) {
        files.add(file); // inner classes live in their outer class's file
      }
    }
    if (files.isEmpty()) {
      return true;
    }

    if (getPythonInterpreter() == null) {
      System.err.println("Python 3 is required to compile generated Python. Install it, or set UMPLE_PYTHON to its path.");
      return false;
    }

    String errors = checkPythonSyntax(files);
    if (errors == null) {
      return true;
    }

    String message = mapPythonTraceback(errors, null);
    System.err.println(message);
    if (errorFileName != null) {
      try (PrintWriter out = new PrintWriter(errorFileName)) {
        out.println(message);
      }
      catch (IOException e) {
        System.err.println(e);
      }
    }
    return false;
  }

  const int PYTHON_TIMEOUT_SECONDS = 60;
  const int PROCESS_OUTPUT_LIMIT = 1048576;
  private static String pythonInterpreter = null;
  private static boolean pythonInterpreterSearched = false;

  // Compiles the given Python files without running them, using the interpreter from
  // getPythonInterpreter(), which must be available. Returns null when every file compiles,
  // otherwise what Python reported.
  public static String checkPythonSyntax(List<File> files) {
    // -I isolates Python from the working directory and PYTHONPATH, so a generated module that
    // happens to be named py_compile cannot replace the standard one and run. The files go in
    // batches: one argument each could pass Windows' command-line limit for a large model. Every
    // batch is checked, so all errors are reported, as for a single batch.
    StringBuilder output = new StringBuilder();
    boolean failed = false;
    for (int from = 0, to; from < files.size(); from = to) {
      List<String> command = new ArrayList<String>(Arrays.asList(getPythonInterpreter(), "-I", "-m", "py_compile"));
      int length = 0;
      for (to = from; to < files.size() && (to == from || length + files.get(to).getPath().length() < 8000); to++) {
        command.add(files.get(to).getPath());
        length += files.get(to).getPath().length() + 1;
      }
      failed = runProcess(command, PYTHON_TIMEOUT_SECONDS, output) != 0 || failed;
    }
    return failed ? output.toString() : null;
  }

  // UMPLE_PYTHON wins when set; otherwise python3, then python if it is Python 3.
  public static String getPythonInterpreter() {
    synchronized (CodeCompiler.class) {
      if (!pythonInterpreterSearched) {
        String configured = System.getenv("UMPLE_PYTHON");
        List<String> candidates = (configured != null && !configured.isEmpty())
          ? Arrays.asList(configured)
          : Arrays.asList("python3", "python");
        for (String candidate : candidates) {
          StringBuilder version = new StringBuilder();
          if (runProcess(Arrays.asList(candidate, "--version"), PYTHON_TIMEOUT_SECONDS, version) == 0
              && version.toString().startsWith("Python 3")) {
            pythonInterpreter = candidate;
            break;
          }
        }
        pythonInterpreterSearched = true;
      }
      return pythonInterpreter;
    }
  }

  // Runs a command with stdout and stderr merged into a temporary file, so a chatty child can never
  // block on a full pipe, and kills it if it outlives the timeout. Appends what it printed to output
  // and returns its exit code, or -1 if it could not be run or timed out.
  private static int runProcess(List<String> command, int timeoutSeconds, StringBuilder output) {
    File log = null;
    Process process = null;
    try {
      log = File.createTempFile("umple-process", ".log");
      process = new ProcessBuilder(command).redirectErrorStream(true).redirectOutput(log).start();
      boolean finished = process.waitFor(timeoutSeconds, java.util.concurrent.TimeUnit.SECONDS);
      if (!finished) {
        process.destroyForcibly().waitFor();
      }
      output.append(readAtMost(log, PROCESS_OUTPUT_LIMIT));
      if (!finished) {
        output.append("Timed out after " + timeoutSeconds + " seconds: " + String.join(" ", command) + "\n");
        return -1;
      }
      return process.exitValue();
    }
    catch (IOException e) {
      output.append(e.getMessage()).append("\n");
      return -1;
    }
    catch (InterruptedException e) {
      process.destroyForcibly();
      Thread.currentThread().interrupt();
      output.append("Interrupted\n");
      return -1;
    }
    finally {
      if (log != null && !log.delete()) {
        log.deleteOnExit(); // still held open by a child that is being killed
      }
    }
  }

  private static boolean compilePhp(UmpleElement aClass, UmpleModel model, boolean beQuiet, String args) {
    String path="";
    String base="";
    for (GenerateTarget gt : model.getGenerates()) {
      if (gt.getLanguage().equals("Php")) {
        base = StringFormatter.addPathOrAbsolute( 
            model.getUmpleFile().getPath() +File.separator+ gt.getPath(), "");
        path = base;
      }
    }
    String filename = path + File.separator + aClass.getName() + ".php";
    int retval=0;

    try {
      if(base.contains(" ") && !(beQuiet && subsequentCompilation)) {
        System.err.println("Warning: Compiling generated Php from a directory or path containing a space character may produce an error message from the PhP compiler.");
      }
      
      BufferedReader reader;
      
      Process p = Runtime.getRuntime().exec("php -l -e " +filename);
      reader=new BufferedReader(new InputStreamReader(p.getInputStream())); 

      // All output of the above should go to standard output
      try {
        retval=p.waitFor(); 
      }
      catch (InterruptedException e) {}

      String line;
      if(reader.ready()) {
        line = reader.readLine();
      }
      else {
        line = null;
      }

      while (line!=null) {
        if(!line.startsWith("No syntax errors detected in")) {
          System.err.println(line);
          retval = 1;
        }

        if(reader.ready()) {
          line = reader.readLine();
        }
        else {
          line = null;
        }
      }
    } catch (IOException e) {
      println(e.getMessage());
      retval = 999;
    }
    return (retval == 0);
  }
  
  // Compiles graphviz files to various outputs: .svg (default), using dot
  public static boolean genDotDiagram (UmpleModel model,
    GenerateTarget gt, boolean beQuiet, String graphicFormat) {

    String generator = gt.getLanguage();
    
    String fileroot = model.getUmpleFile().getFileName();
    if (fileroot.endsWith(".ump")) {
      fileroot = fileroot.substring(0, fileroot.length() - 4);
    }
    if(generator.equals("GvClassDiagram")) {
      fileroot+="cd";
    }
    if(generator.equals("InstanceDiagram")) {
      fileroot+="cid";
    }
    else if(generator.equals("GvEntityRelationshipDiagram")) {
      fileroot+="erd";
    }
    else if(generator.equals("GvFeatureDiagram")) {
      fileroot+="GvFeatureDiagram";
    }
    else if(generator.equals("GvClassTraitDiagram")) {
      fileroot+="cdt";
    }
    // Note that GV state diagrams do not have a fileroot suffix

    String path="";
    String extraPath=gt.getPath();

    if(extraPath.startsWith("/")) {
      // Absolute
      path=extraPath;
    }
    else
    {
      path=model.getUmpleFile().getPath() + File.separator + extraPath;
    }
    
    String inputFullPath=path + File.separator + fileroot + ".gv";
    String outputFullPath=path + File.separator + fileroot + "."+ graphicFormat;

    int retval=0;

    try {
      if(path.contains(" ") && !beQuiet) {
        System.err.println("Warning: Compiling generated Graphviz files from a directory or path containing a space character may produce an error message from the PhP compiler.");
      }
      
      BufferedReader reader;
      
      Process p = Runtime.getRuntime().exec("dot -T"+graphicFormat+" "+inputFullPath+" -o "+outputFullPath);
      reader=new BufferedReader(new InputStreamReader(p.getInputStream())); 

      // All output of the above should go to standard output
      try {
        retval=p.waitFor(); 
      }
      catch (InterruptedException e) {}

      String line;
      if(reader.ready()) {
        line = reader.readLine();
      }
      else {
        line = null;
      }

      while (line!=null) {
        if(reader.ready()) {
          line = reader.readLine();
        }
        else {
          line = null;
        }
      }
    } catch (IOException e) {
      println(e.getMessage());
      if(e.getMessage().startsWith("Cannot run program")) {
        println("It is necessary to install the graphviz package that includes the dot program in order to convert .gv files directly to graphical output files");
      }
      retval = 999;
    }
    return (retval == 0);
  }

  
  private static boolean compileJava(UmpleElement aClass, UmpleModel model, boolean useExec, boolean beQuiet, String errorFileName, String args) {
    String path="";
    String base="";
    for (GenerateTarget gt : model.getGenerates()) {
      if (gt.getLanguage().equals("Java")) {
        base = StringFormatter.addPathOrAbsolute( 
            model.getUmpleFile().getPath() +File.separator+ gt.getPath(), "");
        path = base + aClass.getPackageName().replace(".", File.separator);
      }
    }
    String filename = path + File.separator + aClass.getName() + ".java";
    boolean successful = true;
    PipedOutputStream out = null;

    try {
      if(base.contains(" ") && !(beQuiet && subsequentCompilation)) {
        System.err.println("Warning: Compiling generated Java from a directory or path containing a space character may produce an error message from the Java compiler.");
      }
      
      BufferedReader reader;
      
      // Method 1: Use tool provider
      if(!useExec) {
        // Determine a safe size of the output stream to capture any error messages
        // The larger the file the more error messages are likely
        // There were crashes when the buffer was not large enough for the number of messages
        File theFile = new File(filename);
        int bufferSizeToUse = Math.max(16384,((int)theFile.length() )*3);

        PipedInputStream in = new PipedInputStream(bufferSizeToUse);
        out = new PipedOutputStream(in);
        JavaCompiler compiler = ToolProvider.getSystemJavaCompiler();
        compiler.run(null, null, out, "-cp",base,filename);

        reader=new BufferedReader(new InputStreamReader(in)); 
      }
      // Method 2: Use exec to compile files
      // This older approach seemed to use more CPU resources but may be more reliable
      else {
        Process p = Runtime.getRuntime().exec("javac -cp " + base + " " +filename+args);
        reader=new BufferedReader(new InputStreamReader(p.getErrorStream())); 
      }
      String line;

      if(reader.ready()) {
        line = reader.readLine();
      }
      else {
        line = null;
      }

      StringBuilder builder = new StringBuilder();

      while (line!=null) {
        System.err.println(translateLineToUmple(line, model));
        builder = builder.append(translateLineToUmple(line, model)+"\n");
        if(reader.ready()) {
          line = reader.readLine();
        }
        else {
          line = null;
        }
        successful = false;
      }

      // Write to the error file if given
      if(!successful && errorFileName != null) {
        String error = builder.toString().trim();
          try
          {
            File newFile = new File(errorFileName);
            newFile.createNewFile();   
          }
          catch (IOException ex)  
          {
            System.err.println(ex);
          }

          // Write to the file
          try (PrintWriter fileout = new PrintWriter(errorFileName)) 
          {
            fileout.println(error);
          }  
          catch (FileNotFoundException ex) 
          {
            System.err.println(ex);
          }
      }

    } catch (IOException e) {
      println(e.getMessage());
    }
    finally {
      if (out != null) {
        // close the PipedOutputStream cleanly
        try {
          out.close();
        }
        catch (IOException e) {} 
      }
    }
    
    return successful;
  }

  // Reads the start of a file, noting when the rest was left out, so a runaway child cannot exhaust memory.
  private static String readAtMost(File file, int limit) throws IOException {
    try (InputStream in = new FileInputStream(file)) {
      byte[] buffer = new byte[limit];
      int total = 0;
      int read;
      while (total < limit && (read = in.read(buffer, total, limit - total)) > 0) {
        total += read;
      }
      String text = new String(buffer, 0, total);
      return file.length() > limit ? text + "\n[output truncated after " + limit + " bytes]\n" : text;
    }
  }

  // Annotates each Python traceback frame that falls inside code copied from the model with its
  // model location, for example "[model.ump:12]". Generated Python brackets every such region with
  // a "# line N" comment naming the file and an "# end line" comment; frames elsewhere are left
  // as they are. pathPrefix, when given, maps a path the traceback reports (such as a container
  // path) to a readable local path: it is a two-element array {reportedPrefix, localPrefix}.
  public static String mapPythonTraceback(String text, String[] pathPrefix) {
    Pattern pythonFrame = Pattern.compile("^\\s*File \"([^\"]+\\.py)\", line (\\d{1,9})\\b");
    StringBuilder mapped = new StringBuilder();
    for (String line : text.split("\n", -1)) {
      String ending = line.endsWith("\r") ? "\r" : "";
      String content = line.substring(0, line.length() - ending.length());
      mapped.append(content);
      Matcher frame = pythonFrame.matcher(content);
      if (frame.find()) {
        String path = frame.group(1);
        if (pathPrefix != null && path.startsWith(pathPrefix[0])) {
          path = pathPrefix[1] + path.substring(pathPrefix[0].length());
        }
        String location = modelLocation(path, Integer.parseInt(frame.group(2)));
        if (location != null) {
          mapped.append(" [").append(location).append("]");
        }
      }
      mapped.append(ending).append("\n");
    }
    return mapped.substring(0, mapped.length() - 1);
  }

  private static String modelLocation(String pythonPath, int pythonLine) {
    Pattern regionStart = Pattern.compile("^\\s*# line (\\d{1,9}) \"([^\"]+)\"\\s*$");
    Pattern regionEnd = Pattern.compile("^\\s*# end line\\s*$");
    List<String> lines;
    try {
      lines = new ArrayList<String>(java.nio.file.Files.readAllLines(new File(pythonPath).toPath()));
    }
    catch (IOException | RuntimeException e) {
      return null;
    }
    // A line inside a string literal is text, even when it looks like a marker.
    boolean[] insideString = PythonSource.linesInsideStrings(lines);
    for (int i = 0; i < lines.size(); i++) {
      if (insideString[i]) {
        lines.set(i, "");
      }
    }
    if (pythonLine < 1 || pythonLine > lines.size()
        || regionStart.matcher(lines.get(pythonLine - 1)).matches() || regionEnd.matcher(lines.get(pythonLine - 1)).matches()) {
      return null;
    }
    // The reported line must lie inside a region: the nearest marker above it is a start marker,
    // and the nearest marker below it is an end marker.
    Matcher start = null;
    int startIndex = -1;
    for (int i = pythonLine - 2; i >= 0 && start == null; i--) {
      if (regionEnd.matcher(lines.get(i)).matches()) {
        return null;
      }
      Matcher candidate = regionStart.matcher(lines.get(i));
      if (candidate.matches()) {
        start = candidate;
        startIndex = i;
      }
    }
    if (start == null) {
      return null;
    }
    for (int i = pythonLine; i < lines.size(); i++) {
      if (regionEnd.matcher(lines.get(i)).matches()) {
        int modelLine = Integer.parseInt(start.group(1)) + (pythonLine - 1) - (startIndex + 1);
        return start.group(2) + ":" + modelLine;
      }
      if (regionStart.matcher(lines.get(i)).matches()) {
        return null;
      }
    }
    return null;
  }

  // To do: Use model to determine generation path
  private static String translateLineToUmple(String line, UmpleModel model) {
    String modifiedLine = line;
    StackTraceElement ust;
    String javaFileName;
    int javaLineNumber;
    String lineParts[] = null;
    if(File.separator.equals("\\")) {
    	// Windows System
    	String tempLineParts[] = line.split(":", 4);
    	if(tempLineParts.length == 4) {
    		lineParts = new String[3];
    		lineParts[0] = tempLineParts[0] + ":" + tempLineParts[1];
    		lineParts[1] = tempLineParts[2];
    		lineParts[2] = tempLineParts[3];
    	} else {
    		lineParts = line.split(":",3);
    	}
    }
    
    else {
    	// Mac or Linux
    	lineParts = line.split(":",3);
    }
    
    // Case 1: No colons so nothing to translate
    if(lineParts.length < 3) {
      return line;
    }
    
    // case 2: no colon before .java, so nothing to translate
    if (!lineParts[0].endsWith(".java")) {
      return line;
    }
    
    // We have a line that needs translating
    String javaFileParts[] =
      lineParts[0].split("\\"+System.getProperty("file.separator"),-1);
    String javaFile = lineParts[0];//javaFileParts[javaFileParts.length-1];
    
    String declaringClass = javaFile.substring(0,javaFile.length()-5);
    for(int i=javaFileParts.length-2; i>=0 ; i--) {
      if(!javaFileParts[i].equals(".")) {
        declaringClass = javaFileParts[i]+"."+declaringClass;
      }
    }
    // System.err.println("**"+declaringClass+"**"+javaFile); //debug
    
    //Code Smell: javaToUmpleStackTrace needs to not be static
    ust = cruise.umple.util.ExceptionDumper.javaToUmpleStackTrace(
      new StackTraceElement(
        declaringClass,
        "",
        javaFile,
        Integer.parseInt(lineParts[1])),  "");
    
    // System.err.println("*"+lineParts[0]+"*"); // Debug
    
    if(ust==null) {
      return line;
    }
    return(ust.getFileName()+":"+ust.getLineNumber()+":"+lineParts[2]);
  }

  private static void println(String output)
  {
    console += output + System.lineSeparator();
    System.out.println(output);
  }

  public static String getSimpleFileName(String fileName)
  {

    int lastIndex = fileName.lastIndexOf("/");
    if (lastIndex == -1)
    {
      return fileName;
    }
    else
    {
      return fileName.substring(lastIndex+1, fileName.length());
    }
  }
  
  // Classes with a "public static void main" whose body exists in the given target language.
  public static List<UmpleClass> getMainClasses(UmpleModel model, String language)
  {
    List<UmpleClass> mainClasses = new ArrayList<UmpleClass>();
    for (UmpleClass uClass : model.getUmpleClasses())
    {
      for (Method aMethod : uClass.getMethods())
      {
        if ("Python".equals(language))
        {
          // Python mains are chosen by the same rule the generator uses to emit them
          if (PythonGenerator.isPythonMain(aMethod) && uClass.getOuterClass() == null)
          {
            mainClasses.add(uClass);
            break;
          }
          continue;
        }
        if (!aMethod.getExistsInLanguage(language))
        {
          continue;
        }
        String methodModifier = aMethod.getModifier().equals("") ? "public" : aMethod.getModifier();
        if (aMethod.getName().equals("main") && aMethod.getType().equals("void")
            && methodModifier.contains("public") && methodModifier.contains("static"))
        {
          mainClasses.add(uClass);
          break;
        }
      }
    }
    return mainClasses;
  }

}
