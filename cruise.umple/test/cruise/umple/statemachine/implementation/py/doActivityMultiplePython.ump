generate Python;
namespace example;

// A do activity in each of two states of one machine
class Lamp
{
  status
  {
    On
    {
      press -> Off;
      do Python { self.alsoDo() }
    }
    
    Off 
    {
      press -> On;
      do Python { self.keepDoing() }
    }
  }
  void alsoDo() Python { pass }
  void keepDoing() Python { pass }
}
