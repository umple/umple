
namespace cruise.attributes.test;

class DoorA
{
  immutable DoorB doorId = new DoorB(5);
  immutable Date dateId = date(1234);
  immutable Time timeId = time();
}

class DoorD
{
  defaulted DoorB doorId = new DoorB(5);
  defaulted Date dateId = date(1234);
  defaulted Time timeId = time();
}


class DoorE
{
  Date d4 = date("1978-12-04");
}

class DoorF
{
  Time d4 = date("12:53:54");
}

// Value-equal objects that differ only through associations leading back to each other
class EqCourse
{
  code;
  1 -- 0..1 EqInstructor instructor;
}

class EqDepartment
{
  1 -- * EqCourse courses;
  1 -- * EqInstructor instructors;
}

class EqInstructor
{
  name;
}

class EqMentor
{
  name;
  1 -- * EqStudent students;
}

class EqStudent
{
  name;
}
