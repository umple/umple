namespace cruise.usercode.constraints;

class ContractOverloads
{
  int n = 1;
  String text = "a";
  int pick(int n) Python { return -3 } Java { return -3; }
  double pick(String s) Python { return -3.0 } Java { return -3.0; }
  double arity() Python { return -3.0 } Java { return -3.0; }
  int arity(int a, int b) Python { return -3 } Java { return -3; }
  int integral() Python { [pre: (pick(1) / 2) == -1] return 7 }
    Java { [pre: (pick(1) / 2) == -1] return 7; }
  int fractional() Python { [pre: (pick("a") / 2) == -1.5] return 7 }
    Java { [pre: (pick("a") / 2) == -1.5] return 7; }
  int remainder() Python { [pre: (pick(n) % 2) == -1] return 7 }
    Java { [pre: (pick(n) % 2) == -1] return 7; }
  int parameter(String s) Python { [pre: (pick(s) / 2) == -1.5] return 7 }
    Java { [pre: (pick(s) / 2) == -1.5] return 7; }
  int getter() Python { [pre: (pick(getText()) / 2) == -1.5] return 7 }
    Java { [pre: (pick(getText()) / 2) == -1.5] return 7; }
  int noArguments() Python { [pre: (arity() / 2) == -1.5] return 7 }
    Java { [pre: (arity() / 2) == -1.5] return 7; }
  int twoArguments() Python { [pre: (arity(1, 2) / 2) == -1] return 7 }
    Java { [pre: (arity(1, 2) / 2) == -1] return 7; }
}

