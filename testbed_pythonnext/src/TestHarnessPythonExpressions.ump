}

class UncertainPromotion
{
  ChoiceB b;
  long unit = 1L;
  int distance = 64;
  int trace = 0;
  int pick(ChoiceA value) Python { self.setTrace(self.getTrace() * 10 + 1); return 8 }
    Java { setTrace(getTrace() * 10 + 1); return 8; }
  long pick(ChoiceB value) Python { self.setTrace(self.getTrace() * 10 + 1); return 8 }
    Java { setTrace(getTrace() * 10 + 1); return 8L; }
  long negative(ChoiceA value) Python { return -3 } Java { return -3L; }
  int negative(ChoiceB value) Python { return -3 } Java { return -3; }
  long nextUnit() Python { self.setTrace(self.getTrace() * 10 + 2); return self.getUnit() }
    Java { setTrace(getTrace() * 10 + 2); return getUnit(); }
  int nextDistance() Python { self.setTrace(self.getTrace() * 10 + 3); return self.getDistance() }
    Java { setTrace(getTrace() * 10 + 3); return getDistance(); }
  int productRight(int count, long expected) Python { [pre: (pick(b) * unit >> count) == expected] return 7 }
    Java { [pre: (pick(b) * unit >> count) == expected] return 7; }
  int productLeft(int count, long expected) Python { [pre: (pick(b) * unit << count) == expected] return 7 }
    Java { [pre: (pick(b) * unit << count) == expected] return 7; }
  int reversedRight(int count, long expected) Python { [pre: (unit * pick(b) >> count) == expected] return 7 }
    Java { [pre: (unit * pick(b) >> count) == expected] return 7; }
  int reversedLeft(int count, long expected) Python { [pre: (unit * pick(b) << count) == expected] return 7 }
    Java { [pre: (unit * pick(b) << count) == expected] return 7; }
  int parameterRight(int count, long expected, long scale) Python { [pre: (pick(b) * scale >> count) == expected] return 7 }
    Java { [pre: (pick(b) * scale >> count) == expected] return 7; }
  int parameterLeft(int count, long expected, long scale) Python { [pre: (pick(b) * scale << count) == expected] return 7 }
    Java { [pre: (pick(b) * scale << count) == expected] return 7; }
  int dividedRight(int count, long expected) Python { [pre: (negative(b) / unit >> count) == expected] return 7 }
    Java { [pre: (negative(b) / unit >> count) == expected] return 7; }
  int dividedLeft(int count, long expected) Python { [pre: (negative(b) / unit << count) == expected] return 7 }
    Java { [pre: (negative(b) / unit << count) == expected] return 7; }
  int remainderRight(int count, long expected) Python { [pre: (negative(b) % unit >> count) == expected] return 7 }
    Java { [pre: (negative(b) % unit >> count) == expected] return 7; }
  int remainderLeft(int count, long expected) Python { [pre: (negative(b) % unit << count) == expected] return 7 }
    Java { [pre: (negative(b) % unit << count) == expected] return 7; }
  int ordered(long expected) Python { [pre: (pick(b) * nextUnit() >> nextDistance()) == expected] return 7 }
    Java { [pre: (pick(b) * nextUnit() >> nextDistance()) == expected] return 7; }
}
