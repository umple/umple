%This file redefines types from Java.Grm to match javascript syntax
include "../../UmpleToPython/txl/Java.Grm"



%Num of char in a line before TXL splits it in two.
%Putting it super large so lines are not split when they are too long
#pragma -width 1073741824

%Same indentation as the java generated by Umple
#pragma -in 2

%The java grammar reads && and || as two tokens. They are written without a space between them
redefine boolean_operator
        '& [SPOFF] '& [SPON]
    |   '| [SPOFF] '| [SPON]
end redefine

%Same layout as else_if and else in the java grammar
redefine if
        'if '( [value] ') [NL] '{ [NL] [IN] [repeat statement] [EX] '} [NL]
    |   'if '( [value] ') [statement]
end redefine

redefine for_in_loop
    ...
    |   'for '( [double_value] 'of [value] ') '{ [NL] [IN] [repeat statement] [EX] '} [NL]
end redefine

redefine base_value
    ...
    |   '[ ']
end redefine

redefine double_value
    ...
    |   'let [value]
end redefine

redefine method_parameter
    ...
    | [id]
end redefine

redefine concrete_method_declaration
    ...
    |   [opt static] [id] [SPOFF] '( [SPON] [list method_parameter] [SPOFF] ') [SPON] [NL] '{ [NL] [IN] [method_content] [EX] '} [NL]
end redefine

redefine constructor
    ...
    |   'constructor [SPOFF] '( [SPON] [list method_parameter] [SPOFF] ') [SPON] [NL] '{ [NL] [IN] [repeat statement] [EX] '} [NL]
end redefine

redefine concrete_class_declaration
    ...
    |   [opt require_statement] 'class [nested_identifier] [opt extends_group] [NL] '{ [NL] [IN] [class_body_decl] [EX] '} [NL] [NL] [module_exports]
end redefine

%CommonJS: the superclass is the only other generated class needed when the class is defined
define require_statement
    'const [id] '= 'require [SPOFF] '( [stringlit] '); [SPON] [NL] [NL]
end define

define extends_group
    'extends [nested_identifier]
end define

define module_exports
    'module [SPOFF] '. 'exports [SPON] '= [id] [SPOFF] '; [SPON] [NL]
end define
