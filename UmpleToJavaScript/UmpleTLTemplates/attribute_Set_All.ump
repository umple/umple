use attribute_Set.ump;
use attribute_SetDefaulted.ump;
use attribute_SetImmutable.ump;

class UmpleToJavaScript {
    attribute_Set_All <<!<</*attribute_Set_All*/>><<#
  for (Attribute av : uClass.getAttributes())
  {
    if (av.isConstant() || av.getIsAutounique() || "internal".equals(av.getModifier()) || av.getIsDerived())
    {
      continue;
    }

    if (av.isImmutable())
    {
      if (av.getIsLazy() || av.getIsUnique())
      {
        #>><<@ UmpleToJavaScript.attribute_SetImmutable >><<#
      }
    }
    else if (av.getModifier().equals("defaulted"))
    {
      #>><<@ UmpleToJavaScript.attribute_SetDefaulted >><<#
    }
    else
    {
      #>><<@ UmpleToJavaScript.attribute_Set >><<#
    }
  }
#>>!>>
}
