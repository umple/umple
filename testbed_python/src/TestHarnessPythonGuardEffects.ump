      go [ready(15)] -> B;
      go [ready(16)] -> B;
      go [ready(17)] -> B;
      go [ready(18)] -> B;
      go [ready(19)] -> B;
      go [ready(20)] -> B;
      go [ready(21)] -> B;
      go [ready(22)] -> B;
      go [ready(23)] -> B;
      go [ready(24)] -> B;
      go [ready(25)] -> B;
      go [ready(26)] -> B;
      go [ready(27)] -> B;
      go [ready(28)] -> B;
      go [ready(29)] -> B;
      go [ready(30)] -> B;
      go [ready(31)] -> B;
      go [ready(32)] -> B;
      go [ready(33)] -> B;
      go [ready(34)] -> B;
