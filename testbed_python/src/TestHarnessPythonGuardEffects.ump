class SmGuardPeer {}
class SmGuardAssociationExit {
  0..1 -> 0..1 SmGuardPeer peer;
  after getPeer Python { self.setSm(self.Sm.A) }
  sm { A { go [peer == null] -> B; go -> B; } B {} }
}
class SmGuardAssociationCountExit {
  0..1 -> 0..3 SmGuardPeer peers;
  before numberOfPeers Python { self.setSm(self.Sm.A) }
  sm { A { go [numberOfPeers() == 0] -> B; go -> B; } B {} }
}
class SmGuardEventCall {
  sm { A { go [leave()] -> B; go -> B; leave -> C; } B {} C {} }
}
class SmGuardEventReject {
  sm { A { go [!leave()] -> B; go -> B; leave -> C; } B {} C {} }
}
class SmGuardEventReentry {
  sm { A { go [reset()] -> B; go -> B; reset -> A; } B {} }
}
class SmGuardSharedEvent {
  Integer calls = 0;
  Boolean ready() Python { self.setCalls(self.getCalls() + 1); return True }
  first { A { go [ready()] -> B; go -> C; } B {} C {} }
  second { A { go [ready()] -> B; go -> C; } B {} C {} }
}
class SmGuardMatchedLocal {
  String log = "";
  before go Python { matched2 = 2 }
  after go Python { self.setLog(self.getLog() + str(matched2)) }
  Boolean ready() Python { return True }
  sm {
    A {
      go(Boolean matched) [matched] / Python { matched3 = 3; self.setLog(str(matched3)) } -> B;
      go(Boolean matched) [ready()] / Python { self.setLog("called;") } -> B;
      go(Boolean matched) -> C;
    }
    B {} C {}
  }
}
class SmGuardManyAlternatives {
  Integer choice = 99;
  Integer stop = -1;
  Boolean deleting = false;
  String log = "";
  Boolean ready(Integer n) Python {
    self.setLog(self.getLog() + str(n) + ";")
    if n == self.getStop():
      if self.getDeleting():
        self.delete()
      else:
        self.setSm(self.Sm.A)
    return n >= self.getChoice()
  }
  sm {
    A {
      go [ready(0)] -> B;
      go [ready(1)] -> B;
      go [ready(2)] -> B;
      go [ready(3)] -> B;
      go [ready(4)] -> B;
      go [ready(5)] -> B;
      go [ready(6)] -> B;
      go [ready(7)] -> B;
      go [ready(8)] -> B;
      go [ready(9)] -> B;
