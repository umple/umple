// A computed default runs model code in its default getter and in reset; armed lets construction,
// which also evaluates the default, finish first.
class SmGuardDefaultExit {
 String log = "";
 Boolean armed = false;
 defaulted Boolean enabled = ready();
 Boolean ready() Python {
   if self.getArmed():
     self.exitSm()
   return True
 }
 sm {
   A { after(30) [getDefaultEnabled()] / { setLog(getLog()+"action;"); } -> B; }
   B { entry / { setLog(getLog()+"entry;"); } after(30) [false] -> C; }
   C {}
 }
}
class SmGuardResetExit {
 String log = "";
 Boolean armed = false;
 defaulted Boolean enabled = ready();
 Boolean ready() Python {
   if self.getArmed():
     self.exitSm()
   return True
 }
 sm {
   A { after(30) [resetEnabled()] / { setLog(getLog()+"action;"); } -> B; }
   B { entry / { setLog(getLog()+"entry;"); } after(30) [false] -> C; }
   C {}
 }
}

// this.enabled reads the attribute, and its getter's injection, although a parameter has its name.
class SmGuardThisRead {
 Boolean enabled = true;
 before getEnabled Python { self.setSm(self.Sm.C) }
 sm { A { go(Boolean enabled) [this.enabled] -> B; go(Boolean enabled) -> B; } B {} C {} }
}

// The same through an attribute inherited from a parent, which the parser leaves unresolved.
class SmGuardThisBase {
 Boolean enabled = true;
 before getEnabled Python { self.setSm(self.Sm.C) }
}
class SmGuardInheritedThisRead {
 isA SmGuardThisBase;
 sm { A { go(Boolean enabled) [this.enabled] -> B; go(Boolean enabled) -> B; } B {} C {} }
}

