// Accessor and event guards can end a visit before the outer transition continues.
namespace cruise.sm;

class SmGuardGetterExit {
 String log = "";
 Boolean enabled = true;
 before getEnabled Python { self.exitSm() }
 sm {
   A { after(30) [getEnabled()] / { setLog(getLog()+"action;"); } -> B; }
   B { entry / { setLog(getLog()+"entry;"); } after(30) [false] -> C; }
   C {}
 }
}
class SmGuardDerivedExit {
 String log = "";
 Boolean enabled = { ready() }
 Boolean ready() Python { self.exitSm(); return True }
 sm {
   A { after(30) [enabled] / { setLog(getLog()+"action;"); } -> B; }
   B { entry / { setLog(getLog()+"entry;"); } after(30) [false] -> C; }
   C {}
 }
}
