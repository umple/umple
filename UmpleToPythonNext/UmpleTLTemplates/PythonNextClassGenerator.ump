use UmpleNotice.ump;
use members_AllStatics.ump;
use enumerations_All.ump;
use state_machine_Enums_All.ump;
use state_machine_Runtime_All.ump;
use constructor_Declare_All.ump;
use constructor_StateMachineFields_All.ump;
use constructor_DeclareOneToOne.ump;
use constructor_Association_All.ump;
use constructor_StateMachine_All.ump;
use attribute_Set_All.ump;
use attribute_Get_All.ump;
use attribute_IsBoolean_All.ump;
use state_machine_Get_All.ump;
use state_machine_Events_All.ump;
use state_machine_Set_All.ump;
use state_machine_StateDependentMethods_All.ump;
use association_Get_All.ump;
use association_Set_All.ump;
use equals.ump;
use delete_All.ump;
use delete_Association_All.ump;
use delete_StateMachine_All.ump;
use class_MethodDeclaration.ump;
use toString.ump;
use extraCode.ump;

namespace cruise.umple.compiler.pythonnext;

external interface ILang{}

class PythonNextClassGenerator {
    depend cruise.umple.compiler.*;
    depend cruise.umple.compiler.exceptions.*;
    depend cruise.umple.util.*;
    depend java.util.*;

    isA ILang;

    // Marks where the imports go; they are known only after the class body has been generated.
    const String IMPORTS = "#<<IMPORTS>>";

    emit getCode(UmpleModel model, UmpleElement uElement)(PythonNextClassGenerator);

    // Each included selector owns one part of the class, in the order of the Java output.
    PythonNextClassGenerator <<!<</*PythonNextClassGenerator*/>><<#
  UmpleClass uClass = (UmpleClass) uElement;
  PythonNextGenerator gen = (PythonNextGenerator) GeneratorHelper.generator;
  // A nested class is generated as its own text and placed, re-indented, inside its outer class.
  boolean nested = uClass.hasOuterClass();
  if (!nested)
  {
    #>><<@ UmpleToPythonNext.UmpleNotice >><<#
    realSb.append("\n" + IMPORTS + "\n\n");
  }
  String bases = gen.translate("isA", uClass);
  #>>class <<=uClass.getName()>><<=bases>>:<<=gen.docstring(uClass.getComments(), "    ")>><<@ UmpleToPythonNext.enumerations_All >><<@ UmpleToPythonNext.state_machine_Enums_All >><<@ UmpleToPythonNext.members_AllStatics >><<#
  for (UmpleClass inner : gen.innerClasses(uClass))
  {
    realSb.append("\n" + PythonSource.reindent(new PythonNextClassGenerator().getCode(model, inner), "", "    "));
  }
  #>><<@ UmpleToPythonNext.state_machine_Runtime_All >><<@ UmpleToPythonNext.constructor_Declare_All >><<@ UmpleToPythonNext.attribute_Set_All >><<@ UmpleToPythonNext.attribute_Get_All >><<@ UmpleToPythonNext.attribute_IsBoolean_All >><<@ UmpleToPythonNext.state_machine_Get_All >><<@ UmpleToPythonNext.state_machine_Events_All >><<@ UmpleToPythonNext.state_machine_Set_All >><<@ UmpleToPythonNext.state_machine_StateDependentMethods_All >><<@ UmpleToPythonNext.association_Get_All >><<@ UmpleToPythonNext.association_Set_All >><<@ UmpleToPythonNext.equals >><<@ UmpleToPythonNext.delete_All >><<@ UmpleToPythonNext.class_MethodDeclaration >><<@ UmpleToPythonNext.toString >><<#
  // Before extra code, whose native definitions may redefine a generated method on purpose
  gen.mergeSameNameMethods(uClass, realSb);
  #>><<@ UmpleToPythonNext.extraCode >><<#
  gen.finishClass(realSb, nested ? null : IMPORTS); // a nested class's imports go to its module
#>>!>>
}
