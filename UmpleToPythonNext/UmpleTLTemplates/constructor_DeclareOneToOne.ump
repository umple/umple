use constructor_AssociationCreateOneToOne.ump;

class UmpleToPythonNext {
    // In a mandatory one-to-one pair, __init__ creates the partner and alternateConstructor, which the
    // partner's constructor calls, takes an existing one. Its body is an instance method
    // (oneOneAlternateInit) built like __init__, so a subclass initializes its parent part in place
    // with it (oneOneParentInit). It is called through __class__, which neither a subclass's method
    // nor a parameter named like the class can hide.
    constructor_DeclareOneToOne <<!<</*constructor_DeclareOneToOne*/>><<#
  if (createsPartners)
  {
    createsPartners = false;
    String alternateParameters = uClass.getGeneratedClass().getLookup(PythonNextGenerator.CONSTRUCTOR_PARAMETERS);
    String separator = alternateParameters.isEmpty() ? "" : ", ";
    String alternateInit = gen.oneOneAlternateInit(uClass);
    #>>

    @classmethod
    def alternateConstructor(cls<<=separator + alternateParameters>>):
        self = cls.__new__(cls)
        __class__.<<=alternateInit>>(self<<=separator + alternateParameters>>)
        return self

    def <<=alternateInit>>(self<<=separator + alternateParameters>>):<<#
    for (String line : fieldLines)
    {
      realSb.append("\n        ").append(line);
    }
    #>><<@ UmpleToPythonNext.constructor_StateMachineFields_All >><<#
    if (parent != null)
    {
      realSb.append("\n        " + gen.oneOneParentInit(parent));
      realSb.append(gen.ancestorDeletedCheck(uClass));
    }
    List<MethodParameter> alternateMethodParameters = new ArrayList<MethodParameter>();
    for (String name : alternateParameters.split(","))
    {
      if (!name.trim().isEmpty())
      {
        alternateMethodParameters.add(gen.parameter(name.trim().replace("*", ""), ""));
      }
    }
    realSb.append(gen.injections(uClass, "before", "constructor", alternateMethodParameters, false, "        "));
    for (String line : codeLines)
    {
      realSb.append("\n        ").append(line);
    }
    #>><<@ UmpleToPythonNext.constructor_Association_All >><<@ UmpleToPythonNext.constructor_StateMachine_All >><<#
    realSb.append(gen.invariantChecks(uClass));
    realSb.append(gen.injections(uClass, "after", "constructor", alternateMethodParameters, false, "        "));
  }
#>>!>>
}
