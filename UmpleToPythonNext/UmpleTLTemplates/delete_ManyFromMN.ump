        <<=gen.translate("parameterCopyOfMany", av)>> = tuple(<<=field>>)
        <<=field>>.clear()
        for <<=parameter>> in <<=gen.translate("parameterCopyOfMany", av)>>:
            if <<=parameter>>.<<=gen.relatedTranslate("numberOfMethod", av)>>() <= <<=relatedClass[0]>>.<<=gen.relatedTranslate("minimumNumberOfMethod", av)>>():
                <<=parameter>>.delete()
            else:
