use state_machine_GetFull.ump;
use state_machine_Get.ump;

class UmpleToPythonNext {
    // The full-name getter of each machine, then the state getter of each machine and nested machine.
    state_machine_Get_All <<!<</*state_machine_Get_All*/>><<#
{
  for (StateMachine sm : uClass.getStateMachines())
  {
    #>><<@ UmpleToPythonNext.state_machine_GetFull >><<#
  }
  for (StateMachine sm : uClass.getAllStateMachines())
  {
    #>><<@ UmpleToPythonNext.state_machine_Get >><<#
  }
}
#>>!>>
}
