class UmpleToPythonNext {
    // Keyed classes compare and hash by their key, like Java's equals and hashCode. The hash is
    // computed once, and from then on the key members can no longer change, so the object never
    // moves inside a set or dictionary.
    equals <<!<</*equals*/>><<#
  if (uClass.getKey().isProvided())
  {
  List<String> values = new ArrayList<String>();
  List<String> otherValues = new ArrayList<String>();
  List<String> freeze = new ArrayList<String>();
  for (String memberId : uClass.getKey().getMembers())
  {
    Attribute av = uClass.getAttribute(memberId);
    AssociationVariable as = uClass.getAssociationVariable(memberId);
    if (av != null)
    {
      String getter = av.getIsList() ? "tuple({0}." + gen.translate("getManyMethod", av) + "())" : "{0}." + gen.translate("getMethod", av) + "()";
      values.add(getter.replace("{0}", "self"));
      otherValues.add(getter.replace("{0}", "obj"));
      if (!av.isImmutable() || av.getIsLazy())
      {
        freeze.add(gen.canSetField(uClass, av) + " = False");
      }
    }
    else if (as != null)
    {
      String getter = "{0}." + gen.translate(as.isMany() ? "getManyMethod" : "getMethod", as) + "()";
      values.add(getter.replace("{0}", "self"));
      otherValues.add(getter.replace("{0}", "obj"));
      freeze.add(gen.canSetField(uClass, as) + " = False");
    }
  }
  String key = values.size() == 1 ? values.get(0) : "(" + String.join(", ", values) + ")";
  String otherKey = otherValues.size() == 1 ? otherValues.get(0) : "(" + String.join(", ", otherValues) + ")";
  String hashCache = gen.hashCacheField(uClass);
  #>>

    def __eq__(self, obj):
        if type(obj) is not type(self):
            return NotImplemented
        return <<=key>> == <<=otherKey>>

    def __hash__(self):
        if <<=hashCache>> is None:
            <<=hashCache>> = hash(<<=values.size() == 1 ? "(" + key + ",)" : key>>)<<#
  for (String line : freeze)
  {
    #>>
            <<=line>><<#
  }
  #>>
        return <<=hashCache>>

    def equals(self, obj):
        return self == obj<<#
  }
#>>!>>
}
