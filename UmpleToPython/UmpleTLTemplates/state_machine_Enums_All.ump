class UmpleToPython {
    // A nested Enum for each state machine and nested machine, in Java's order. Values are the state
    // names, so str() gives the name.
    state_machine_Enums_All <<!<</*state_machine_Enums_All*/>><<#
{
  for (StateMachine rootSm : uClass.getStateMachines())
  {
    List<StateMachine> machines = new ArrayList<StateMachine>();
    machines.add(rootSm);
    machines.addAll(rootSm.getNestedStateMachines());
    for (StateMachine sm : machines)
    {
      String enumBase = gen.standardName("enum", "Enum");
      #>>

    class <<=gen.translate("type", sm)>>(<<=enumBase>>):<<#
      for (State state : sm.getStates())
      {
        #>>
        <<=gen.translate("stateOne", state)>> = <<=gen.pythonString(gen.translate("stateOne", state))>><<#
      }
      #>>

        def __str__(self):
            return self.value<<#
    }
  }
}
#>>!>>
}
