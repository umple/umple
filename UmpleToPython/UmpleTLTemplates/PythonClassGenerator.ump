use UmpleNotice.ump;
use members_AllStatics.ump;
use enumerations_All.ump;
use state_machine_Enums_All.ump;
use state_machine_Runtime_All.ump;
use constructor_Declare_All.ump;
use constructor_StateMachineFields_All.ump;
use constructor_DeclareOneToOne.ump;
use constructor_Association_All.ump;
use constructor_StateMachine_All.ump;
use attribute_Set_All.ump;
use attribute_Get_All.ump;
use attribute_IsBoolean_All.ump;
use state_machine_Get_All.ump;
use state_machine_Events_All.ump;
use state_machine_Set_All.ump;
use state_machine_StateDependentMethods_All.ump;
use association_Get_All.ump;
use association_Set_All.ump;
use equals.ump;
use delete_All.ump;
use delete_Association_All.ump;
use delete_StateMachine_All.ump;
use class_MethodDeclaration.ump;
use toString.ump;
use extraCode.ump;

namespace cruise.umple.compiler.python;

external interface ILang{}

class PythonClassGenerator {
    depend cruise.umple.compiler.*;
    depend cruise.umple.compiler.exceptions.*;
    depend cruise.umple.util.*;
    depend java.util.*;

    isA ILang;

    // Marks where the imports go; they are known only after the class body has been generated.
    const String IMPORTS = "#<<IMPORTS>>";

    emit getCode(UmpleModel model, UmpleElement uElement)(PythonClassGenerator);

    // The parts of the class follow the order of the Java output.
    PythonClassGenerator <<!<</*PythonClassGenerator*/>><<#
  UmpleClass uClass = (UmpleClass) uElement;
  PythonGenerator gen = (PythonGenerator) GeneratorHelper.generator;
  boolean nested = uClass.hasOuterClass();
  if (!nested)
  {
    #>><<@ UmpleToPython.UmpleNotice >><<#
    realSb.append("\n" + IMPORTS + "\n\n");
  }
  String bases = gen.translate("isA", uClass);
  #>>class <<=uClass.getName()>><<=bases>>:<<=gen.docstring(uClass.getComments(), uClass.getReqImplementations(), "    ")>><<@ UmpleToPython.enumerations_All >><<@ UmpleToPython.state_machine_Enums_All >><<@ UmpleToPython.members_AllStatics >><<#
  for (UmpleClass inner : gen.innerClasses(uClass))
  {
    realSb.append("\n" + PythonSource.reindent(new PythonClassGenerator().getCode(model, inner), "", "    "));
  }
  #>><<@ UmpleToPython.state_machine_Runtime_All >><<@ UmpleToPython.constructor_Declare_All >><<@ UmpleToPython.attribute_Set_All >><<@ UmpleToPython.attribute_Get_All >><<@ UmpleToPython.attribute_IsBoolean_All >><<@ UmpleToPython.state_machine_Get_All >><<@ UmpleToPython.state_machine_Events_All >><<@ UmpleToPython.state_machine_Set_All >><<@ UmpleToPython.state_machine_StateDependentMethods_All >><<@ UmpleToPython.association_Get_All >><<@ UmpleToPython.association_Set_All >><<@ UmpleToPython.equals >><<@ UmpleToPython.delete_All >><<@ UmpleToPython.class_MethodDeclaration >><<@ UmpleToPython.toString >><<#
  // Before extra code, whose native definitions may redefine a generated method on purpose
  gen.mergeSameNameMethods(uClass, realSb);
  #>><<@ UmpleToPython.extraCode >><<#
  gen.finishClass(uClass, realSb, nested ? null : IMPORTS); // a nested class's imports go to its module
#>>!>>
}
