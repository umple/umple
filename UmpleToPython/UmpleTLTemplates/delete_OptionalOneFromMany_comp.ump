class UmpleToPython {
    // A composition's many end whose objects may lose their owner: each is unlinked through its own
    // setter, then removed here if still present.
    delete_OptionalOneFromMany_comp <<!<</*delete_OptionalOneFromMany_comp*/>>
        while len(<<=field>>) > 0:
            <<=parameter>> = <<=field>>[0]
            <<=parameter>>.<<=gen.relatedTranslate("setMethod", av)>>(None)<<=gen.removeLink(field, parameter, "            ")>>!>>
}
