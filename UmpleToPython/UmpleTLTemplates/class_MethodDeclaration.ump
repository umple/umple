class UmpleToPython {
    // User methods in model order. Methods sharing a name form an overload group: numbered
    // implementations in model order plus a dispatcher under the name. A method with no
    // Python or untagged body is left out with warning 9212.
    class_MethodDeclaration <<!<</*class_MethodDeclaration*/>><<#
{
  Map<String, List<Method>> methodGroups = new LinkedHashMap<String, List<Method>>();
  for (Method aMethod : uClass.getMethods())
  {
    if (aMethod.getSource() == Method.Source.fAutoAPI)
    {
      continue;
    }
    if (!aMethod.getIsAbstract() && !aMethod.getIsImplemented() && PythonGenerator.pythonLanguage(aMethod) == null)
    {
      gen.warnNoPythonBody(aMethod);
      continue;
    }
    if (!methodGroups.containsKey(aMethod.getName()))
    {
      methodGroups.put(aMethod.getName(), new ArrayList<Method>());
    }
    methodGroups.get(aMethod.getName()).add(aMethod);
  }

  for (List<Method> group : methodGroups.values())
  {
    String groupName = group.get(0).getName();
    List<String> implementationNames = group.size() == 1 ? Arrays.asList(groupName) : gen.overloadNames(uClass, groupName, group.size(), "methods");
    List<List<MethodParameter>> groupParameters = new ArrayList<List<MethodParameter>>();
    boolean allStatic = true;
    boolean anyAbstract = false;
    for (int i = 0; i < group.size(); i++)
    {
      Method aMethod = group.get(i);
      groupParameters.add(aMethod.getMethodParameters());
      allStatic &= PythonGenerator.isStatic(aMethod);
      // Stubs are typed from their declarations too, for the merge with generated methods of their name
      if (aMethod.getIsAbstract())
      {
        anyAbstract = true;
        realSb.append(gen.emitted(uClass, aMethod, gen.abstractMethod(aMethod, implementationNames.get(i), group.size() > 1)));
      }
      else if (aMethod.getIsImplemented())
      {
        realSb.append(gen.emitted(uClass, aMethod, gen.interfaceStub(aMethod, implementationNames.get(i))));
      }
      else
      {
        realSb.append(gen.userMethod(uClass, aMethod, implementationNames.get(i)));
      }
    }
    if (group.size() > 1)
    {
      String dispatcher = gen.overloadDispatcher(uClass, groupName, allStatic, implementationNames, groupParameters);
      realSb.append(anyAbstract ? gen.abstractDispatcher(dispatcher) : dispatcher);
    }
  }
  realSb.append(gen.bindingHelper(uClass));
}
#>>!>>
}
