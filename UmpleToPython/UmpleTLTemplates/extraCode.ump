class UmpleToPython {
    // Extra class code is native Python. It is the last part of the class body, so the
    // launcher of a Python main, which follows the class at module level, comes here too.
    extraCode <<!<</*extraCode*/>><<#
{
  realSb.append(gen.classExtraCode(uClass));
  realSb.append(gen.mainLauncher(uClass));
}
#>>!>>
}
