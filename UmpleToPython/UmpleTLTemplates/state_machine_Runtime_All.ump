use state_machine_timedEvent_Handler.ump;
use state_machine_doActivityThread.ump;
use state_machine_MessageQueue.ump;

class UmpleToPython {
    // Class-level helpers of the state machine runtime: the timer handler, the do-activity worker and
    // the queue of queued and pooled machines and queued methods, with a pooled queue's predicate. All
    // run on non-daemon threads, so pending work keeps the process alive.
    state_machine_Runtime_All <<!<</*state_machine_Runtime_All*/>><<#
{
  List<Transition> timedTransitions = gen.timedTransitions(uClass);
  List<Activity> activities = gen.activities(uClass);
  String deleted = gen.deletedFlag(uClass);
  if (!timedTransitions.isEmpty())
  {
    String threading = gen.standardName("threading", null);
    #>><<@ UmpleToPython.state_machine_timedEvent_Handler >><<#
  }
  if (!activities.isEmpty())
  {
    String threading = gen.standardName("threading", null);
    #>><<@ UmpleToPython.state_machine_doActivityThread >><<#
  }
  if (gen.queuesEvents(uClass) || gen.queuesMethods(uClass))
  {
    String threading = gen.standardName("threading", null);
    #>><<@ UmpleToPython.state_machine_MessageQueue >><<#
  }
  if (gen.poolsEvents(uClass))
  {
    realSb.append(gen.poolPredicate(uClass));
  }
}
#>>!>>
}
