class UmpleToPython {
    members_AllStatics <<!<</*members_AllStatics*/>><<#
{
  int start = realSb.length();
  for (Constant aConstant : uClass.getConstants())
  {
    realSb.append(gen.classMember(uClass, aConstant));
  }
  for (Attribute av : gen.attributes(uClass))
  {
    if (av.isConstant())
    {
      realSb.append(gen.classMember(uClass, av.getName(), av));
    }
    else if (av.getIsAutounique())
    {
      realSb.append(av.getValue() == null ? "\n    next" + av.getUpperCaseName() + " = 1" : gen.classMember(uClass, "next" + av.getUpperCaseName(), av));
      realSb.append("\n    " + gen.uniqueMap(uClass, av) + " = {}");
    }
    else if (av.getIsUnique())
    {
      realSb.append("\n    " + gen.uniqueMap(uClass, av) + " = {}");
    }
  }
  if (uClass.getIsSingleton())
  {
    realSb.append("\n    theInstance = None");
  }
  String classMonitor = gen.classMonitor(uClass);
  if (classMonitor != null)
  {
    realSb.append("\n    " + classMonitor + " = " + gen.standardName("threading", "RLock") + "()");
  }
  if (realSb.length() > start)
  {
    realSb.insert(start, "\n");
  }
}
#>>!>>
}
