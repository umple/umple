use constructor_AssociationAssignUndirectionalOne.ump;
use constructor_AssociationAssignImmutableOptionalOne.ump;
use constructor_AssociationAssignMandatoryMany.ump;
use constructor_AssociationAssignImmutableOptionalN.ump;
use constructor_AssociationAssignImmutableOptionalMany.ump;
use constructor_AssociationAssignOptionalMany.ump;
use constructor_AssociationAssignOneToOne.ump;
use constructor_AssociationAssignDefault.ump;

class UmpleToPython {
    // Association part of the constructor, chosen as in Java's constructor_DeclareDefault. The fields
    // already exist (constructor_Declare_All creates them before the parent constructor runs), so these
    // leaves only link the arguments. Each emitted line starts with a newline and eight spaces.
    constructor_Association_All <<!<</*constructor_Association_All*/>><<#
{
  // With several one ends whose other ends are sorted, the fields are set directly first so each
  // sort sees the others (as Java does).
  List<AssociationVariable> sortedOnes = new ArrayList<AssociationVariable>();
  for (AssociationVariable av : uClass.getAssociationVariables())
  {
    if (av.isOnlyOne() && av.getRelatedAssociation().isMany() && av.getRelatedAssociation().isSorted() && av.getIsNavigable())
    {
      sortedOnes.add(av);
    }
  }
  if (sortedOnes.size() > 1)
  {
    for (AssociationVariable av : sortedOnes)
    {
      realSb.append("\n        " + gen.field(av) + " = " + gen.translate("parameterOne", av));
    }
  }
  for (AssociationVariable av : uClass.getAssociationVariables())
  {
    if (!av.getIsNavigable())
    {
      continue;
    }
    AssociationVariable relatedAssociation = av.getRelatedAssociation();
    String field = gen.field(av);
    String parameter = gen.translate("parameterOne", av);
    if (!relatedAssociation.getIsNavigable())
    {
      if (av.isOnlyOne())
      {
        #>><<@ UmpleToPython.constructor_AssociationAssignUndirectionalOne >><<#
      }
      else if (av.isOptionalOne() && av.isImmutable())
      {
        #>><<@ UmpleToPython.constructor_AssociationAssignImmutableOptionalOne >><<#
      }
      else if (av.isMandatoryMany())
      {
        #>><<@ UmpleToPython.constructor_AssociationAssignMandatoryMany >><<#
      }
      else if (av.isOptionalN() && av.isImmutable())
      {
        #>><<@ UmpleToPython.constructor_AssociationAssignImmutableOptionalN >><<#
      }
      else if (av.isMany() && av.isImmutable())
      {
        #>><<@ UmpleToPython.constructor_AssociationAssignImmutableOptionalMany >><<#
      }
      else if (av.isMany())
      {
        #>><<@ UmpleToPython.constructor_AssociationAssignOptionalMany >><<#
      }
    }
    else if (av.isOnlyOne() && relatedAssociation.isOnlyOne() && createsPartners)
    {
      #>><<@ UmpleToPython.constructor_AssociationCreateOneToOne >><<#
    }
    else if (av.isOnlyOne() && relatedAssociation.isOnlyOne())
    {
      #>><<@ UmpleToPython.constructor_AssociationAssignOneToOne >><<#
    }
    else if ((av.isMN() || av.isN()) && (relatedAssociation.isMandatory() || relatedAssociation.isOptionalN()))
    {
      #>><<@ UmpleToPython.constructor_AssociationAssignOptionalMany >><<#
    }
    else
    {
      #>><<@ UmpleToPython.constructor_AssociationAssignDefault >><<#
    }
  }
}
#>>!>>
}
