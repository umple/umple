class UmpleToPython {
    // Java's MessageQueue and MessagePool with their worker thread: calls run one at a time on the
    // worker, in the order they were put; a pooled queue runs the first call that ready accepts and
    // keeps the others. Stopping drops the calls still waiting, as Java's interrupt does. Unlike Java's,
    // the worker retires while it has nothing to run once the main thread has ended and every other
    // thread left is an idle worker, so a program can end without deleting its objects; work put in
    // the queue later starts a new worker.
    state_machine_MessageQueue <<!<</*state_machine_MessageQueue*/>>
    class <<=gen.messageQueueClass(uClass)>>:
        def __init__(self, ready):
            self._calls = []
            self._ready = ready
            self._started = False
            self._stopped = False
            self._worker = None
            self._condition = <<=threading>>.Condition()
        def start(self):
            with self._condition:
                self._started = True
                self._wake()
        def put(self, call, *args):
            with self._condition:
                self._calls.append((call, args))
                self._wake()
        def stop(self):
            with self._condition:
                self._stopped = True
                self._condition.notify()
        def _wake(self):
            if self._started and not self._stopped and self._worker is None:
                self._worker = <<=threading>>.Thread(target=self._run, daemon=False)
                self._worker.start()
            if self._worker is not None:
                self._worker.isIdle = False
            self._condition.notify()
        def _run(self):
            while True:
                with self._condition:
                    call = None
                    while not self._stopped and call is None:
                        call = self._next()
                        self._worker.isIdle = call is None
                        if call is None and self._programIdle():
                            self._worker = None
                            return
                        if call is None:
                            self._condition.wait(0.25)
                    if call is None:
                        return
                call[0](*call[1])
        def _next(self):
            for i, call in enumerate(self._calls):
                if self._ready is None or self._ready(call[0]):
                    return self._calls.pop(i)
            return None
        def _programIdle(self):
            ended = (<<=threading>>.main_thread(), <<=threading>>.current_thread())
            return not ended[0].is_alive() and all(t in ended or t.daemon or getattr(t, "isIdle", False)
                for t in <<=threading>>.enumerate())!>>
}
