    // registered in the class's registry, and a value already taken by another object is rejected.
    // Before-injections run first, as in Java: ahead of the key and once-set guards, and of the
    // invariant checks, so they can adjust the value.
    attribute_Set <<!<</*attribute_Set*/>><<#
  String oldValue = gen.translate("parameterOld", av);
  String registry = "__class__." + gen.uniqueMap(uClass, av);
  #>>

    def <<=gen.translate("setMethod", av)>>(self, <<=parameter>>):<<=gen.injected(uClass, "before", gen.translate("setMethod", av), setterParameter)>><<#
  if (isKey || av.isImmutable())
  {
    #>>
        if not <<=canSet>>:
            return False<<#
  }
  #>><<=gen.invariantGuards(uClass, av)>><<#
  if (av.getIsUnique())
  {
    #>>
        <<=oldValue>> = <<=field>>
        if <<=oldValue>> is not None and <<=oldValue>> == <<=parameter>>:
            return True
        if __class__.<<=gen.translate("hasUniqueMethod", av)>>(<<=parameter>>):
            return False<<#
  }
  if (av.isImmutable())
