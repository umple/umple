class UmpleToPython {
    // Methods whose body depends on the current state (Issue #1351). State-dependent methods
    // sharing a name are an overload group: numbered implementations and a dispatcher.
    state_machine_StateDependentMethods_All <<!<</*state_machine_StateDependentMethods_All*/>><<#
{
  Map<String, List<Method>> dependentGroups = new LinkedHashMap<String, List<Method>>();
  for (Method method : uClass.getStateDependentMethods())
  {
    if (!dependentGroups.containsKey(method.getName()))
    {
      dependentGroups.put(method.getName(), new ArrayList<Method>());
    }
    dependentGroups.get(method.getName()).add(method);
  }
  for (List<Method> group : dependentGroups.values())
  {
    String groupName = group.get(0).getName();
    List<String> names = group.size() == 1 ? Arrays.asList(groupName) : gen.overloadNames(uClass, groupName, group.size(), "stateDependent");
    List<List<MethodParameter>> groupParameters = new ArrayList<List<MethodParameter>>();
    for (int i = 0; i < group.size(); i++)
    {
      realSb.append(gen.stateDependentMethod(uClass, group.get(i), names.get(i)));
      groupParameters.add(group.get(i).getMethodParameters());
    }
    if (group.size() > 1)
    {
      realSb.append(gen.overloadDispatcher(uClass, groupName, false, names, groupParameters));
    }
  }
}
#>>!>>
}
