use UmpleNotice.ump;

namespace cruise.umple.compiler.python;

external interface ILang{}

class PythonInterfaceGenerator {
    depend cruise.umple.compiler.*;
    depend cruise.umple.util.*;
    depend java.util.*;

    isA ILang;

    // Marks where the imports go; they are known only after the interface body has been generated.
    const String IMPORTS = "#<<IMPORTS>>";

    emit getCode(UmpleModel model, UmpleElement uElement)(PythonInterfaceGenerator);

    // An interface is an abstract base class: its constants, and one abstract method per method name
    // (overloads share one name in Python, so they share one stub taking any arguments).
    PythonInterfaceGenerator <<!<</*PythonInterfaceGenerator*/>><<@ UmpleToPython.UmpleNotice >>
<<#
  UmpleInterface uInterface = (UmpleInterface) uElement;
  PythonGenerator gen = (PythonGenerator) GeneratorHelper.generator;
  List<String> bases = gen.interfaceBases(uInterface);
  if (bases.isEmpty())
  {
    bases.add(gen.standardName("abc", "ABC"));
  }
  Map<String, List<Method>> methods = new LinkedHashMap<String, List<Method>>();
  for (Method m : uInterface.getMethods())
  {
    if (!methods.containsKey(m.getName()))
    {
      methods.put(m.getName(), new ArrayList<Method>());
    }
    methods.get(m.getName()).add(m);
  }
  String abstractMethod = methods.isEmpty() ? null : gen.standardName("abc", "abstractmethod");
#>>
<<=IMPORTS>>

class <<=uInterface.getName()>>(<<=String.join(", ", bases)>>):<<=gen.docstring(uInterface.getComments(), "    ")>><<#
  if (!uInterface.getConstants().isEmpty())
  {
    realSb.append("\n");
  }
  for (Constant aConstant : uInterface.getConstants())
  {
    realSb.append("\n    " + aConstant.getName() + " = " + gen.interfaceValue(uInterface, aConstant));
  }
  for (List<Method> overloads : methods.values())
  {
    Method m = overloads.get(0);
    String parameters = overloads.size() > 1 ? ", *args, **kwargs" : gen.parameterList(m.getMethodParameters());
    #>>

    @<<=abstractMethod>>
    def <<=m.getName()>>(self<<=parameters>>):
        pass<<#
  }
  gen.finishClass(realSb, IMPORTS);
#>>!>>
}
