// Use cases of an online shop. Generating GvUseCaseDiagram
// draws each one as an ellipse, each who as an actor,
// include as a dashed arrow and isA as a generalization.

req UC1 useCase {
  who { customer }
  what { place an order }
  include UC3;
}

req UC2 useCase {
  who { returning customer }
  what { place an order using a saved address }
  isA UC1;
}

req UC3 useCase {
  what { pay for the order }
}

req UC4 useCase {
  who { store administrator }
  what { cancel an order }
  include UC5;
}

req UC5 useCase {
  what { refund the payment }
}
